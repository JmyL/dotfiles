root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,h,cc,cpp,cxx,cx,hpp,hh,hxx,inl,ipp}]
indent_style = tab
tab_width = 4
max_line_length = 190

[*.py]
indent_style = space
indent_size = 4

[*.{sh,bash}]
indent_style = space
indent_size = 2

[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 2

[Dockerfile*]
indent_style = space
indent_size = 4
