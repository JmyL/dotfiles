# Cursor CLI follows darkman via TERM_THEME. The CLI prompt bar is inverted
# vs the terminal, so the state file (and this fallback) store the opposite.
__cursor_term_theme_from_darkman() {
  local file theme
  file="${CURSOR_TERM_THEME_FILE:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/cursor-term-theme}"
  theme=
  if [[ -f $file ]]; then
    IFS= read -r theme <"$file" || true
  fi
  if [[ $theme != light && $theme != dark ]] && command -v darkman >/dev/null 2>&1; then
    case "$(darkman get 2>/dev/null)" in
    light) theme=dark ;;
    dark) theme=light ;;
    esac
  fi
  case $theme in
  light | dark)
    export TERM_THEME=$theme
    ;;
  esac
}
__cursor_term_theme_from_darkman

# Keep long-lived shells in sync after Super+Shift+t (next prompt, then new agent).
if [[ $- == *i* ]]; then
  case " ${PROMPT_COMMAND[*]} " in
  *" __cursor_term_theme_from_darkman "*) ;;
  *)
    if [[ "$(declare -p PROMPT_COMMAND 2>&1)" == "declare -a"* ]]; then
      PROMPT_COMMAND+=(__cursor_term_theme_from_darkman)
    else
      PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND;}__cursor_term_theme_from_darkman"
    fi
    ;;
  esac
fi
