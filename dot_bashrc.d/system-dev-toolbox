# Dev tools run in this toolbox on Fedora Silverblue host shells.
if [ -z "${SYSTEM_DEV_TOOLBOX+x}" ] && [ ! -r /run/.containerenv ] && [ -r /etc/os-release ]; then
  _system_dev_id=""
  . /etc/os-release
  _system_dev_id="${ID:-}"
  if [ "$_system_dev_id" = fedora ]; then
    SYSTEM_DEV_TOOLBOX=f44
    export SYSTEM_DEV_TOOLBOX
  fi
  unset _system_dev_id
fi
