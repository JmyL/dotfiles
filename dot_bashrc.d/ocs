# shellcheck shell=bash
# ocs: list opencode sessions started in this directory (or the one given).
# ocl: continue an opencode session by id (as printed by ocs), or pick one
#      via fzf when called without arguments.
# Usage: ocs [directory]        Limit with OCS_LIMIT (default 20).
#        ocl <session-id> [...]
#        ocl

_ocs_sessions() {
  local limit="${OCS_LIMIT:-20}" dirs dir list=
  [[ $limit =~ ^[0-9]+$ ]] || limit=20

  command -v opencode >/dev/null || {
    echo "opencode not found" >&2
    return 1
  }

  if (($#)); then
    dirs=("$1")
  else
    dirs=("$PWD")
    [[ $(pwd -P) == "$PWD" ]] || dirs+=("$(pwd -P)")
  fi

  for dir in "${dirs[@]}"; do
    list+="${list:+, }'${dir//\'/\'\'}'"
  done

  opencode db "SELECT id, datetime(time_updated / 1000, 'unixepoch', 'localtime') AS updated, title
               FROM session
               WHERE directory IN ($list)
                 AND parent_id IS NULL
               ORDER BY time_updated DESC
               LIMIT $limit" --format tsv
}

ocs() {
  _ocs_sessions "$@" | column -t -s $'\t'
}

ocl() {
  if (($#)); then
    opencode -s "$1" "${@:2}"
    return
  fi

  command -v fzf >/dev/null || {
    echo "ocl: fzf not found" >&2
    return 1
  }

  local id
  id=$(_ocs_sessions "$@" |
    awk -F'\t' -v OFS='\t' '{ $2 = substr($2, 1, 16) } 1' |
    fzf --delimiter=$'\t' --with-nth=2.. --prompt 'opencode session> ' --header 'Enter to continue, esc to cancel' |
    awk -F'\t' '{print $1}')
  [[ -n $id ]] || return
  opencode -s "$id"
}