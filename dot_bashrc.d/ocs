# shellcheck shell=bash
# ocs: list recent opencode sessions for the current project (or the directory
#      given). In git repositories opencode scopes this to the whole repo,
#      including worktrees; elsewhere to the exact directory.
# ocl: continue an opencode session by id (as printed by ocs), or pick one
#      via fzf when called without arguments.
# Usage: ocs [directory]        Limit with OCS_LIMIT (default 20).
#        ocl <session-id> [...]
#        ocl

_ocs_sessions() {
  local limit="${OCS_LIMIT:-20}"
  [[ $limit =~ ^[0-9]+$ ]] || limit=20

  command -v opencode >/dev/null || {
    echo "opencode not found" >&2
    return 1
  }

  if (($#)); then
    (cd "$1" && exec opencode session list -n "$limit")
  else
    opencode session list -n "$limit"
  fi
}

ocs() {
  _ocs_sessions "$@" | column -t -s $'\t'
}

ocl() {
  if (($#)); then
    opencode -s "$1" "${@:2}"
    return
  fi

  command -v fzf >/dev/null || {
    echo "ocl: fzf not found" >&2
    return 1
  }

  local id
  id=$(_ocs_sessions |
    fzf --delimiter=$'\t' --with-nth=2.. --prompt 'opencode session> ' --header 'Enter to continue, esc to cancel' |
    awk -F'\t' '{print $1}')
  [[ -n $id ]] || return
  opencode -s "$id"
}