# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.

### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Your preferred terminal emulator
set $term kitty
# Your preferred application launcher (floating kitty + fzf)
set $menu ~/.local/bin/fzf-drun
# Shared desktop and lock-screen wallpaper. The symlink is updated by
# sway-theme-wallpaper when darkman changes the light/dark preference.
set $wallpaper ~/.config/sway/wallpaper-current
set $lock swaylock -f -i $wallpaper -s fill

# Floating pickers / clipboard TUI (foot --app-id …)
for_window [app_id="fzf-menu"] floating enable, sticky enable, border none, resize set 720 420, move position center
for_window [app_id="clipse"] floating enable, sticky enable, border none, resize set 900 640, move position center

### Window appearance
#
# Make tiled windows easier to distinguish.
# class                 border  backgr. text    indicator child_border
client.focused          #2f7d32 #1e1e2e #cdd6f4 #2f7d32   #2f7d32
client.focused_inactive #40523f #1e1e2e #cdd6f4 #40523f   #40523f
client.unfocused        #263526 #1e1e2e #a6adc8 #263526   #263526
client.urgent           #f38ba8 #1e1e2e #cdd6f4 #f38ba8   #f38ba8
client.placeholder      #000000 #1e1e2e #cdd6f4 #000000   #000000

default_border pixel 3
default_floating_border pixel 3
gaps inner 7
gaps outer 0
smart_gaps on
smart_borders on

focus_on_window_activation focus

### Output configuration
#
# Default wallpaper (more resolutions are available in /usr/share/backgrounds/sway/)
output * bg $wallpaper fill
exec_always ~/.config/sway/sway-theme-wallpaper
#
# Example configuration:
#
#   output HDMI-A-1 resolution 1920x1080 position 1920,0
#
# You can get the names of your outputs by running: swaymsg -t get_outputs

### Idle configuration
#
# Lock after 5 minutes, turn displays off after 10 minutes, and suspend after
# 30 minutes. Sessions start with idle inhibit on (Awake); toggle via Waybar
# or Mod+Shift+a. Inhibit blocks idle timeouts, but still allows an explicit
# suspend via keybinding or systemctl.
# After suspend, leave a working external-only layout alone. If HDMI/DP is
# inactive, power on eDP (and the external) for the lock screen and start
# kanshi after unlock only if the external is actually active.
# Idle DPMS resume is unchanged. Super+Ctrl+m still forces eDP-only.
exec ~/.local/bin/idle-inhibit on
exec ~/.local/bin/cycle-power-profile balanced
exec swayidle -w \
         timeout 300 '~/.local/bin/idle-inhibited || $lock' \
         timeout 600 '~/.local/bin/idle-inhibited || swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
         timeout 1800 '~/.local/bin/idle-inhibited || systemctl suspend' \
         before-sleep '$lock' \
         after-resume '~/.local/bin/sway-after-resume-displays'

### Bar
#
# Signals waybar's window-icon module to redraw the instant focus changes,
# instead of it polling every second.
exec_always ~/.local/bin/waybar-window-focus-watcher

# bar { swaybar_command … } lives in config.d/05-waybar-bar.conf (chezmoi
# templates an absolute path; sway does not expand ~ or $HOME here).
# Do not also exec waybar — that stacks a second unmanaged instance on reload.

### Input configuration
#
# Example configuration:
#
#   input type:touchpad {
#       dwt enabled
#       tap enabled
#       natural_scroll enabled
#       middle_emulation enabled
#   }
#
#   input type:keyboard {
#       xkb_layout "eu"
#   }
#
# You can also configure each device individually.
# Read `man 5 sway-input` for more information about this section.
seat * hide_cursor 0
seat * hide_cursor when-typing enable

### Key bindings
#
# Basics:
#
    # Start a terminal
    bindsym $mod+i exec $term

    # Start Vivaldi (Slack stay-in-browser via External Extensions;
    # localhost CDP for darkman Dark/Zen)
    bindsym $mod+Shift+i exec $HOME/.local/bin/vivaldi-stable

    # Start file browser
    bindsym $mod+e exec thunar

    # Kill focused window
    bindsym $mod+q kill

    # Start your launcher
    bindsym $mod+slash exec $menu

    # Show upcoming calendar agenda
    bindsym $mod+a exec sh -c '~/.local/bin/calendar-date-waybar --plain | ~/.local/bin/fzf-menu --prompt "Agenda> " --width 80 >/dev/null'

    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    # Despite the name, also works for non-floating windows.
    # Change normal to inverse to use left mouse button for resizing and right
    # mouse button for dragging.
    floating_modifier $mod normal

    # Reload the configuration file
    bindsym $mod+shift+r reload

    # Reboot the system
    bindsym $mod+Shift+b exec sh -c 'choice=$(printf "Reboot\nCancel\n" | ~/.local/bin/fzf-menu --prompt "Reboot the system? "); [ "$choice" = "Reboot" ] && systemctl reboot'

    # Suspend the system
    bindsym $mod+Shift+s exec sh -c 'choice=$(printf "Suspend\nCancel\n" | ~/.local/bin/fzf-menu --prompt "Suspend the system? "); [ "$choice" = "Suspend" ] && systemctl suspend'

    # Power down the system
    bindsym $mod+Shift+p exec sh -c 'choice=$(printf "Power off\nCancel\n" | ~/.local/bin/fzf-menu --prompt "Power off the system? "); [ "$choice" = "Power off" ] && systemctl poweroff'

    # Exit sway (logs you out of your Wayland session)
    bindsym $mod+Shift+e exec sh -c 'choice=$(printf "Exit sway\nCancel\n" | ~/.local/bin/fzf-menu --prompt "Exit sway? This will end your Wayland session. "); [ "$choice" = "Exit sway" ] && swaymsg exit'
#
# Moving around:
#
    # Move your focus around
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    # Or use $mod+[up|down|left|right]
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    # Ditto, with arrow keys
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right

    focus_wrapping no
    mouse_warping container
#
# Workspaces:
#
    # Switch to workspace
    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+6 workspace number 6
    bindsym $mod+7 workspace number 7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace number 9
    bindsym $mod+0 workspace number 10
    # Switch to previously focused workspace
    bindsym $mod+p workspace back_and_forth
    # Move focused container to workspace
    bindsym $mod+Shift+1 move container to workspace number 1, workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2, workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3, workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4, workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5, workspace number 5
    bindsym $mod+Shift+6 move container to workspace number 6, workspace number 6
    bindsym $mod+Shift+7 move container to workspace number 7, workspace number 7
    bindsym $mod+Shift+8 move container to workspace number 8, workspace number 8
    bindsym $mod+Shift+9 move container to workspace number 9, workspace number 9
    bindsym $mod+Shift+0 move container to workspace number 10, workspace number 10
    # Note: workspaces can have any name you want, not just numbers.
    # We just use 1-10 as the default.
#
# Layout stuff:
#
    # You can "split" the current object of your focus with
    # $mod+b or $mod+v, for horizontal and vertical splits
    # respectively.
    bindsym $mod+x splith
    bindsym $mod+d splitv

    # Switch the current container between different layout styles
    # bindsym $mod+s layout stacking
    # bindsym $mod+w layout tabbed
    # bindsym $mod+t layout toggle split

    # Make the current focus fullscreen
    bindsym $mod+f fullscreen

    # Toggle the current focus between tiling and floating mode
    bindsym $mod+Shift+space floating toggle

    # Swap focus between the tiling area and the floating area
    bindsym $mod+space focus mode_toggle

    # Move focus to the parent container
    bindsym $mod+u focus parent
#
# Scratchpad:
#
    # Sway has a "scratchpad", which is a bag of holding for windows.
    # You can send windows there and get them back later.

    # Move the currently focused window to the scratchpad
    bindsym $mod+Shift+minus move scratchpad

    # Show the next scratchpad window or hide the focused scratchpad window.
    # If there are multiple scratchpad windows, this command cycles through them.
    bindsym $mod+minus scratchpad show
#
# Resizing containers:
#
set $resize_mode Resize: [h/j/k/l], [q]uit
mode "$resize_mode" {
    # left will shrink the containers width
    # right will grow the containers width
    # up will shrink the containers height
    # down will grow the containers height
    bindsym $left resize shrink width 30px
    bindsym $down resize grow height 30px
    bindsym $up resize shrink height 30px
    bindsym $right resize grow width 30px

    # Ditto, with arrow keys
    bindsym Left resize shrink width 30px
    bindsym Down resize grow height 30px
    bindsym Up resize shrink height 30px
    bindsym Right resize grow width 30px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym q mode "default"
}
bindsym $mod+r mode "$resize_mode"

# Screenshot mode: area/window/full save to ~/Pictures/Screenshots and the clipboard.
# full is the focused output only (the monitor under the pointer), never both.
set $screenshot_mode Screenshot: [a]rea [w]indow [f]ull [e]dit [s]ave [q]uit
mode "$screenshot_mode" {
    bindsym a mode "default", exec ~/.local/bin/sway-screenshot area
    bindsym w mode "default", exec ~/.local/bin/sway-screenshot window
    bindsym f mode "default", exec ~/.local/bin/sway-screenshot full
    bindsym e mode "default", exec wl-paste --type image/png | swappy -f -
    bindsym s mode "default", exec ~/.local/bin/save-screenshot
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym q mode "default"
}
bindsym $mod+c mode "$screenshot_mode"

# Screen recording modes: recordings go to ~/Videos/Recordings.
# Super+Shift+c asks sway-recording which of these two named modes to enter.
# The names must match the script; quote them inside swaymsg or Sway rejects them.
set $recording_start_mode Recording: [a]rea [f]ull [q]uit
mode "$recording_start_mode" {
    bindsym a mode "default", exec ~/.local/bin/sway-recording area
    bindsym f mode "default", exec ~/.local/bin/sway-recording full
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym q mode "default"
}
set $recording_stop_mode Recording: [s]top [q]uit
mode "$recording_stop_mode" {
    bindsym s mode "default", exec ~/.local/bin/sway-recording stop
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym q mode "default"
}
bindsym $mod+Shift+c exec ~/.local/bin/sway-recording toggle

# Transcription mode: records through dev-launcher, transcribes, and pastes into focus.
set $transcription_mode Transcription: speak, [q] finish
mode "$transcription_mode" {
    bindsym q mode "default", exec sh -c '"$HOME/.local/bin/dev-launcher" "$HOME/.local/bin/sway-dictate-worker" stop'
    bindsym Escape mode "default", exec sh -c '"$HOME/.local/bin/dev-launcher" "$HOME/.local/bin/sway-dictate-worker" cancel'
}
bindsym $mod+t mode "$transcription_mode", exec sh -c '"$HOME/.local/bin/dev-launcher" "$HOME/.local/bin/sway-dictate-worker" start'
#
# Utilities:
#
    # Special keys to adjust volume and brightness with swayosd
    bindsym --locked XF86AudioMute exec ~/.local/bin/sway-osd-control output-volume mute-toggle
    bindsym --locked XF86AudioLowerVolume exec ~/.local/bin/sway-osd-control output-volume lower
    bindsym --locked XF86AudioRaiseVolume exec ~/.local/bin/sway-osd-control output-volume raise
    bindsym --locked XF86AudioMicMute exec ~/.local/bin/sway-osd-control input-volume mute-toggle
    bindsym --locked XF86MonBrightnessDown exec ~/.local/bin/sway-osd-control brightness lower
    bindsym --locked XF86MonBrightnessUp exec ~/.local/bin/sway-osd-control brightness raise
    # Switch default audio output/input device (speaker, bluetooth earbuds, etc.)
    bindsym $mod+Shift+o exec ~/.local/bin/sway-audio-switch
    # Special key to take a screenshot with grim
    bindsym Print exec grim
    # Toggle external-only and extended display modes
    bindsym $mod+m exec ~/.local/bin/sway-toggle-external-extend
    # Black-screen recovery: stop kanshi, disable externals, force eDP on
    # (--locked so it still works under swaylock after resume)
    bindsym --locked $mod+Ctrl+m exec ~/.local/bin/sway-recover-display
    # Toggle notification center
    bindsym $mod+n exec sh -c 'c="$HOME/.local/bin/swaync-client"; [ -x "$c" ] || c=swaync-client; exec "$c" -t -sw'
    # Clear all notifications
    bindsym $mod+Shift+n exec sh -c 'c="$HOME/.local/bin/swaync-client"; [ -x "$c" ] || c=swaync-client; exec "$c" -C'
    # Close the latest notification
    bindsym $mod+BackSpace exec sh -c 'c="$HOME/.local/bin/swaync-client"; [ -x "$c" ] || c=swaync-client; exec "$c" --close-latest -sw'
    # Activate (click) the latest notification's default action
    bindsym $mod+Return exec sh -c 'c="$HOME/.local/bin/swaync-client"; [ -x "$c" ] || c=swaync-client; exec "$c" -ad -sw'
    # Activate the latest notification's first action (e.g. COPY 2FA code)
    bindsym $mod+y exec sh -c 'c="$HOME/.local/bin/swaync-client"; [ -x "$c" ] || c=swaync-client; exec "$c" -a 0 -sw'
    # Clipboard history (clipse TUI in floating foot; auto-pastes on choose)
    bindsym $mod+v exec sh -c 'c="$HOME/.local/bin/foot"; [ -x "$c" ] || c=foot; exec "$c" --app-id=clipse --window-size-chars=100x32 "$HOME/.local/bin/clipse"'
    # Toggle idle/sleep inhibitor
    bindsym $mod+Shift+a exec ~/.local/bin/idle-inhibit toggle
    # Toggle light/dark (kitty, swaync, Herdr, Neovim, Vivaldi via darkman)
    bindsym $mod+Shift+t exec sh -c 'c="$HOME/.local/bin/darkman"; [ -x "$c" ] || c=darkman; exec "$c" toggle'
    # Cycle available power profiles
    bindsym $mod+Shift+m exec ~/.local/bin/cycle-power-profile
    # Lock screen
    bindsym $mod+Shift+x exec $lock

include /etc/sway/config.d/*

include ~/.config/sway/config.d/*.conf
include ~/.config/sway/local.d/*.conf
