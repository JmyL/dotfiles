#!/usr/bin/env bash
set -euo pipefail

wallpaper_root="${SWAY_WALLPAPER_ROOT:-${HOME}/.config/sway/wallpapers}"
cache_root="${SWAY_WALLPAPER_CACHE_ROOT:-${HOME}/.cache/sway}"
current_link="${SWAY_CURRENT_WALLPAPER:-${HOME}/.config/sway/wallpaper-current}"
swaymsg_bin="${SWAYMSG:-swaymsg}"
darkman_bin="${DARKMAN:-darkman}"
lock_file="${XDG_RUNTIME_DIR:-/tmp}/sway-theme-wallpaper.lock"
pid_file="${XDG_RUNTIME_DIR:-/tmp}/sway-theme-wallpaper.pid"
sleep_secs="${SWAY_WALLPAPER_SLEEP:-60}"

mode_from_darkman() {
  local mode
  mode="$(${darkman_bin} get 2>/dev/null || true)"
  case "$mode" in
  light | dark) printf '%s\n' "$mode" ;;
  *) return 1 ;;
  esac
}

select_wallpaper() {
  local mode="$1"
  local mode_dir="${wallpaper_root}/${mode}"
  local cache_file="${cache_root}/${mode}"
  local selected=""
  local now cache_mtime

  mkdir -p "$cache_root"
  now=$(date +%s)

  if [ -f "$cache_file" ]; then
    selected=$(cat "$cache_file")
    cache_mtime=$(stat -c %Y "$cache_file")
    if [ -f "$selected" ] && [ $((now - cache_mtime)) -lt 86400 ]; then
      printf '%s\n' "$selected"
      return
    fi
  fi

  selected=$(find "$mode_dir" -maxdepth 1 -type f \( \
    -iname "${mode}-*.jpg" -o -iname "${mode}-*.jpeg" -o \
    -iname "${mode}-*.png" -o -iname "${mode}-*.webp" \
  \) -print | shuf -n 1)
  [ -n "$selected" ] || return 1

  printf '%s\n' "$selected" >"$cache_file"
  printf '%s\n' "$selected"
}

apply_wallpaper() {
  local mode="$1"
  local selected

  selected=$(select_wallpaper "$mode") || {
    echo "${0##*/}: no ${mode} wallpaper in ${wallpaper_root}/${mode}" >&2
    return 1
  }
  ln -sfn "$selected" "$current_link"
  "$swaymsg_bin" output "*" bg "$selected" fill >/dev/null
}

replace_old_watcher() {
  local old i
  old=$(cat "$pid_file" 2>/dev/null || true)
  if [[ $old =~ ^[0-9]+$ ]] && [ "$old" -ne "$$" ]; then
    kill "$old" 2>/dev/null || true
    i=0
    while ((i<20)) && kill -0 "$old" 2>/dev/null; do
      sleep 0.1
      ((++i))
    done
  fi
  printf '%s\n' "$$" >"$pid_file"
}

if [ "${1:-}" = "--once" ]; then
  mode="${2:-$(mode_from_darkman || true)}"
  case $mode in
  light | dark) apply_wallpaper "$mode" || true ;;
  esac
  exit 0
fi

replace_old_watcher
exec 9>"$lock_file"
flock -n 9 || exit 0

last_mode=""
while :; do
  mode=$(mode_from_darkman || true)
  if [ "$mode" != "$last_mode" ] && [ -n "$mode" ]; then
    if apply_wallpaper "$mode"; then
      last_mode="$mode"
    fi
  fi
  # Keep the lock fd out of sleep so killing this script releases the lock.
  sleep "$sleep_secs" 9>&-
done
