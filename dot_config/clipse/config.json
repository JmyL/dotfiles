{
    "allowDuplicates": false,
    "historyFile": "clipboard_history.json",
    "maxHistory": 500,
    "deleteAfter": 0,
    "logFile": "clipse.log",
    "pollInterval": 50,
    "maxEntryLength": 65,
    "themeFile": "custom_theme.json",
    "tempDir": "tmp_files",
    "keyBindings": {
        "choose": "enter",
        "clearSelected": "S",
        "down": "down,j",
        "end": "end,G",
        "filter": "/",
        "forceQuit": "Q,ctrl+c",
        "home": "home,g",
        "more": "?",
        "nextPage": "right,l,ctrl+d",
        "prevPage": "left,h,ctrl+u",
        "preview": "space",
        "quit": "q,esc",
        "remove": "del,backspace,d",
        "selectDown": "shift+j,shift+down",
        "selectSingle": "s",
        "selectUp": "shift+k,shift+up",
        "togglePin": "p",
        "togglePinned": "tab",
        "up": "up,k",
        "yankFilter": "ctrl+s"
    },
    "imageDisplay": {
        "type": "sixel",
        "scaleX": 9,
        "scaleY": 9,
        "heightCut": 2
    },
    "excludedApps": [
        "1Password",
        "Bitwarden",
        "KeePassXC",
        "LastPass",
        "Dashlane",
        "Password Safe",
        "Keychain Access"
    ],
    "autoPaste": {
        "enabled": true,
        "keybind": "ctrl+shift+v",
        "buffer": 50
    },
    "enableMouse": false,
    "enableDescription": false
}
