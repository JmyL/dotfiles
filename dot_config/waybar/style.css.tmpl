* {
    font-family: 'JetBrainsMonoNL Nerd Font', 'Font Awesome 6 Free', 'Font Awesome 6 Brands', sans-serif;
    font-size: 14px;
}

window#waybar {
    background-color: rgba(43, 48, 59, 0.5);
    color: #ffffff;
    transition-property: background-color;
    transition-duration: .5s;
}

@import url("file://{{ .chezmoi.homeDir }}/.cache/calendar-alert/waybar-state.css");

window#waybar.hidden {
    opacity: 0.2;
}

/*
window#waybar.empty {
    background-color: transparent;
}
window#waybar.solo {
    background-color: #FFFFFF;
}
*/

window#waybar.termite {
    background-color: #3F3F3F;
}

window#waybar.chromium {
    background-color: #000000;
    border: none;
}

button {
    /* Use box-shadow instead of border so the text isn't offset */
    box-shadow: inset 0 -3px transparent;
    /* Avoid rounded borders under each button name */
    border: none;
    border-radius: 0;
}

/* https://github.com/Alexays/Waybar/wiki/FAQ#the-workspace-buttons-have-a-strange-hover-effect */
button:hover {
    background: inherit;
    box-shadow: inset 0 -3px #ffffff;
}

#workspaces button {
    padding: 0 5px;
    background-color: transparent;
    color: #ffffff;
}

#workspaces button:hover {
    background: rgba(0, 0, 0, 0.2);
}

#workspaces button.focused, #workspaces button.active {
    background-color: #64727D;
}

#workspaces button.urgent {
    background-color: #eb4d4b;
}

#mode {
    background-color: #64727D;
    box-shadow: inset 0 -3px #ffffff;
}

#clock,
#battery,
#cpu,
#memory,
#disk,
#temperature,
#backlight,
#network,
#bluetooth,
#pulseaudio,
#wireplumber,
#custom-media,
#custom-calendar-alert,
#custom-forager-battery,
#custom-swaync,
#tray,
#mode,
#idle_inhibitor,
#custom-idle_inhibitor,
#custom-recording,
#bluetooth,
#scratchpad,
#power-profiles-daemon,
#mpd {
    padding: 0 6px;
    color: #ffffff;
}

#custom-recording {
    color: #ff7b86;
    font-weight: bold;
}

#clock {
    color: #ffffff;
    background-color: rgba(24, 27, 34, 0.75);
    border-radius: 8px;
}

#custom-calendar-alert {
    color: #ffd166;
    font-weight: bold;
    background-color: rgb(24, 27, 34);
    border-radius: 8px;
}

#clock.date {
    margin-right: 8px;
}

#custom-calendar-alert.urgent {
    color: #ffffff;
    font-weight: bold;
}

#interactive,
#sound,
#connectivity,
#work,
#system-status {
    /* Item padding (4px each side) already sets in-group gaps; don't add extra
       group padding. Negative margin cancels bar "spacing" between group pills. */
    margin: 0;
    margin-right: -4px;
    padding: 0;
    background-color: rgba(24, 27, 34, 0.5);
    border-radius: 8px;
}

/* Keep the last icon clear of the next group pulled in by margin-right: -4px */
#interactive {
    padding-right: 4px;
}

#interactive #tray,
#interactive #custom-recording {
    background-color: transparent;
    padding: 0 4px;
}

/* NF icons clip on the right in icon-only modules */
#interactive #power-profiles-daemon {
    background-color: transparent;
    padding: 0 8px 0 4px;
}

#interactive #custom-idle_inhibitor {
    background-color: transparent;
    /* coffee glyphs sit optically high — nudge down to match neighbors */
    padding: 2px 10px 0 4px;
}

#sound #pulseaudio,
#connectivity #bluetooth,
#connectivity #custom-forager-battery,
#work #custom-ree-vpn,
#work #custom-ree-testbed,
#system-status #cpu,
#system-status #memory,
#system-status #battery {
    background-color: transparent;
    padding: 0 4px;
}

/* NF bell clips on the trailing edge when it is the bar's last icon */
#system-status #custom-swaync {
    background-color: transparent;
    padding: 0 8px 0 4px;
}

#custom-swaync.notification,
#custom-swaync.dnd-notification,
#custom-swaync.inhibited-notification,
#custom-swaync.dnd-inhibited-notification {
    color: #ffd166;
}

#connectivity #network {
    background-color: transparent;
    padding: 0 10px 0 4px;
}

#custom-forager-battery {
    margin-left: 4px;
}

#custom-forager-battery.low {
    color: #ff7b86;
}

#pulseaudio,
#network,
#bluetooth,
#cpu,
#memory,
#temperature,
#battery {
    background-color: transparent;
    color: #ffffff;
}

#window,
#workspaces {
    margin: 0 4px;
}

#image.window-icon {
    margin-top: 3px;
}

/* If workspaces is the leftmost module, omit left margin */
.modules-left > widget:first-child > #workspaces {
    margin-left: 0;
}

/* If the rightmost module has an outer margin, omit it at the screen edge.
   ID groups set margin-right: -4px above; beat that specificity here. */
.modules-right > widget:last-child > #system-status,
.modules-right > widget:last-child > #connectivity,
.modules-right > widget:last-child > #sound,
.modules-right > widget:last-child > #interactive,
.modules-right > widget:last-child > * {
    margin-right: 0;
}

#battery.charging, #battery.plugged {
    color: #ffffff;
    background-color: transparent;
}

#battery.critical:not(.charging) {
    color: #ffffff;
    background-color: transparent;
}

#power-profiles-daemon.performance {
    background-color: transparent;
    color: #ff7b86;
}

#power-profiles-daemon.balanced {
    background-color: transparent;
    color: #72b7f2;
}

#power-profiles-daemon.power-saver {
    background-color: transparent;
    color: #69db8b;
}

label:focus {
    background-color: #000000;
}

#disk {
    background-color: #964B00;
}

#backlight {
    background-color: #90b1b1;
}

#network.disconnected {
    background-color: transparent;
}

#pulseaudio.muted {
    background-color: transparent;
    color: #ffffff;
}

#wireplumber {
    background-color: #fff0f5;
    color: #000000;
}

#wireplumber.muted {
    background-color: #f53c3c;
}

#custom-media {
    background-color: #66cc99;
    color: #2a5c45;
    min-width: 100px;
}

#custom-media.custom-spotify {
    background-color: #66cc99;
}

#custom-media.custom-vlc {
    background-color: #ffa000;
}

#temperature.critical {
    background-color: transparent;
}

#tray > .passive {
    -gtk-icon-effect: dim;
}

#tray > .needs-attention {
    -gtk-icon-effect: highlight;
    background-color: #eb4d4b;
}

#idle_inhibitor,
#custom-idle_inhibitor {
    background-color: transparent;
}

#idle_inhibitor.deactivated,
#custom-idle_inhibitor.deactivated {
    color: #aeb4ba;
}

#idle_inhibitor.activated,
#custom-idle_inhibitor.activated {
    background-color: transparent;
    color: #69db8b;
}

#custom-ree-vpn.ok {
    color: #69db8b;
}

#custom-ree-testbed.ready,
#custom-ree-testbed.session {
    color: #72b7f2;
}

#custom-ree-vpn.warn,
#custom-ree-testbed.reserving,
#custom-ree-testbed.deploying {
    color: #ffd166;
}

#custom-ree-vpn.expired,
#custom-ree-testbed.failed,
#custom-ree-testbed.urgent {
    color: #ff7b86;
}

#custom-ree-testbed.reserved,
#custom-ree-testbed.idle {
    color: #aeb4ba;
}

#mpd {
    background-color: #66cc99;
    color: #2a5c45;
}

#mpd.disconnected {
    background-color: #f53c3c;
}

#mpd.stopped {
    background-color: #90b1b1;
}

#mpd.paused {
    background-color: #51a37a;
}

#language {
    background: #00b093;
    color: #740864;
    padding: 0 5px;
    margin: 0 5px;
    min-width: 16px;
}

#keyboard-state {
    background: #97e1ad;
    color: #000000;
    padding: 0 0px;
    margin: 0 5px;
    min-width: 16px;
}

#keyboard-state > label {
    padding: 0 5px;
}

#keyboard-state > label.locked {
    background: rgba(0, 0, 0, 0.2);
}

#scratchpad {
    background: rgba(0, 0, 0, 0.2);
}

#scratchpad.empty {
	background-color: transparent;
}

#privacy {
    padding: 0;
}

#privacy-item {
    padding: 0 5px;
    color: white;
}

#privacy-item.screenshare {
    background-color: #cf5700;
}

#privacy-item.audio-in {
    background-color: #1ca000;
}

#privacy-item.audio-out {
    background-color: #0069d4;
}

/* Flat, solid-black bar: modules never draw their own containers or states. */
window#waybar,
window#waybar.hidden,
window#waybar.termite,
window#waybar.chromium {
    background-color: #000000;
    border: none;
    border-radius: 0;
}

window#waybar * {
    background-color: transparent;
    background-image: none;
    border-radius: 0;
    box-shadow: none;
}

menu,
menuitem,
.menu,
.context-menu,
popover.menu {
    background-color: #000000;
    background-image: none;
    color: #ffffff;
}

menuitem:hover,
menuitem:focus {
    background-color: #2b303b;
    color: #ffffff;
}
