// -*- mode: jsonc -*-
{
	// "layer": "top", // Waybar at top layer
	// "position": "bottom", // Waybar position (top|bottom|left|right)
	"height": 30, // Waybar height (to be removed for auto height)
	// "width": 1280, // Waybar width
	"spacing": 4, // Gaps between modules (4px)
	// Choose the order of the modules
	"modules-left": [
		"sway/workspaces",
		"image#window-icon",
		"sway/window",
		"sway/mode",
		"sway/scratchpad"
	],
	"modules-center": [
		"clock#date",
		"clock#time"
	],
	"modules-right": [
		"custom/calendar-alert",
		"group/interactive",
		"group/sound",
		"group/connectivity",
		"group/work",
		"group/system-status"
	],
	"group/interactive": {
		"orientation": "horizontal",
		"modules": [
			"tray",
			"custom/recording",
			"power-profiles-daemon",
			"custom/idle_inhibitor"
		]
	},
	"group/sound": {
		"orientation": "horizontal",
		"modules": [
			"pulseaudio"
		]
	},
	"group/connectivity": {
		"orientation": "horizontal",
		"modules": [
			"network",
			"custom/forager-battery"
		]
	},
	"group/work": {
		"orientation": "horizontal",
		"modules": [
			"custom/ree-vpn",
			"custom/ree-testbed"
		]
	},
	"group/system-status": {
		"orientation": "horizontal",
		"modules": [
			"cpu",
			"memory",
			// "temperature",
			// "backlight",
			// "sway/language",
			"battery",
			"custom/swaync"
		]
	},
	// Modules configuration
	// Show every workspace on each bar so Mod+6..9 (laptop) still updates the
	// focused highlight on the external monitor's bar immediately.
	"sway/workspaces": {
		"all-outputs": true
	},
	"keyboard-state": {
		"numlock": true,
		"capslock": true,
		"format": "{name} {icon}",
		"format-icons": {
			"locked": "",
			"unlocked": ""
		}
	},
	"sway/mode": {
		"format": "{}"
	},
	// Tiny exec only: Waybar 0.15 runs image `exec` on the GTK main thread.
	// Heavy icon lookup/rasterize happens in waybar-window-focus-watcher; this
	// just prints the cached PNG path so workspace highlights stay snappy.
	"image#window-icon": {
		"exec": "printf '%s\\n' \"$HOME/.cache/waybar/focused-window-icon.png\"",
		"size": 18,
		"interval": "once",
		"signal": 9
	},
	"sway/window": {
		"format": "{title}",
		"max-length": 40
	},
	"sway/scratchpad": {
		"format": "{icon} {count}",
		"show-empty": false,
		"format-icons": [
			"",
			""
		],
		"tooltip": true,
		"tooltip-format": "{app}: {title}"
	},
	"mpd": {
		"format": "{stateIcon} {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}{artist} - {album} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) ⸨{songPosition}|{queueLength}⸩ {volume}% ",
		"format-disconnected": "Disconnected ",
		"format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon}Stopped ",
		"unknown-tag": "N/A",
		"interval": 5,
		"consume-icons": {
			"on": " "
		},
		"random-icons": {
			"off": "<span color=\"#f53c3c\"></span> ",
			"on": " "
		},
		"repeat-icons": {
			"on": " "
		},
		"single-icons": {
			"on": "1 "
		},
		"state-icons": {
			"paused": "",
			"playing": ""
		},
		"tooltip-format": "MPD (connected)",
		"tooltip-format-disconnected": "MPD (disconnected)"
	},
	"custom/ree-vpn": {
		"exec": "$HOME/.local/bin/work/ree-vpn-status",
		"return-type": "json",
		"interval": 60,
		"signal": 10,
		"on-click": "$HOME/.local/bin/work/ree-goodmorning-launch"
	},
	"custom/ree-testbed": {
		"exec": "$HOME/.local/bin/work/ree-testbed-status",
		"return-type": "json",
		"markup": true,
		"interval": 15,
		"signal": 10,
		"on-click": "$HOME/.local/bin/work/ree-reserve select --next",
		"on-click-right": "$HOME/.local/bin/work/ree-open-pipeline"
	},
	"custom/idle_inhibitor": {
		"exec": "~/.local/bin/idle-inhibit-status",
		"return-type": "json",
		"interval": "once",
		"signal": 8,
		"on-click": "~/.local/bin/idle-inhibit toggle"
	},
	"custom/recording": {
		"exec": "~/.local/bin/sway-recording status",
		"interval": 1,
		"tooltip": false,
		"on-click": "~/.local/bin/sway-recording stop"
	},
	"custom/calendar-alert": {
		"exec": "$HOME/.local/bin/calendar-alert --waybar",
		"return-type": "json",
		"interval": 30,
		"tooltip": true,
		"on-click": "kitty --class calendar-popup -e sh -lc 'exec \"$HOME/.local/bin/dev-launcher\" /usr/bin/ikhal'"
	},
	"tray": {
		// "icon-size": 21,
		"spacing": 6,
		// "icons": {
		//   "blueman": "bluetooth",
		//   "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
		// }
	},
	"clock#date": {
		// "timezone": "America/New_York",
		"format": "{:%Y-%m-%d %a}",
		"tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
		"format-alt": "{:%A, %B %d}"
	},
	"clock#time": {
		// "timezone": "America/New_York",
		"format": "{:%I:%M %p}",
		"tooltip": false,
		"format-alt": "{:%H:%M}"
	},
	"cpu": {
		"markup": true,
		"format": "<span foreground=\"#72b7f2\"></span> {usage}%",
		"tooltip": false
	},
	"memory": {
		"markup": true,
		"format": "<span foreground=\"#72b7f2\"></span> {}%"
	},
	"temperature": {
		// "thermal-zone": 2,
		// "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
		"critical-threshold": 80,
		// "format-critical": "{temperatureC}°C {icon}",
		"format": "{icon} {temperatureC}°C",
		"format-icons": [
			"",
			"",
			""
		]
	},
	"backlight": {
		// "device": "acpi_video1",
		"format": "{icon} {percent}%",
		"format-icons": [
			"🌑",
			"🌘",
			"🌗",
			"🌖",
			"🌕"
		]
	},
	"battery": {
		"bat": "BAT0",
		"adapter": "AC",
		"markup": true,
		"states": {
			// "good": 95,
			"warning": 30,
			"critical": 15
		},
		"format": "<span foreground=\"#69db8b\">{icon}</span> {capacity}%",
		"format-full": "<span foreground=\"#69db8b\">{icon}</span> {capacity}%",
		"format-charging": "<span foreground=\"#69db8b\"></span> {capacity}%",
		"format-plugged": "<span foreground=\"#69db8b\"></span> {capacity}%",
		"format-alt": "<span foreground=\"#69db8b\">{icon}</span> {time}",
		// "format-good": "", // An empty format will hide the module
		// "format-full": "",
		"format-icons": [
			"",
			"",
			"",
			"",
			""
		]
	},
	"battery#bat2": {
		"bat": "BAT2"
	},
	"power-profiles-daemon": {
		"format": "{icon}",
		"tooltip-format": "Power profile: {profile}\nDriver: {driver}",
		"tooltip": true,
		"format-icons": {
			"default": "",
			"performance": "",
			"balanced": "",
			"power-saver": ""
		}
	},
	"network": {
		"markup": true,
		// "interface": "wlp2*", // (Optional) To force the use of this interface
		"format-wifi": "<span foreground=\"#72b7f2\"></span>",
		"format-ethernet": "<span foreground=\"#72b7f2\"></span> {ipaddr}/{cidr}",
		"tooltip-format": "{essid} {signalStrength}%\n{ifname} via {gwaddr} ",
		"format-linked": "<span foreground=\"#72b7f2\"></span> {ifname} (No IP)",
		"format-disconnected": "<span foreground=\"#ff7b86\">⚠</span> Disconnected",
		"format-alt": "<span foreground=\"#72b7f2\"></span> {ifname}: {ipaddr}/{cidr}",
		"on-click": "gnome-control-center wifi",
		"on-click-right": "nm-connection-editor",
		"on-click-middle": "ptyxis -- nmtui"
	},
	"bluetooth": {
		"markup": true,
		"format": "<span foreground=\"#aeb4ba\"></span> {status}",
		"format-connected": "<span foreground=\"#72b7f2\"></span>\u2006{num_connections}",
		"format-connected-battery": "<span foreground=\"#72b7f2\"></span>\u2006{num_connections}",
		"format-disabled": "<span foreground=\"#aeb4ba\"></span> off",
		"format-off": "<span foreground=\"#aeb4ba\"></span> off",
		"format-no-controller": "",
		"tooltip-format": "{controller_alias}\t{controller_address}",
		"tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
		"tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
		"tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
		"on-click-right": "blueman-manager"
	},
	"custom/forager-battery": {
		"exec": "$HOME/.local/bin/forager-battery",
		"return-type": "json",
		"interval": 60,
		"tooltip": true,
		"escape": false
	},
	"custom/swaync": {
		"tooltip": true,
		"format": "{icon}",
		"format-icons": {
			// Outline when clear; filled when unread (same advance width in JetBrainsMonoNL NF)
			"none": "󰂜",
			"notification": "󰂚",
			"dnd-none": "󰪓",
			"dnd-notification": "󰂠",
			"inhibited-none": "󰪑",
			"inhibited-notification": "󰂛",
			"dnd-inhibited-none": "󰪑",
			"dnd-inhibited-notification": "󰂛"
		},
		"return-type": "json",
		"exec-if": "which swaync-client",
		"exec": "$HOME/.local/bin/swaync-client -swb",
		"on-click": "sleep 0.1 && sh -c 'c=\"$HOME/.local/bin/swaync-client\"; [ -x \"$c\" ] || c=swaync-client; exec \"$c\" -t -sw'",
		"on-click-right": "sleep 0.1 && sh -c 'c=\"$HOME/.local/bin/swaync-client\"; [ -x \"$c\" ] || c=swaync-client; exec \"$c\" -d -sw'",
		"escape": true
	},
	"pulseaudio": {
		"markup": true,
		// "scroll-step": 1, // %, can be a float
		"format": "<span foreground=\"#72b7f2\">{icon}</span> {volume}%",
		"format-bluetooth": "<span foreground=\"#72b7f2\">{icon}</span> {volume}%",
		"format-bluetooth-muted": "<span foreground=\"#aeb4ba\"></span> <span foreground=\"#72b7f2\">{icon}</span>",
		"format-muted": "<span foreground=\"#aeb4ba\"></span>",
		"format-icons": {
			"headphone": "",
			"hands-free": "",
			"headset": "",
			"phone": "",
			"portable": "",
			"car": "",
			"default": [
				"",
				"",
				""
			]
		},
		"on-click": "pavucontrol"
	},
	"custom/media": {
		"format": "{icon} {text}",
		"return-type": "json",
		"max-length": 40,
		"format-icons": {
			"spotify": "",
			"default": "🎜"
		},
		"escape": true,
		"exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null" // Script in resources folder
		// "exec": "$HOME/.config/waybar/mediaplayer.py --player spotify 2> /dev/null" // Filter player based on name
	},
	"custom/power": {
		"format": "⏻ ",
		"tooltip": false,
		"menu": "on-click",
		"menu-file": "$HOME/.config/waybar/power_menu.xml", // Menu file in resources folder
		"menu-actions": {
			"shutdown": "shutdown",
			"reboot": "reboot",
			"suspend": "systemctl suspend",
			"hibernate": "systemctl hibernate"
		}
	}
}
