" Catppuccin Latte approximation for vifm (256-color terminals)

highlight clear

highlight Border      cterm=none           ctermfg=103     ctermbg=255
highlight TopLine     cterm=bold           ctermfg=60      ctermbg=254
highlight TopLineSel  cterm=bold           ctermfg=255     ctermbg=68

highlight Win         cterm=none           ctermfg=60      ctermbg=255
highlight OtherWin    cterm=none           ctermfg=103     ctermbg=255
highlight AuxWin      cterm=none           ctermfg=103     ctermbg=255
highlight Directory   cterm=bold           ctermfg=68      ctermbg=255
highlight CurrLine    cterm=bold,inverse   ctermfg=default ctermbg=default
highlight OtherLine   cterm=bold           ctermfg=default ctermbg=254
highlight Selected    cterm=bold           ctermfg=255     ctermbg=170
highlight LineNr      cterm=none           ctermfg=103     ctermbg=255

highlight JobLine     cterm=bold           ctermfg=255     ctermbg=68
highlight StatusLine  cterm=bold           ctermfg=255     ctermbg=68
highlight ErrorMsg    cterm=bold           ctermfg=167     ctermbg=255
highlight SuggestBox  cterm=bold           ctermfg=255     ctermbg=68
highlight WildMenu    cterm=bold           ctermfg=255     ctermbg=68
highlight CmdLine     cterm=none           ctermfg=60      ctermbg=255

highlight Executable  cterm=bold           ctermfg=71      ctermbg=255
highlight Link        cterm=none           ctermfg=68      ctermbg=255
highlight BrokenLink  cterm=bold           ctermfg=167     ctermbg=255
highlight Device      cterm=none,standout  ctermfg=209     ctermbg=255
highlight Fifo        cterm=none           ctermfg=73      ctermbg=255
highlight Socket      cterm=bold           ctermfg=176     ctermbg=255
