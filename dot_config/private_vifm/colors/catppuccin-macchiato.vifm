" Catppuccin Macchiato approximation for vifm (256-color terminals)

highlight clear

highlight Border      cterm=none           ctermfg=60      ctermbg=default
highlight TopLine     cterm=bold           ctermfg=103     ctermbg=default
highlight TopLineSel  cterm=bold           ctermfg=236     ctermbg=110

highlight Win         cterm=none           ctermfg=110     ctermbg=default
highlight OtherWin    cterm=none           ctermfg=103     ctermbg=default
highlight AuxWin      cterm=none           ctermfg=103     ctermbg=default
highlight Directory   cterm=bold           ctermfg=110     ctermbg=default
highlight CurrLine    cterm=bold           ctermfg=146     ctermbg=236
highlight OtherLine   cterm=bold           ctermfg=default ctermbg=236
highlight Selected    cterm=bold           ctermfg=236     ctermbg=239
highlight LineNr      cterm=none           ctermfg=103     ctermbg=default

highlight JobLine     cterm=bold           ctermfg=236     ctermbg=110
highlight StatusLine  cterm=bold           ctermfg=236     ctermbg=110
highlight ErrorMsg    cterm=bold           ctermfg=203     ctermbg=default
highlight SuggestBox  cterm=bold           ctermfg=236     ctermbg=110
highlight WildMenu    cterm=bold           ctermfg=236     ctermbg=110
highlight CmdLine     cterm=none           ctermfg=146     ctermbg=default

highlight Executable  cterm=bold           ctermfg=114     ctermbg=default
highlight Link        cterm=none           ctermfg=110     ctermbg=default
highlight BrokenLink  cterm=bold           ctermfg=203     ctermbg=default
highlight Device      cterm=none,standout  ctermfg=215     ctermbg=default
highlight Fifo        cterm=none           ctermfg=73      ctermbg=default
highlight Socket      cterm=bold           ctermfg=176     ctermbg=default
