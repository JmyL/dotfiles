[general]
status_path = "~/.local/state/vdirsyncer/status/"

[pair google_calendar]
a = "google_calendar_local"
b = "google_calendar_remote"
collections = ["from a", "from b"]
metadata = ["displayname", "color"]
conflict_resolution = "b wins"

[storage google_calendar_local]
type = "filesystem"
path = "~/.local/share/vdirsyncer/calendars/"
fileext = ".ics"

[storage google_calendar_remote]
type = "caldav"
url = "https://apidata.googleusercontent.com/caldav/v2/"
username = "happyss.nam@gmail.com"
password.fetch = ["command", "pass", "show", "mail/gmail/app-password"]

[pair google_contacts]
a = "google_contacts_local"
b = "google_contacts_remote"
collections = ["from a", "from b"]
metadata = ["displayname"]
conflict_resolution = "b wins"

[storage google_contacts_local]
type = "filesystem"
path = "~/.local/share/vdirsyncer/contacts/"
fileext = ".vcf"

[storage google_contacts_remote]
type = "carddav"
url = "https://www.googleapis.com/carddav/v1/principals/happyss.nam@gmail.com/lists/default/"
username = "happyss.nam@gmail.com"
password.fetch = ["command", "pass", "show", "mail/gmail/app-password"]
