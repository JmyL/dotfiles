{
  "$schema": "https://opencode.ai/config.json",
  // OpenCode Zen's provider ID is "opencode", not "zen".
  // This keeps Zen models out of the picker even if credentials exist.
  "disabled_providers": ["opencode"],
  // Keep agent runs on a stable, fast model for tool-heavy coding tasks.
  "model": {{ .opencode.defaultModel | default "openrouter/z-ai/glm-5.3-flash" | quote }},
  "small_model": "openrouter/openai/gpt-5.1-codex-mini",
  "provider": {
    "openrouter": {
      "models": {
        // Gemini 3.8 Flash is strict on function schemas; disable tool calls to avoid
        // GenerateContentRequest.function_declarations parameter validation errors.
        "google/gemini-3.8-flash": {
          "tool_call": false
        }
      }
    },
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      // Explicit models keep the provider alive even if the discovery plugin
      // fails; the plugin (if it works) adds the rest of the gateway models.
      "models": {
        "local-glm-5.3-flash": {
          "name": "GLM 5.3 Flash (LiteLLM local)"
        },
        "local-deepseek-v4.1-flash-1017": {
          "name": "DeepSeek 4.1 Flash 1017 (LiteLLM local)"
        }
      },
      "options": {
        "baseURL": "https://litellm.vayinfra.net/v1",
        "apiKey": "{env:LITELLM_API_KEY}",
        "modelsDiscovery": {
          "enabled": true,
          "modelInfoFormat": "litellm",
          "models": {
            "includeBy": [{ "field": "id", "match": "^local-" }]
          }
        }
      }
    }
  },
  "plugin": ["opencode-models-discovery"],
  "mcp": {
    "litellm-circleci": {
      "type": "remote",
      "url": "https://litellm.vayinfra.net/mcp/circleci_mcp",
      "headers": { "x-litellm-api-key": "Bearer {env:LITELLM_API_KEY}" },
      // Key-only server per LITELLM_MCP_SETUP.md; without this opencode
      // falls back to OAuth and reports "needs authentication".
      "oauth": false,
      "enabled": true,
      "timeout": 30000
    },
    "litellm-slack": {
      "type": "remote",
      "url": "https://litellm.vayinfra.net/mcp/slack",
      "headers": { "x-litellm-api-key": "Bearer {env:LITELLM_API_KEY}" },
      "enabled": true,
      "timeout": 30000
    },
    "litellm-atlassian": {
      "type": "remote",
      "url": "https://litellm.vayinfra.net/mcp/atlassian_mcp",
      "headers": { "x-litellm-api-key": "Bearer {env:LITELLM_API_KEY}" },
      "enabled": true,
      "timeout": 30000
    },
  },
  "permission": {
    "external_directory": {
      "*": "ask",
      "~/.local/bin/**": "allow",
      "~/.config/**": "allow",
      "/tmp/**": "allow",
      "/etc/os-release": "allow",
      "/usr/lib/os-release": "allow",
      "~/.local/share/**": "allow",
      "~/.claude/**": "allow",
      "~/.agents/**": "allow",
      "~/projects/**": "allow",
      "~/Documents/**": "allow"
    }
  },
  "experimental": {
    "policies": [
      {
        "effect": "deny",
        "action": "provider.use",
        "resource": "opencode"
      }
    ]
  }
}
