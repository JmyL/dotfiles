{
  "$schema": "https://opencode.ai/config.json",
  // OpenCode Zen's provider ID is "opencode", not "zen".
  // This keeps Zen models out of the picker even if credentials exist.
  "disabled_providers": ["opencode"],
  "mcp": {
    "circleci": {
      "type": "remote",
      "url": "https://mcp.circleci.com/v1/mcp",
      "enabled": true
    },
    "slack": {
      "type": "remote",
      "url": "https://mcp.slack.com/mcp",
      "enabled": true
    }
  },
  "permission": {
    "external_directory": {
      "*": "ask",
      "~/.local/bin/**": "allow",
      "~/.config/**": "allow",
      "/tmp/**": "allow",
      "/etc/os-release": "allow",
      "/usr/lib/os-release": "allow",
      "~/.local/share/**": "allow",
      "~/.claude/**": "allow",
      "~/.agents/**": "allow",
      "~/projects/**": "allow",
      "~/Documents/**": "allow"
    }
  },
  "experimental": {
    "policies": [
      {
        "effect": "deny",
        "action": "provider.use",
        "resource": "opencode"
      }
    ]
  }
}
