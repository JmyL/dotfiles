{
  "$schema": "https://opencode.ai/config.json",
  // OpenCode Zen's provider ID is "opencode", not "zen".
  // This keeps Zen models out of the picker even if credentials exist.
  "disabled_providers": ["opencode"],
  "mcp": {
    "circleci": {
      "type": "remote",
      "url": "https://mcp.circleci.com/v1/mcp",
      "enabled": true
    },
    "slack": {
      "type": "remote",
      "url": "https://mcp.slack.com/mcp",
      "enabled": true
    }
  },
  "experimental": {
    "policies": [
      {
        "effect": "deny",
        "action": "provider.use",
        "resource": "opencode"
      }
    ]
  }
}
