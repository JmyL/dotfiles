{
  "$schema": "https://opencode.ai/config.json",
  // OpenCode Zen's provider ID is "opencode", not "zen".
  // This keeps Zen models out of the picker even if credentials exist.
  "disabled_providers": ["opencode"],
  // Keep agent runs on a stable, fast model for tool-heavy coding tasks.
  "model": "openrouter/openai/gpt-5.1-codex-mini",
  "small_model": "openrouter/openai/gpt-5.1-codex-mini",
  "provider": {
    "openrouter": {
      "models": {
        // Gemini 3.8 Flash is strict on function schemas; disable tool calls to avoid
        // GenerateContentRequest.function_declarations parameter validation errors.
        "google/gemini-3.8-flash": {
          "tool_call": false
        }
      }
    }
  },
  "mcp": {
    "circleci": {
      "type": "remote",
      "url": "https://mcp.circleci.com/v1/mcp",
      "enabled": true
    },
    "slack": {
      "type": "remote",
      "url": "https://mcp.slack.com/mcp",
      "oauth": {
        // Reuse the already-approved Slack app that Cursor uses (public PKCE client, no secret needed).
        "clientId": "3660753192626.8903469228982",
        // The app only has Cursor's redirect URIs registered; use its local callback.
        "redirectUri": "http://localhost:8787/callback",
        "scope": "channels:history groups:history im:history mpim:history search:read.public search:read.private users:read"
      }
    },
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": true
    },
  },
  "permission": {
    "external_directory": {
      "*": "ask",
      "~/.local/bin/**": "allow",
      "~/.config/**": "allow",
      "/tmp/**": "allow",
      "/etc/os-release": "allow",
      "/usr/lib/os-release": "allow",
      "~/.local/share/**": "allow",
      "~/.claude/**": "allow",
      "~/.agents/**": "allow",
      "~/projects/**": "allow",
      "~/Documents/**": "allow"
    }
  },
  "experimental": {
    "policies": [
      {
        "effect": "deny",
        "action": "provider.use",
        "resource": "opencode"
      }
    ]
  }
}
