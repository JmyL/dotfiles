{
  "manifest_version": 3,
  "name": "Slack stay in browser",
  "version": "1.4.0",
  "description": "Rewrite Slack archives permalinks to messages so they open in the web client, reuse an existing Slack tab, and focus it via shortcut.",
  "permissions": ["declarativeNetRequest", "tabs", "scripting"],
  "host_permissions": ["*://*.slack.com/*", "*://app.slack.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "focus-slack-tab": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Focus an open Slack tab"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
