{
  "manifest_version": 3,
  "name": "Slack stay in browser",
  "version": "1.0.0",
  "description": "Rewrite Slack archives permalinks to messages so they open in the web client.",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["*://*.slack.com/*"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
