#!/usr/bin/env bash
set -euo pipefail

project="${1:-}"
[[ -n "$project" ]] || exit 0

project_file=""
if ! project_file="$(tmuxinator-chezmoi resolve "$project" 2>/dev/null)"; then
  tmux display-message "Project not found: $project" 2>/dev/null || printf '%s\n' "Project not found: $project"
  exit 0
fi

session="tmuxinator-edit-$project"
if tmux has-session -t "$session" 2>/dev/null; then
  tmux switch-client -t "$session"
  exit 0
fi

edit_dir="$(dirname "$project_file")"
tmux new-session -d -s "$session" -n "$project" -c "$edit_dir" "nvim $(printf '%q' "$project_file")"
tmux split-window -h -t "$session:1" -c "$edit_dir" "ai"
tmux select-pane -t "$session:1.1"
tmux switch-client -t "$session"
