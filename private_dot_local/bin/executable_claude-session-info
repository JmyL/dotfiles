#!/usr/bin/env python3
"""Extract folder/conversation-name/answer-summary from a Claude Code
Stop-hook JSON payload (read from stdin). Prints a single JSON object:
{"folder": ..., "name": ..., "summary": ...}
"""
import glob
import json
import os
import sys


def main():
    payload = json.load(sys.stdin)
    cwd = payload.get("cwd", "")
    session_id = payload.get("session_id", "")
    summary = (payload.get("last_assistant_message") or "").replace("\n", " ").strip()
    if len(summary) > 140:
        summary = summary[:137] + "..."

    name = ""
    for path in glob.glob(os.path.expanduser("~/.claude/sessions/*.json")):
        try:
            with open(path) as f:
                data = json.load(f)
        except (OSError, json.JSONDecodeError):
            continue
        if data.get("sessionId") == session_id:
            name = data.get("name") or ""
            break

    folder = os.path.basename(cwd.rstrip("/")) or cwd

    print(json.dumps({"folder": folder, "name": name, "summary": summary}))


if __name__ == "__main__":
    main()
