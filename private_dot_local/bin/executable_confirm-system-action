#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: ${0##*/} {suspend|restart-sway|poweroff|exit-sway}" >&2
}

notify_error() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "Confirm action" "$1" || true
  fi
}

if [[ $# -ne 1 ]]; then
  usage
  exit 2
fi

case "$1" in
  suspend)
    prompt="Suspend the system?"
    yes="Yes, suspend"
    command=(systemctl suspend)
    ;;
  restart-sway)
    prompt="Restart sway?"
    yes="Yes, restart sway"
    command=(swaymsg restart)
    ;;
  poweroff)
    prompt="Power off the system?"
    yes="Yes, power off"
    command=(systemctl poweroff)
    ;;
  exit-sway)
    prompt="Exit sway? This will end your Wayland session."
    yes="Yes, exit sway"
    command=(swaymsg exit)
    ;;
  *)
    usage
    exit 2
    ;;
esac

if ! command -v fuzzel >/dev/null 2>&1; then
  notify_error "fuzzel is not installed or not in PATH"
  exit 1
fi

choice="$(printf 'No\n%s\n' "$yes" | fuzzel --dmenu --prompt "$prompt ")"

if [[ "$choice" == "$yes" ]]; then
  "${command[@]}"
fi
