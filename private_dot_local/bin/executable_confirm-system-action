#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: ${0##*/} {suspend|restart-sway|poweroff|exit-sway}" >&2
}

notify_error() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "Confirm action" "$1" || true
  fi
}

if [[ $# -ne 1 ]]; then
  usage
  exit 2
fi

case "$1" in
  suspend)
    title="Suspend"
    prompt="Suspend the system?"
    yes="Suspend"
    command=(systemctl suspend)
    ;;
  restart-sway)
    title="Restart sway"
    prompt="Restart sway?"
    yes="Restart sway"
    command=(swaymsg restart)
    ;;
  poweroff)
    title="Power off"
    prompt="Power off the system?"
    yes="Power off"
    command=(systemctl poweroff)
    ;;
  exit-sway)
    title="Exit sway"
    prompt="Exit sway? This will end your Wayland session."
    yes="Exit sway"
    command=(swaymsg exit)
    ;;
  *)
    usage
    exit 2
    ;;
esac

if ! command -v zenity >/dev/null 2>&1; then
  notify_error "zenity is not installed or not in PATH"
  exit 1
fi

if zenity --question \
  --title "$title" \
  --text "$prompt" \
  --ok-label "$yes" \
  --cancel-label "Cancel"; then
  "${command[@]}"
fi
