#!/usr/bin/env python3
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path


def run(*args):
    return subprocess.run(args, check=True, text=True, capture_output=True)


def notify(title, body=""):
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", title, body], check=False)


def find_menu():
    # Sway's PATH has no ~/.local/bin, so prefer the sibling script.
    sibling = Path(__file__).resolve().parent / "fzf-menu"
    if os.access(sibling, os.X_OK):
        return str(sibling)
    return shutil.which("fzf-menu")


def pick(prompt, labels):
    menu = find_menu()
    if menu is None:
        notify("Audio switch failed", "fzf-menu not found")
        return None
    result = subprocess.run(
        [menu, "--prompt", f"{prompt}> "],
        input="\n".join(labels),
        text=True,
        capture_output=True,
    )
    if result.returncode != 0 or not result.stdout.strip():
        return None
    return result.stdout.strip()


def audio_nodes():
    graph = json.loads(run("pw-dump").stdout)
    sinks = []
    sources = []
    for obj in graph:
        props = ((obj.get("info") or {}).get("props")) or {}
        media_class = props.get("media.class")
        description = props.get("node.description")
        node_name = props.get("node.name") or ""
        device_id = props.get("device.id")
        if not description:
            continue
        if media_class == "Audio/Sink":
            sinks.append((description, node_name, device_id, obj["id"]))
        elif media_class == "Audio/Source":
            sources.append((description, node_name, device_id, obj["id"]))
    return sinks, sources


def find_builtin(nodes, prefer, avoid):
    for description, node_name, _device_id, node_id in nodes:
        lowered = description.lower()
        if node_name.startswith("alsa_") and prefer in lowered and avoid not in lowered:
            return node_id
    return None


def default_node_id(kind):
    try:
        out = run("wpctl", "inspect", f"@DEFAULT_AUDIO_{kind}@").stdout
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None
    for line in out.splitlines():
        stripped = line.strip()
        if stripped.startswith("id "):
            token = stripped.split(",", 1)[0].split()
            if len(token) >= 2 and token[1].isdigit():
                return int(token[1])
            return None
    return None


def labels_current_first(profiles, default_sink_id, default_source_id):
    by_sink = [
        label
        for label, (sink_id, _source_id) in profiles.items()
        if default_sink_id is not None and sink_id == default_sink_id
    ]
    current = by_sink or [
        label
        for label, (_sink_id, source_id) in profiles.items()
        if default_source_id is not None and source_id == default_source_id
    ]
    rest = [label for label in profiles if label not in current]
    return current + rest


def bluetooth_devices(sinks, sources):
    # Bluetooth sink/source nodes share the same parent device.id, so group by
    # that rather than just grabbing the first match -- otherwise a second
    # connected bluetooth device would have no menu entry at all.
    devices = {}
    for description, node_name, device_id, node_id in sinks:
        if node_name.startswith("bluez_output.") and device_id is not None:
            devices.setdefault(device_id, {"description": description})["sink"] = node_id
    for description, node_name, device_id, node_id in sources:
        if node_name.startswith("bluez_input.") and device_id is not None:
            devices.setdefault(device_id, {"description": description})["source"] = node_id
    return devices


def bluetooth_device_for_defaults(sinks, sources):
    default_sink_id = default_node_id("SINK")
    default_source_id = default_node_id("SOURCE")
    devices = bluetooth_devices(sinks, sources)

    for device_id, device in devices.items():
        if device.get("sink") == default_sink_id or device.get("source") == default_source_id:
            return device_id, device

    if len(devices) == 1:
        return next(iter(devices.items()))
    return None, None


def bluetooth_profile(device_id):
    try:
        details = run("pw-cli", "enum-params", str(device_id), "Profile").stdout
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None
    match = re.search(r'Profile:name.*?\n\s*String "([^"]+)"', details, re.DOTALL)
    return match.group(1) if match else None


def bluetooth_profile_indexes(device_id):
    try:
        details = run("pw-cli", "enum-params", str(device_id), "EnumProfile").stdout
    except (subprocess.CalledProcessError, FileNotFoundError):
        return {}
    return {
        name: int(index)
        for index, name in re.findall(
            r'Profile:index.*?\n\s*Int\s+(\d+).*?Profile:name.*?\n\s*String "([^"]+)"',
            details,
            re.DOTALL,
        )
    }


def wait_for_bluetooth_nodes(device_id, timeout=5):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        sinks, sources = audio_nodes()
        device = bluetooth_devices(sinks, sources).get(device_id)
        if device is not None and device.get("sink") is not None and device.get("source") is not None:
            return device
        time.sleep(0.1)
    return None


def toggle_bluetooth_mic_profile():
    sinks, sources = audio_nodes()
    device_id, device = bluetooth_device_for_defaults(sinks, sources)
    if device_id is None:
        notify("Microphone profile failed", "Select one Bluetooth headset first")
        return 1

    current_profile = bluetooth_profile(device_id)
    choices = {"Music quality (A2DP)": "a2dp-sink", "Mic ready (HFP mSBC)": "headset-head-unit"}
    labels = sorted(choices, key=lambda label: choices[label] != current_profile)
    target_label = pick("Microphone profile", labels)
    if target_label is None:
        return 0
    target_profile = choices[target_label]
    if target_profile == current_profile:
        return 0
    profile_index = bluetooth_profile_indexes(device_id).get(target_profile)
    if profile_index is None:
        notify("Microphone profile failed", f"{target_label} is unavailable")
        return 1

    try:
        run("wpctl", "set-profile", str(device_id), str(profile_index))
    except (subprocess.CalledProcessError, FileNotFoundError):
        notify("Microphone profile failed", f"Could not switch to {target_label}")
        return 1

    device = wait_for_bluetooth_nodes(device_id)
    if device is None:
        notify("Microphone profile failed", "Headset did not become ready")
        return 1

    subprocess.run(["wpctl", "set-default", str(device["sink"])], check=True)
    subprocess.run(["wpctl", "set-default", str(device["source"])], check=True)
    notify("Audio profile", f"{device['description']}: {target_label}")
    return 0


def graph_objects():
    return json.loads(run("pw-dump").stdout)


def props(obj):
    return obj.get("info", {}).get("props", {})


def capture_context():
    graph = graph_objects()
    source_id = default_node_id("SOURCE")
    sink_id = default_node_id("SINK")
    source = next((x for x in graph if x['id'] == source_id), {})
    device = next((x for x in graph if x['id'] == props(source).get('device.id')), {})
    if props(device).get('device.api') != 'bluez5':
        return None
    sink = next((x for x in graph if x['id'] == sink_id), {})
    return {'device': props(device)['device.name'],
            'profile': bluetooth_profile(device['id']),
            'sink': props(sink).get('node.name')}


def set_device_profile(name, profile):
    device = next(x for x in graph_objects() if props(x).get('device.name') == name
                  and x['type'].endswith(':Device'))
    index = bluetooth_profile_indexes(device['id']).get(profile)
    if index is None:
        raise RuntimeError(f'Profile unavailable: {profile}')
    run('wpctl', 'set-profile', str(device['id']), str(index))
    deadline = time.monotonic() + 8
    while time.monotonic() < deadline:
        if bluetooth_profile(device['id']) == profile:
            return
        time.sleep(.1)
    raise RuntimeError('Profile switch timed out')


def physical_source(name):
    deadline = time.monotonic() + 8
    while time.monotonic() < deadline:
        graph = graph_objects()
        ids = {x['id'] for x in graph if props(x).get('device.name') == name}
        for obj in graph:
            p = props(obj)
            if (p.get('device.id') in ids and p.get('media.class') in ('Audio/Source', 'Audio/Source/Internal')
                    and not p.get('bluez5.loopback')):
                return p['node.name']
        time.sleep(.1)
    raise RuntimeError('Bluetooth microphone did not appear')


def restore_sink(name):
    if not name:
        return
    deadline = time.monotonic() + 8
    while time.monotonic() < deadline:
        for obj in graph_objects():
            if props(obj).get('node.name') == name:
                run('wpctl', 'set-default', str(obj['id']))
                return
        time.sleep(.1)
    raise RuntimeError(f'Original output did not return: {name}')


def prepare_capture(state):
    context = capture_context()
    if context is None:
        state.unlink(missing_ok=True)
        return ''
    context['changed'] = context['profile'] not in ('headset-head-unit', 'headset-head-unit-cvsd')
    state.write_text(json.dumps(context))
    if context['changed']:
        set_device_profile(context['device'], 'headset-head-unit')
    # Bypass WirePlumber's virtual autoswitch source: its last-client cleanup
    # can restore an old (even Off) profile after a manual HFP selection.
    return physical_source(context['device'])


def restore_capture(state):
    if not state.exists():
        return
    context = json.loads(state.read_text())
    if context['changed']:
        set_device_profile(context['device'], context['profile'])
        restore_sink(context['sink'])
    state.unlink()


def main():
    if len(sys.argv) == 3 and sys.argv[1] in ('--prepare-capture', '--restore-capture'):
        state = Path(sys.argv[2])
        try:
            if sys.argv[1] == '--prepare-capture':
                print(prepare_capture(state))
            else:
                restore_capture(state)
            return 0
        except (RuntimeError, subprocess.CalledProcessError, StopIteration) as error:
            print(str(error), file=sys.stderr)
            return 1
    if sys.argv[1:] == ["--toggle-mic-profile"]:
        return toggle_bluetooth_mic_profile()
    if len(sys.argv) != 1:
        print(f"Usage: {sys.argv[0]} [--toggle-mic-profile]", file=sys.stderr)
        return 2

    sinks, sources = audio_nodes()

    laptop_sink = find_builtin(sinks, "speaker", "headphones")
    laptop_source = find_builtin(sources, "mic", "headset")

    profiles = {"Laptop (speaker + mic)": (laptop_sink, laptop_source)}
    for device_id, device in bluetooth_devices(sinks, sources).items():
        label = f"{device['description']} (earbuds)"
        if label in profiles:
            label = f"{label} [{device_id}]"
        profiles[label] = (device.get("sink"), device.get("source"))

    labels = labels_current_first(
        profiles, default_node_id("SINK"), default_node_id("SOURCE")
    )
    choice = pick("Audio", labels)
    if choice is None:
        return 0

    sink_id, source_id = profiles[choice]
    if sink_id is not None:
        subprocess.run(["wpctl", "set-default", str(sink_id)], check=True)
    if source_id is not None:
        subprocess.run(["wpctl", "set-default", str(source_id)], check=True)

    if sink_id is None and source_id is None:
        notify("Audio switch failed", f"No devices found for {choice}")
        return 1

    notify("Audio switched", choice)
    return 0


if __name__ == "__main__":
    sys.exit(main())
