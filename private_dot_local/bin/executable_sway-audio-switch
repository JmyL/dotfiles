#!/usr/bin/env python3
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path


def run(*args):
    return subprocess.run(args, check=True, text=True, capture_output=True)


def notify(title, body=""):
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", title, body], check=False)


def find_menu():
    # Sway's PATH has no ~/.local/bin, so prefer the sibling script.
    sibling = Path(__file__).resolve().parent / "fzf-menu"
    if os.access(sibling, os.X_OK):
        return str(sibling)
    return shutil.which("fzf-menu")


def pick(prompt, labels):
    menu = find_menu()
    if menu is None:
        notify("Audio switch failed", "fzf-menu not found")
        return None
    result = subprocess.run(
        [menu, "--prompt", f"{prompt}> "],
        input="\n".join(labels),
        text=True,
        capture_output=True,
    )
    if result.returncode != 0 or not result.stdout.strip():
        return None
    return result.stdout.strip()


def audio_nodes():
    graph = json.loads(run("pw-dump").stdout)
    sinks = []
    sources = []
    for obj in graph:
        props = ((obj.get("info") or {}).get("props")) or {}
        media_class = props.get("media.class")
        description = props.get("node.description")
        node_name = props.get("node.name") or ""
        device_id = props.get("device.id")
        if not description:
            continue
        if media_class == "Audio/Sink":
            sinks.append((description, node_name, device_id, obj["id"]))
        elif media_class == "Audio/Source":
            sources.append((description, node_name, device_id, obj["id"]))
    return sinks, sources


def find_builtin(nodes, prefer, avoid):
    for description, node_name, _device_id, node_id in nodes:
        lowered = description.lower()
        if node_name.startswith("alsa_") and prefer in lowered and avoid not in lowered:
            return node_id
    return None


def default_node_id(kind):
    try:
        out = run("wpctl", "inspect", f"@DEFAULT_AUDIO_{kind}@").stdout
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None
    for line in out.splitlines():
        stripped = line.strip()
        if stripped.startswith("id "):
            token = stripped.split(",", 1)[0].split()
            if len(token) >= 2 and token[1].isdigit():
                return int(token[1])
            return None
    return None


def labels_current_first(profiles, default_sink_id, default_source_id):
    by_sink = [
        label
        for label, (sink_id, _source_id) in profiles.items()
        if default_sink_id is not None and sink_id == default_sink_id
    ]
    current = by_sink or [
        label
        for label, (_sink_id, source_id) in profiles.items()
        if default_source_id is not None and source_id == default_source_id
    ]
    rest = [label for label in profiles if label not in current]
    return current + rest


def bluetooth_devices(sinks, sources):
    # Bluetooth sink/source nodes share the same parent device.id, so group by
    # that rather than just grabbing the first match -- otherwise a second
    # connected bluetooth device would have no menu entry at all.
    devices = {}
    for description, node_name, device_id, node_id in sinks:
        if node_name.startswith("bluez_output.") and device_id is not None:
            devices.setdefault(device_id, {"description": description})["sink"] = node_id
    for description, node_name, device_id, node_id in sources:
        if node_name.startswith("bluez_input.") and device_id is not None:
            devices.setdefault(device_id, {"description": description})["source"] = node_id
    return devices


def main():
    sinks, sources = audio_nodes()

    laptop_sink = find_builtin(sinks, "speaker", "headphones")
    laptop_source = find_builtin(sources, "mic", "headset")

    profiles = {"Laptop (speaker + mic)": (laptop_sink, laptop_source)}
    for device_id, device in bluetooth_devices(sinks, sources).items():
        label = f"{device['description']} (earbuds)"
        if label in profiles:
            label = f"{label} [{device_id}]"
        profiles[label] = (device.get("sink"), device.get("source"))

    labels = labels_current_first(
        profiles, default_node_id("SINK"), default_node_id("SOURCE")
    )
    choice = pick("Audio", labels)
    if choice is None:
        return 0

    sink_id, source_id = profiles[choice]
    if sink_id is not None:
        subprocess.run(["wpctl", "set-default", str(sink_id)], check=True)
    if source_id is not None:
        subprocess.run(["wpctl", "set-default", str(source_id)], check=True)

    if sink_id is None and source_id is None:
        notify("Audio switch failed", f"No devices found for {choice}")
        return 1

    notify("Audio switched", choice)
    return 0


if __name__ == "__main__":
    sys.exit(main())
