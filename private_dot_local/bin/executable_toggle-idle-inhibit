#!/usr/bin/env bash
set -euo pipefail

pidfile="${XDG_RUNTIME_DIR:-/tmp}/manual-idle-inhibit.pid"

if [[ -f "$pidfile" ]]; then
  pid="$(cat "$pidfile" 2>/dev/null || true)"
  if [[ -n "${pid:-}" ]] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid"
    rm -f "$pidfile"
    pkill -RTMIN+8 waybar 2>/dev/null || true
    exit 0
  fi
  rm -f "$pidfile"
fi

systemd-inhibit --what=idle --why="Manual idle inhibitor" sleep infinity &
echo "$!" > "$pidfile"
pkill -RTMIN+8 waybar 2>/dev/null || true
