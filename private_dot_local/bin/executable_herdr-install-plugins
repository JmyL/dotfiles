#!/usr/bin/env bash
set -euo pipefail

list="${1:-${XDG_CONFIG_HOME:-$HOME/.config}/herdr/plugins.list}"

if [[ ! -f "$list" ]]; then
  printf 'Herdr plugin list not found: %s\n' "$list" >&2
  exit 1
fi

while read -r repo ref extra; do
  case "$repo" in
  '' | '#'*)
    continue
    ;;
  esac

  if [[ -n "${extra:-}" ]]; then
    printf 'Invalid line in %s: %s %s %s\n' "$list" "$repo" "${ref:-}" "$extra" >&2
    exit 1
  fi

  if [[ -n "${ref:-}" ]]; then
    herdr plugin install "$repo" --ref "$ref" --yes
  else
    herdr plugin install "$repo" --yes
  fi
done <"$list"

# Chezmoi-managed local plugins (not in plugins.list GitHub format).
local_root="${XDG_CONFIG_HOME:-$HOME/.config}/herdr/plugins/local"
if [[ -d "$local_root" ]]; then
  for plugin_dir in "$local_root"/*; do
    [[ -d "$plugin_dir" ]] || continue
    [[ -f "$plugin_dir/herdr-plugin.toml" ]] || continue
    herdr plugin link "$plugin_dir" --enabled
  done
fi
