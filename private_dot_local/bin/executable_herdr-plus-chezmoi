#!/usr/bin/env bash
# Route herdr-plus projects by working_dir: under $HOME/projects → work chezmoi; else personal.
set -euo pipefail

xdg_config="${XDG_CONFIG_HOME:-$HOME/.config}"
work_config="$xdg_config/chezmoi/chezmoi-work.toml"
plugin_projects="$xdg_config/herdr/plugins/config/cloudmanic.herdr-plus/projects"
work_projects="$xdg_config/work/herdr-plus/projects"
personal_source="${CHEZMOI_SOURCE:-$HOME/.local/share/chezmoi}"
work_source="$HOME/.local/share/chezmoi-work"
personal_gh="JmyL"
work_gh="sungsik-nam-vay"
projects_root="$HOME/projects"
# discovery → ~/.config is five levels up
work_link_target="../../../../../work/herdr-plus/projects"

usage() {
  cat >&2 <<'EOF'
Usage: herdr-plus-chezmoi <command> [args]

Commands:
  is-work-root <path>
  kind-from-root <path>
  kind <name>
  toml-path <name> [working_dir]
  link-path <name>
  resolve <name>
  prepare-new <name> <working_dir>
  ensure-link <name>
  install-toml <name> <file>
  ensure-layout <name>
  track-add <name>
  track-delete <name>
EOF
  exit 2
}

expand_path() {
  local path="$1"
  case "$path" in
  "")
    printf '%s\n' "$HOME"
    ;;
  '~')
    printf '%s\n' "$HOME"
    ;;
  '~/'*)
    printf '%s\n' "$HOME/${path#"~/"}"
    ;;
  *)
    printf '%s\n' "$path"
    ;;
  esac
}

normalize_path() {
  local path
  path="$(expand_path "$1")"
  if command -v realpath >/dev/null 2>&1; then
    realpath -m "$path" 2>/dev/null || printf '%s\n' "$path"
  else
    printf '%s\n' "$path"
  fi
}

is_work_root() {
  local expanded projects_abs
  expanded="$(normalize_path "$1")"
  projects_abs="$(normalize_path "$projects_root")"
  [[ "$expanded" == "$projects_abs" || "$expanded" == "$projects_abs"/* ]]
}

kind_from_root() {
  if is_work_root "$1"; then
    printf 'work\n'
  else
    printf 'personal\n'
  fi
}

trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s\n' "$s"
}

unquote() {
  local s
  s="$(trim "$1")"
  if [[ "$s" == \"*\" && "$s" == *\" ]]; then
    s="${s:1:-1}"
  elif [[ "$s" == \'*\' && "$s" == *\' ]]; then
    s="${s:1:-1}"
  fi
  printf '%s\n' "$s"
}

working_dir_from_toml() {
  local file="$1" line
  [[ -f "$file" ]] || return 1
  line="$(grep -E '^working_dir[[:space:]]*=' "$file" | head -1 || true)"
  [[ -n "$line" ]] || {
    printf '~\n'
    return 0
  }
  line="${line#*=}"
  unquote "$line"
}

kind_for_name() {
  local name="$1" path wd
  path="$(resolve_existing "$name" 2>/dev/null || true)"
  if [[ -n "$path" && -f "$path" ]]; then
    wd="$(working_dir_from_toml "$path")"
    kind_from_root "$wd"
    return 0
  fi
  printf 'personal\n'
}

link_path() {
  printf '%s\n' "$plugin_projects/$1.toml"
}

toml_path_for_kind() {
  local name="$1" kind="$2"
  if [[ "$kind" == work ]]; then
    printf '%s\n' "$work_projects/$name.toml"
  else
    printf '%s\n' "$plugin_projects/$name.toml"
  fi
}

toml_path() {
  local name="$1" wd="${2:-}" kind path
  if [[ -n "$wd" ]]; then
    kind="$(kind_from_root "$wd")"
    toml_path_for_kind "$name" "$kind"
    return 0
  fi
  path="$(resolve_existing "$name" 2>/dev/null || true)"
  if [[ -n "$path" ]]; then
    printf '%s\n' "$path"
    return 0
  fi
  toml_path_for_kind "$name" personal
}

resolve_existing() {
  local name="$1" link target
  link="$(link_path "$name")"
  if [[ -L "$link" ]]; then
    target="$(readlink -f "$link" 2>/dev/null || true)"
    [[ -n "$target" && -e "$target" ]] || return 1
    printf '%s\n' "$target"
  elif [[ -f "$link" ]]; then
    printf '%s\n' "$link"
  elif [[ -f "$work_projects/$name.toml" ]]; then
    printf '%s\n' "$work_projects/$name.toml"
  else
    return 1
  fi
}

chezmoi_for() {
  local kind="$1"
  shift
  if [[ "$kind" == work ]]; then
    chezmoi --config "$work_config" "$@"
  else
    chezmoi "$@"
  fi
}

source_dir_for() {
  if [[ "$1" == work ]]; then
    printf '%s\n' "$work_source"
  else
    printf '%s\n' "$personal_source"
  fi
}

gh_user_for() {
  if [[ "$1" == work ]]; then
    printf '%s\n' "$work_gh"
  else
    printf '%s\n' "$personal_gh"
  fi
}

ensure_work_symlink() {
  local name="$1" link
  link="$(link_path "$name")"
  mkdir -p "$work_projects" "$plugin_projects"
  ln -sfn "$work_link_target/$name.toml" "$link"
}

write_stub() {
  local name="$1" path="$2" wd="$3"
  mkdir -p "$(dirname "$path")"
  cat >"$path" <<EOF
name = "$name"
description = ""
working_dir = "$wd"

[[tabs]]
name = "editor"
command = "nvim"
EOF
}

prepare_new() {
  local name="$1" wd="$2" kind path
  [[ -n "$wd" ]] || {
    printf 'working_dir required\n' >&2
    return 1
  }
  kind="$(kind_from_root "$wd")"
  path="$(toml_path_for_kind "$name" "$kind")"
  if [[ -e "$(link_path "$name")" || -e "$path" ]]; then
    printf 'Project already exists: %s\n' "$name" >&2
    return 1
  fi
  write_stub "$name" "$path" "$wd"
  if [[ "$kind" == work ]]; then
    ensure_work_symlink "$name"
  fi
  printf '%s\n' "$path"
}

ensure_link() {
  local name="$1" kind
  kind="$(kind_for_name "$name")"
  if [[ "$kind" == work ]]; then
    [[ -f "$(toml_path_for_kind "$name" work)" ]] || {
      printf 'Missing work toml: %s\n' "$(toml_path_for_kind "$name" work)" >&2
      return 1
    }
    ensure_work_symlink "$name"
  fi
}

install_toml() {
  local name="$1" src="$2" wd kind dest link current
  [[ -f "$src" ]] || {
    printf 'Missing toml source: %s\n' "$src" >&2
    return 1
  }
  wd="$(working_dir_from_toml "$src")"
  kind="$(kind_from_root "$wd")"
  dest="$(toml_path_for_kind "$name" "$kind")"
  link="$(link_path "$name")"
  mkdir -p "$(dirname "$dest")" "$plugin_projects"

  current="$(resolve_existing "$name" 2>/dev/null || true)"

  if [[ "$kind" == work ]]; then
    if [[ -n "$current" && "$current" != "$dest" && -f "$current" && ! -L "$link" ]]; then
      rm -f "$current"
    fi
    if [[ "$(readlink -f "$src" 2>/dev/null || true)" != "$(readlink -f "$dest" 2>/dev/null || true)" ]]; then
      cp -f "$src" "$dest"
    fi
    ensure_work_symlink "$name"
    if [[ -n "$current" && "$current" != "$dest" && -f "$current" ]]; then
      rm -f "$current"
    fi
  else
    if [[ -L "$link" ]]; then
      rm -f "$link"
    fi
    if [[ -f "$work_projects/$name.toml" && "$(readlink -f "$src" 2>/dev/null || true)" != "$(readlink -f "$work_projects/$name.toml" 2>/dev/null || true)" ]]; then
      rm -f "$work_projects/$name.toml"
    fi
    if [[ "$(readlink -f "$src" 2>/dev/null || true)" != "$(readlink -f "$dest" 2>/dev/null || true)" ]]; then
      cp -f "$src" "$dest"
    fi
  fi
  printf '%s\n' "$dest"
}

ensure_layout() {
  local name="$1" path tmp
  path="$(resolve_existing "$name")" || {
    printf 'No toml for project: %s\n' "$name" >&2
    return 1
  }
  tmp="$(mktemp)"
  cp -f "$path" "$tmp"
  install_toml "$name" "$tmp"
  rm -f "$tmp"
}

append_chezmoiremove() {
  local source_dir="$1"
  shift
  local file="$source_dir/.chezmoiremove" path
  touch "$file"
  for path in "$@"; do
    grep -Fxq -- "$path" "$file" 2>/dev/null && continue
    printf '%s\n' "$path" >>"$file"
  done
}

forget_target() {
  local kind="$1" target="$2"
  chezmoi_for "$kind" forget "$target" >/dev/null 2>&1 || true
}

source_paths_for() {
  local name="$1" kind="$2"
  if [[ "$kind" == work ]]; then
    printf '%s\n' \
      "dot_config/work/herdr-plus/projects/${name}.toml" \
      "dot_config/herdr/plugins/config/cloudmanic.herdr-plus/projects/symlink_${name}.toml"
  else
    printf '%s\n' "dot_config/herdr/plugins/config/cloudmanic.herdr-plus/projects/${name}.toml"
  fi
}

commit_push() {
  local kind="$1" message="$2"
  shift 2
  local source_dir gh_user
  local -a paths=()
  local p

  [[ $# -gt 0 ]] || return 0

  source_dir="$(source_dir_for "$kind")"
  gh_user="$(gh_user_for "$kind")"

  for p in "$@"; do
    paths+=("$p")
  done

  git -C "$source_dir" add -- "${paths[@]}"
  if git -C "$source_dir" diff --cached --quiet -- "${paths[@]}"; then
    return 0
  fi
  git -C "$source_dir" commit -m "$message" -- "${paths[@]}"

  gh auth switch --user "$gh_user" >/dev/null
  if [[ "$HOME" == /var/home/* && -x "$HOME/.local/bin/dev-launcher" && "$kind" == personal ]]; then
    "$HOME/.local/bin/dev-launcher" git -C "$source_dir" push
  else
    git -C "$source_dir" push
  fi
}

track_add() {
  local name="$1" kind path link
  local -a paths=()
  ensure_layout "$name" >/dev/null
  kind="$(kind_for_name "$name")"
  path="$(toml_path_for_kind "$name" "$kind")"
  link="$(link_path "$name")"

  [[ -f "$path" ]] || {
    printf 'No toml to track: %s\n' "$path" >&2
    return 1
  }

  if [[ "$kind" == work ]]; then
    ensure_work_symlink "$name"
    chezmoi_for work add "$path" "$link"
  else
    chezmoi_for personal add "$link"
  fi
  mapfile -t paths < <(source_paths_for "$name" "$kind")
  commit_push "$kind" "Track herdr-plus project $name" "${paths[@]}"
}

remove_live() {
  local name="$1" kind="$2" link toml target
  link="$(link_path "$name")"
  toml="$(toml_path_for_kind "$name" "$kind")"

  if [[ -L "$link" ]]; then
    target="$(readlink -f "$link" 2>/dev/null || true)"
    rm -f "$link"
    [[ -n "$target" && -e "$target" ]] && rm -f "$target"
  else
    rm -f "$link"
  fi
  if [[ "$kind" == work ]]; then
    rm -f "$toml"
  fi
}

remove_source_entries() {
  local name="$1" kind="$2" source_dir
  source_dir="$(source_dir_for "$kind")"
  if [[ "$kind" == work ]]; then
    forget_target work "$(link_path "$name")"
    forget_target work "$(toml_path_for_kind "$name" work)"
    rm -f "$source_dir/dot_config/herdr/plugins/config/cloudmanic.herdr-plus/projects/symlink_${name}.toml"
    rm -f "$source_dir/dot_config/work/herdr-plus/projects/${name}.toml"
  else
    forget_target personal "$(link_path "$name")"
    rm -f "$source_dir/dot_config/herdr/plugins/config/cloudmanic.herdr-plus/projects/${name}.toml"
  fi
}

track_delete() {
  local name="$1" kind
  local -a paths=()
  kind="$(kind_for_name "$name")"

  remove_live "$name" "$kind"
  remove_source_entries "$name" "$kind"

  mapfile -t paths < <(source_paths_for "$name" "$kind")
  paths+=(".chezmoiremove")

  if [[ "$kind" == work ]]; then
    append_chezmoiremove "$(source_dir_for work)" \
      ".config/herdr/plugins/config/cloudmanic.herdr-plus/projects/${name}.toml" \
      ".config/work/herdr-plus/projects/${name}.toml"
  else
    append_chezmoiremove "$(source_dir_for personal)" \
      ".config/herdr/plugins/config/cloudmanic.herdr-plus/projects/${name}.toml"
  fi
  commit_push "$kind" "Remove herdr-plus project $name" "${paths[@]}"
}

cmd="${1:-}"
shift || true

case "$cmd" in
is-work-root)
  [[ $# -eq 1 ]] || usage
  is_work_root "$1"
  ;;
kind-from-root)
  [[ $# -eq 1 ]] || usage
  kind_from_root "$1"
  ;;
kind)
  [[ $# -eq 1 ]] || usage
  kind_for_name "$1"
  ;;
toml-path)
  [[ $# -ge 1 && $# -le 2 ]] || usage
  toml_path "$@"
  ;;
link-path)
  [[ $# -eq 1 ]] || usage
  link_path "$1"
  ;;
resolve)
  [[ $# -eq 1 ]] || usage
  resolve_existing "$1"
  ;;
prepare-new)
  [[ $# -eq 2 ]] || usage
  prepare_new "$1" "$2"
  ;;
ensure-link)
  [[ $# -eq 1 ]] || usage
  ensure_link "$1"
  ;;
install-toml)
  [[ $# -eq 2 ]] || usage
  install_toml "$1" "$2"
  ;;
ensure-layout)
  [[ $# -eq 1 ]] || usage
  ensure_layout "$1"
  ;;
track-add)
  [[ $# -eq 1 ]] || usage
  track_add "$1"
  ;;
track-delete)
  [[ $# -eq 1 ]] || usage
  track_delete "$1"
  ;;
*)
  usage
  ;;
esac
