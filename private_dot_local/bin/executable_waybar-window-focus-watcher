#!/usr/bin/env python3
"""Refresh Waybar's window icon when sway focus changes.

Heavy icon lookup runs here (not inside Waybar). Waybar only reloads a cached
PNG via signal, so the GTK main loop is not blocked and workspace highlights
stay snappy on dual-monitor setups.
"""

from __future__ import annotations

import fcntl
import json
import os
import subprocess
import sys
import threading
from pathlib import Path

LOCKFILE = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "waybar-window-focus-watcher.lock"
ICON_WRITER = Path.home() / ".local/bin/waybar-window-icon"
WAYBAR_SIGNAL = "RTMIN+9"
REFRESH_CHANGES = frozenset({"focus", "close"})
DEBOUNCE_SEC = 0.05


def refresh_icon() -> None:
    subprocess.run([str(ICON_WRITER), "--write"], check=False, capture_output=True)
    subprocess.run(["/usr/bin/pkill", "-" + WAYBAR_SIGNAL, "waybar"], check=False)


def main() -> None:
    LOCKFILE.parent.mkdir(parents=True, exist_ok=True)
    lock_fd = os.open(LOCKFILE, os.O_CREAT | os.O_RDWR, 0o644)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(lock_fd)
        return

    # Seed cache before Waybar is signaled for the first focus change.
    refresh_icon()

    proc = subprocess.Popen(
        ["swaymsg", "-t", "subscribe", "-m", '["window","workspace"]'],
        text=True,
        stdout=subprocess.PIPE,
    )
    assert proc.stdout is not None

    lock = threading.Lock()
    timer: threading.Timer | None = None

    def flush() -> None:
        nonlocal timer
        with lock:
            timer = None
        refresh_icon()

    def schedule() -> None:
        nonlocal timer
        with lock:
            if timer is not None:
                timer.cancel()
            timer = threading.Timer(DEBOUNCE_SEC, flush)
            timer.daemon = True
            timer.start()

    for line in proc.stdout:
        line = line.strip()
        if not line:
            continue
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if event.get("change") in REFRESH_CHANGES:
            schedule()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(0)
