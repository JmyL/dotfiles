#!/usr/bin/env bash
# dmenu-like picker: floating foot + fzf (stdin -> stdout)
set -euo pipefail

prompt='Select> '
height=24
width=80
accept_query=0

while [[ $# -gt 0 ]]; do
  case "$1" in
  --prompt | -p)
    prompt=${2:-Select> }
    shift 2
    ;;
  --accept-query)
    accept_query=1
    shift
    ;;
  --height)
    height=${2:-24}
    shift 2
    ;;
  --width)
    width=${2:-80}
    shift 2
    ;;
  --)
    shift
    break
    ;;
  -*)
    echo "fzf-menu: unknown option: $1" >&2
    exit 2
    ;;
  *)
    break
    ;;
  esac
done

# Sway's PATH has no ~/.local/bin; apt foot 1.25 ignores [colors-dark] (alpha).
foot_bin="${HOME}/.local/bin/foot"
if [[ ! -x $foot_bin ]]; then
  if ! foot_bin=$(command -v foot); then
    echo "fzf-menu: foot not found" >&2
    exit 127
  fi
fi
if ! command -v fzf >/dev/null 2>&1; then
  echo "fzf-menu: fzf not found" >&2
  exit 127
fi

input=$(mktemp)
output=$(mktemp)
status_file=$(mktemp)
trap 'rm -f "$input" "$output" "$status_file"' EXIT

cat >"$input"

# No stdin items -> nothing to pick.
if [[ ! -s $input ]]; then
  exit 1
fi

fzf_flags=(--prompt="$prompt" --height=100% --layout=reverse --border --info=inline)
if ((accept_query)); then
  fzf_flags+=(--print-query)
fi

"$foot_bin" --app-id=fzf-menu \
  --title="${prompt%%>*}" \
  --window-size-chars="${width}x${height}" \
  bash -c '
    set +e
    fzf "${@:4}" <"$1" >"$2"
    echo $? >"$3"
  ' bash "$input" "$output" "$status_file" "${fzf_flags[@]}"

status=1
if [[ -s $status_file ]]; then
  status=$(cat "$status_file")
fi

if ((accept_query)); then
  # --print-query prints the query first, the selected item second.
  # Esc exits 130 (fzf may still print the query) and errors exit 2 —
  # both must stay cancellations, not "typed text".
  if ((status != 130 && status != 2)) && [[ -s $output ]]; then
    if [[ $(wc -l <"$output") -ge 2 ]]; then
      # Selection wins over echoing the query back.
      sed -n '2p' "$output"
      exit 0
    fi
    # Enter with zero matches: the typed query IS the choice.
    choice=$(sed -n '1p' "$output")
    if [[ -n $choice ]]; then
      printf '%s\n' "$choice"
      exit 0
    fi
  fi
  exit 1
fi

if [[ $status -eq 0 && -s $output ]]; then
  # Keep a single trailing newline like dmenu/fuzzel.
  cat "$output"
  [[ $(tail -c1 "$output" | wc -l) -eq 0 ]] && printf '\n'
  exit 0
fi

exit 1
