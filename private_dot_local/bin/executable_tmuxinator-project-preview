#!/usr/bin/env bash
set -euo pipefail

project="${1:-}"
file=""
if ! file="$(tmuxinator-chezmoi resolve "$project" 2>/dev/null)"; then
  file="${XDG_CONFIG_HOME:-$HOME/.config}/tmuxinator/$project.yml"
fi

if tmux has-session -t "$project" 2>/dev/null; then
  window="$(tmux list-windows -t "$project" -F '#{window_index}' 2>/dev/null | sort -n | head -1)"
  if [[ -n "$window" ]]; then
    tmux capture-pane -ep -t "$project:$window" 2>/dev/null && exit 0
  fi
fi

if command -v bat >/dev/null 2>&1; then
  bat --color=always --style=numbers "$file" 2>/dev/null || cat "$file"
else
  cat "$file"
fi
