#!/usr/bin/env bash
set -euo pipefail

prompt='Notifications> '

notification_entries() {
  (makoctl list -j 2>/dev/null || printf '[]\n') |
    jq -r '
      (.data? // .notifications? // .) as $root
      | if ($root | type) == "array" then $root[] else empty end
      | [
          (.id | tostring),
          (.app_name // .["app-name"] // .appName // .application // "notification"),
          (.summary // ""),
          (.body // "")
        ]
      | @tsv
    ' |
    while IFS=$'\t' read -r id app summary body; do
      label=$app
      if [[ -n $summary ]]; then
        label+=" | $summary"
      fi
      if [[ -n $body ]]; then
        label+=" | $body"
      fi
      printf '[%s] %s\n' "$id" "$label"
    done
}

entries="$(notification_entries)"
[[ -n "$entries" ]] || exit 0

choice=$(printf '%s\n' "$entries" | fuzzel --dmenu --width 100 --prompt "$prompt") || exit 0

case $choice in
'')
  exit 0
  ;;
\[*\]*)
  id=${choice%%]*}
  id=${id#\[}
  makoctl invoke -n "$id"
  ;;
esac
