#!/usr/bin/env bash
set -euo pipefail

prompt='Notifications> '

notification_entries() {
  (makoctl history -j 2>/dev/null || printf '[]\n') |
    jq -r '
      (.data? // .notifications? // .) as $root
      | if ($root | type) == "array" then $root[] else empty end
      | [
          (.id | tostring),
          (.app_name // .["app-name"] // .appName // .application // "notification"),
          (.summary // ""),
          (.body // "")
        ]
      | @tsv
    ' |
    while IFS=$'\t' read -r id app summary body; do
      if [[ -n $summary && -n $body ]]; then
        label="$summary: $body"
      elif [[ -n $summary ]]; then
        label=$summary
      elif [[ -n $body ]]; then
        label=$body
      else
        label=$app
      fi

      printf '%s\t%s\n' "$id" "$label"
    done
}

mapfile -t entries < <(notification_entries)
((${#entries[@]})) || exit 0

choice=$(printf '%s\n' "${entries[@]#*$'\t'}" | fuzzel --dmenu --width 100 --prompt "$prompt") || exit 0
[[ -n $choice ]] || exit 0

for entry in "${entries[@]}"; do
  id=${entry%%$'\t'*}
  label=${entry#*$'\t'}
  if [[ $label == "$choice" ]]; then
    ~/.local/bin/mako-invoke-or-dismiss "$id"
    break
  fi
done
