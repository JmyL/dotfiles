#!/usr/bin/env bash
set -euo pipefail

# Shadow /usr/bin/wl-copy so Herdr clipboard writes can strip a shared
# leading indent (Cursor CLI paste often has 2 spaces on every line).
# Only transforms when the direct parent is herdr and the payload is text.

find_real_wl_copy() {
  local self path dir candidate
  self=$(readlink -f -- "$0")
  IFS=':' read -r -a path <<<"${PATH:-}"
  for dir in "${path[@]}"; do
    [[ -n "$dir" ]] || continue
    candidate="${dir}/wl-copy"
    if [[ -x "$candidate" && $(readlink -f -- "$candidate") != "$self" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  for candidate in /usr/bin/wl-copy /bin/wl-copy; do
    if [[ -x "$candidate" && $(readlink -f -- "$candidate") != "$self" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

# Only the direct parent: Herdr spawns wl-copy itself. Walking ancestors would
# also rewrite copies from shells/tools running inside a Herdr pane.
called_from_herdr() {
  local pid="${PPID:-}"
  local comm exe
  [[ -n "$pid" && "$pid" -gt 1 ]] || return 1
  if [[ -r "/proc/${pid}/comm" ]]; then
    comm=$(<"/proc/${pid}/comm")
    comm=${comm//$'\n'/}
    if [[ "$comm" == "herdr" ]]; then
      return 0
    fi
  fi
  if exe=$(readlink -f -- "/proc/${pid}/exe" 2>/dev/null); then
    if [[ "$(basename -- "$exe")" == "herdr" ]]; then
      return 0
    fi
  fi
  return 1
}

is_text_mime() {
  local mime="$1"
  [[ -z "$mime" || "$mime" == text/* ]]
}

# If first line has N leading spaces and every non-empty line has at least N,
# strip exactly N spaces from each non-empty line. Empty lines unchanged.
dedent_by_first_line() {
  python3 -c '
import sys

data = sys.stdin.buffer.read()
try:
    text = data.decode("utf-8")
except UnicodeDecodeError:
    sys.stdout.buffer.write(data)
    raise SystemExit(0)

lines = text.split("\n")
if not lines:
    sys.stdout.buffer.write(data)
    raise SystemExit(0)

first = lines[0]
n = 0
for ch in first:
    if ch == " ":
        n += 1
    else:
        break

if n == 0:
    sys.stdout.buffer.write(data)
    raise SystemExit(0)

prefix = " " * n
for line in lines:
    if line == "":
        continue
    if not line.startswith(prefix):
        sys.stdout.buffer.write(data)
        raise SystemExit(0)

out_lines = [line if line == "" else line[n:] for line in lines]
sys.stdout.buffer.write("\n".join(out_lines).encode("utf-8"))
'
}

real=$(find_real_wl_copy) || {
  echo "wl-copy: real wl-copy not found on PATH" >&2
  exit 127
}

for arg in "$@"; do
  case "$arg" in
  -h | --help | -v | --version | -c | --clear)
    exec "$real" "$@"
    ;;
  esac
done

mime=""
option_args=()
positional=()
args=("$@")
i=0
while ((i < ${#args[@]})); do
  arg="${args[i]}"
  case "$arg" in
  -t | --type)
    ((i + 1 < ${#args[@]})) || exec "$real" "$@"
    mime="${args[i + 1]}"
    option_args+=("$arg" "$mime")
    i=$((i + 2))
    ;;
  --type=*)
    mime="${arg#--type=}"
    option_args+=("$arg")
    i=$((i + 1))
    ;;
  --)
    i=$((i + 1))
    while ((i < ${#args[@]})); do
      positional+=("${args[i]}")
      i=$((i + 1))
    done
    ;;
  -*)
    option_args+=("$arg")
    i=$((i + 1))
    ;;
  *)
    positional+=("$arg")
    i=$((i + 1))
    ;;
  esac
done

if ! called_from_herdr || ! is_text_mime "$mime"; then
  exec "$real" "$@"
fi

if ((${#positional[@]} > 0)); then
  payload="${positional[*]}"
  printf '%s' "$payload" | dedent_by_first_line | "$real" "${option_args[@]}"
  exit $?
fi

dedent_by_first_line | "$real" "$@"
exit $?
