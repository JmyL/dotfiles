#!/usr/bin/env bash
set -euo pipefail

APP_NAME="$(basename "$0")"

msg() {
  printf '%s\n' "$*"
}

die() {
  printf '%s: %s\n' "$APP_NAME" "$*" >&2
  exit 1
}

notify() {
  local title="$1"
  local body="${2:-}"
  herdr notification show "$title" --body "$body" >/dev/null 2>&1 || true
}

pause_on_failure() {
  # Keep popup visible briefly so failures are readable.
  sleep 4
}

require_cmd() {
  local name="$1"
  command -v "$name" >/dev/null 2>&1 || die "missing command: ${name}"
}

require_cmd herdr
require_cmd git
require_cmd python3

workspace_id="${HERDR_WORKSPACE_ID:-}"
if [[ -z "$workspace_id" ]]; then
  workspace_id="$(
    herdr workspace list |
      python3 -c 'import json,sys; ws=((json.load(sys.stdin).get("result") or {}).get("workspaces") or []); f=[w for w in ws if w.get("focused")]; print((f[0] if f else {}).get("workspace_id",""))'
  )"
fi
if [[ -z "$workspace_id" ]]; then
  notify "Worktree remove failed" "Cannot resolve current workspace ID."
  die "cannot resolve current workspace ID"
fi

workspace_json="$(herdr workspace get "$workspace_id")" || die "failed to read workspace"
readarray -t worktree_fields < <(
  WORKSPACE_JSON="$workspace_json" python3 - <<'PY'
import json
import os
payload = json.loads(os.environ["WORKSPACE_JSON"])
workspace = ((payload.get("result") or {}).get("workspace") or {})
worktree = workspace.get("worktree") or {}
label = workspace.get("label") or ""
checkout_path = worktree.get("checkout_path") or ""
repo_root = worktree.get("repo_root") or ""
is_linked = bool(worktree.get("is_linked_worktree"))
print(checkout_path)
print(repo_root)
print("1" if is_linked else "0")
print(label)
PY
)

checkout_path="${worktree_fields[0]:-}"
repo_root="${worktree_fields[1]:-}"
is_linked="${worktree_fields[2]:-0}"
workspace_label="${worktree_fields[3]:-}"

if [[ "$is_linked" != "1" || -z "$checkout_path" || -z "$repo_root" ]]; then
  notify "Worktree remove skipped" "Current workspace is not a linked worktree: ${workspace_label}"
  msg "ERROR: current workspace is not a linked worktree: ${workspace_label}"
  pause_on_failure
  exit 1
fi

branch="$(git -C "$checkout_path" branch --show-current 2>/dev/null || true)"
if [[ -z "$branch" ]]; then
  branch="(detached)"
fi

dirty_count="$(git -C "$checkout_path" status --porcelain --ignore-submodules=none | wc -l | tr -d ' ')"
msg "Target: ${checkout_path}"
msg "Branch: ${branch}"
if [[ "$dirty_count" != "0" ]]; then
  msg "Warning: worktree has ${dirty_count} local change(s)."
fi

set +e
remove_output="$(herdr worktree remove --workspace "$workspace_id" 2>&1)"
remove_rc=$?
set -e

if [[ "$remove_rc" -eq 0 ]]; then
  msg "removed"
  exit 0
fi

if [[ "$remove_output" == *"working trees containing submodules cannot be moved or removed"* ]]; then
  msg "Submodule blocker detected; trying forced remove."
  if [[ "$dirty_count" != "0" ]]; then
    msg "ERROR: refusing auto --force because local changes exist."
    pause_on_failure
    exit 1
  fi
  if ! force_output="$(herdr worktree remove --workspace "$workspace_id" --force 2>&1)"; then
    printf '%s\n' "$force_output" >&2
    pause_on_failure
    exit 1
  fi
  msg "removed with --force"
  exit 0
fi

printf '%s\n' "$remove_output" >&2
pause_on_failure
exit "$remove_rc"
