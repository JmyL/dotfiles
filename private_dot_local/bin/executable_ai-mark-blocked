#!/usr/bin/env bash
# PermissionRequest hook: marks this pane as blocked and notifies if unseen.
set -uo pipefail

agent="${1:-ai}"
payload="$(cat)"

source "$HOME/.local/bin/ai-attention-common"
ai_attention_locate
[[ -n "$target" ]] || exit 0

if (( looking_at_it )); then
  if (( has_tmux_target )); then
    dev-launcher tmux set-option -p -u -t "$tmux_target" @ai_state
  fi
  ai_runtime_state_write idle "$agent" "$target" "$PWD" ""
  exit 0
fi

if (( has_tmux_target )); then
  dev-launcher tmux set-option -p -t "$tmux_target" @ai_cli 1
  dev-launcher tmux set-option -p -t "$tmux_target" @ai_state blocked
fi

info_json="$(AI_AGENT="$agent" python3 -c '
import json, os, sys
payload = json.load(sys.stdin) if not sys.stdin.isatty() else {}
agent = os.environ.get("AI_AGENT", "AI")
cwd = payload.get("cwd") or payload.get("working_directory") or ""
message = (
    payload.get("message")
    or payload.get("reason")
    or payload.get("approval_reason")
    or payload.get("prompt")
    or f"{agent.title()} needs your input"
)
if isinstance(message, (dict, list)):
    message = json.dumps(message, ensure_ascii=False)
folder = os.path.basename(cwd.rstrip("/")) if cwd else ""
print(json.dumps({"folder": folder, "message": str(message)}))
' <<<"$payload" 2>/dev/null)"
folder="$(jq -r '.folder // empty' <<<"$info_json" 2>/dev/null)"
message="$(jq -r '.message // empty' <<<"$info_json" 2>/dev/null)"
title="${folder:-$sname}"
message="${message:-${agent^} needs your input}"
ai_runtime_state_write blocked "$agent" "$target" "$PWD" "$message"

# PermissionRequest also fires for auto-review/policy checks that do not require
# user input. Keep the tmux blocked marker, but notify only when the request is
# routed to the user, or when the reviewer cannot be determined.
should_notify_permission_request() {
  case "${AI_NOTIFY_PERMISSION_REQUEST:-auto}" in
    1|true|TRUE|yes|YES|on|ON) return 0 ;;
    0|false|FALSE|no|NO|off|OFF) return 1 ;;
  esac

  printf '%s' "$payload" | python3 -c '
import json
import os
import sys

try:
    payload = json.load(sys.stdin)
except Exception:
    payload = {}

reviewer_keys = {"approvals_reviewer", "approval_reviewer", "reviewer"}
user_required_keys = {
    "needs_user_input",
    "requires_user_input",
    "user_input_required",
    "needs_user_approval",
    "requires_user_approval",
    "user_approval_required",
}

def walk(obj):
    if isinstance(obj, dict):
        for key, value in obj.items():
            yield str(key), value
            yield from walk(value)
    elif isinstance(obj, list):
        for value in obj:
            yield from walk(value)

def normalize_reviewer(value):
    return value.lower().replace("-", "_")

def find_reviewer(obj):
    for key, value in walk(obj):
        if key.lower() in reviewer_keys and isinstance(value, str):
            return normalize_reviewer(value)
    return ""

def has_user_required_flag(obj):
    for key, value in walk(obj):
        if key.lower() in user_required_keys and value is True:
            return True
    return False

def read_transcript_sample(path, limit=262144):
    try:
        with open(path, "rb") as handle:
            handle.seek(0, os.SEEK_END)
            size = handle.tell()
            handle.seek(0)
            head = handle.read(limit)
            if size <= limit * 2:
                tail = b""
            else:
                handle.seek(max(0, size - limit))
                tail = handle.read(limit)
            return (head + b"\n" + tail).decode("utf-8", "replace").splitlines()
    except Exception:
        return []

reviewer = find_reviewer(payload)
if not reviewer:
    transcript_path = payload.get("transcript_path")
    if isinstance(transcript_path, str) and transcript_path:
        for line in reversed(read_transcript_sample(transcript_path)):
            try:
                item = json.loads(line)
            except Exception:
                continue
            reviewer = find_reviewer(item)
            if reviewer:
                break

if reviewer == "auto_review":
    sys.exit(1)
if reviewer == "user" or has_user_required_flag(payload):
    sys.exit(0)

# Unknown reviewer: prefer notifying, because a missed human approval blocks work.
sys.exit(0)
' 2>/dev/null
}

should_notify_permission_request || exit 0

notify_key="$(printf '%s' "$payload" | TARGET="$target" AGENT="$agent" python3 -c '
import hashlib, json, os, re, sys
try:
    payload = json.load(sys.stdin)
except Exception:
    payload = {}
raw = "|".join([
    os.environ.get("AGENT", "ai"),
    os.environ.get("TARGET", ""),
    str(payload.get("turn_id") or payload.get("tool_use_id") or payload.get("session_id") or "unknown"),
])
print(re.sub(r"[^A-Za-z0-9_.-]", "_", hashlib.sha256(raw.encode()).hexdigest()[:24]))
' 2>/dev/null)"
state_dir="${XDG_RUNTIME_DIR:-/tmp}/ai-hook-notify"
state_file="$state_dir/blocked-${notify_key:-unknown}"
now="$(date +%s)"
mkdir -p "$state_dir" 2>/dev/null || true
if [[ -f "$state_file" ]]; then
  last="$(cat "$state_file" 2>/dev/null || printf 0)"
  if [[ "$last" =~ ^[0-9]+$ ]] && (( now - last < 60 )); then
    exit 0
  fi
fi
printf '%s\n' "$now" > "$state_file" 2>/dev/null || true

setsid -f ai-notify-and-goto "$agent" "$target" "$title" "$message"   < /dev/null > /dev/null 2>&1 &

exit 0
