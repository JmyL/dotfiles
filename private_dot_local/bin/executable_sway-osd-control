#!/usr/bin/env bash
set -euo pipefail

sound_enabled="${SWAY_OSD_SOUND:-1}"

play_sound() {
    local sound="${1:-}"

    if [[ "$sound_enabled" != 1 || -z "$sound" ]]; then
        return 0
    fi

    if command -v canberra-gtk-play >/dev/null 2>&1; then
        canberra-gtk-play -i "$sound" -d "sway-osd" >/dev/null 2>&1 &
    fi
}

show_message() {
    local message="${1:?missing message}"
    local icon="${2:-dialog-information-symbolic}"

    swayosd-client \
        --custom-message "$message" \
        --custom-icon "$icon" \
        --duration "${SWAY_OSD_MESSAGE_DURATION:-1800}"
}

show_brightness_failure() {
    play_sound "${SWAY_OSD_SOUND_BRIGHTNESS_FAILED:-dialog-error}"
    show_message \
        "${SWAY_OSD_NO_BRIGHTNESS_MESSAGE:-No brightness-adjustable display}" \
        "${SWAY_OSD_NO_BRIGHTNESS_ICON:-display-brightness-symbolic}"
}

backlight_outputs() {
    local backlight_dir="${SWAY_OSD_BACKLIGHT_DIR:-/sys/class/backlight}"
    local backlight_device
    local device_path
    local output

    [[ -d "$backlight_dir" ]] || return 0

    for backlight_device in "$backlight_dir"/*; do
        [[ -e "$backlight_device" ]] || continue

        device_path="$(readlink -f "$backlight_device" 2>/dev/null || true)"
        [[ -n "$device_path" ]] || continue

        output="$(basename "$(dirname "$device_path")")"
        [[ "$output" =~ ^card[0-9]+-.+ ]] || continue

        printf '%s\n' "${output#card[0-9]*-}"
    done
}

active_outputs() {
    swaymsg -t get_outputs | jq -r '.[] | select(.active == true) | .name'
}

has_active_backlight_output() {
    local active_output
    local backlight_output

    while IFS= read -r backlight_output; do
        [[ -n "$backlight_output" ]] || continue

        while IFS= read -r active_output; do
            [[ "$active_output" == "$backlight_output" ]] && return 0
        done < <(active_outputs)
    done < <(backlight_outputs)

    return 1
}

case "${1:-}" in
    output-volume)
        swayosd-client --output-volume "${2:?missing output-volume action}"
        case "${2:-}" in
            mute-toggle|mute|unmute)
                play_sound "${SWAY_OSD_SOUND_VOLUME_MUTE:-audio-volume-change}"
                ;;
            *)
                play_sound "${SWAY_OSD_SOUND_VOLUME:-audio-volume-change}"
                ;;
        esac
        ;;
    input-volume)
        swayosd-client --input-volume "${2:?missing input-volume action}"
        play_sound "${SWAY_OSD_SOUND_MIC:-audio-volume-change}"
        ;;
    brightness)
        brightness_action="${2:?missing brightness action}"

        if ! has_active_backlight_output; then
            show_brightness_failure
            exit 0
        fi

        if swayosd-client --brightness "$brightness_action"; then
            play_sound "${SWAY_OSD_SOUND_BRIGHTNESS:-bell}"
        else
            show_brightness_failure
        fi
        ;;
    *)
        echo "Usage: $0 {output-volume|input-volume|brightness} ACTION" >&2
        exit 2
        ;;
esac
