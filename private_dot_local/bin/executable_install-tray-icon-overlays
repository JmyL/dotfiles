#!/usr/bin/env bash
# Install monochrome Waybar tray icon overlays under ~/.local/share/icons.
# Blueman: bluetooth rune (muted / accent / disabled).
# Fcitx: "한" (white on dark, bar-text on light) and Latin "A" (muted).
# After rewriting glyphs, bounce the current IM so Waybar's SNI reloads the icon.
set -euo pipefail

icons_root="${XDG_DATA_HOME:-$HOME/.local/share}/icons"
muted='#aeb4ba'
active='#72b7f2'
han_light='#4c4f69'
han_dark='#ffffff'
darkman_cmd=${DARKMAN:-darkman}

han_fill=${TRAY_HAN_FILL:-}
if [[ -z $han_fill ]]; then
  mode=
  if command -v "$darkman_cmd" >/dev/null 2>&1; then
    mode=$("$darkman_cmd" get 2>/dev/null || true)
  fi
  case $mode in
  light) han_fill=$han_light ;;
  *) han_fill=$han_dark ;;
  esac
fi

# Adwaita bluetooth-active / bluetooth-disabled path data (16x16).
bt_path='m 7.585938 0.0898438 c -0.355469 0.1640622 -0.585938 0.5195312 -0.585938 0.9101562 v 5.296875 l -2.34375 -2.046875 c -0.414062 -0.363281 -1.042969 -0.324219 -1.40625 0.089844 c -0.363281 0.417968 -0.324219 1.046875 0.09375 1.410156 l 2.566406 2.25 l -2.566406 2.25 c -0.417969 0.363281 -0.457031 0.992188 -0.09375 1.40625 c 0.363281 0.417969 0.992188 0.457031 1.40625 0.09375 l 2.34375 -2.046875 v 5.296875 c 0 0.390625 0.230469 0.746094 0.585938 0.910156 c 0.359374 0.160156 0.777343 0.101563 1.070312 -0.160156 l 4 -3.5 c 0.21875 -0.1875 0.34375 -0.460938 0.34375 -0.75 s -0.125 -0.5625 -0.34375 -0.75 l -3.140625 -2.75 l 3.140625 -2.75 c 0.21875 -0.1875 0.34375 -0.460938 0.34375 -0.75 s -0.125 -0.5625 -0.34375 -0.75 l -4 -3.5 c -0.292969 -0.2617188 -0.710938 -0.3242188 -1.070312 -0.1601562 z m 1.414062 3.1132812 l 1.484375 1.296875 l -1.484375 1.296875 z m 0 7 l 1.484375 1.296875 l -1.484375 1.296875 z m 0 0'
bt_disabled_path='m 7.957031 0 c -0.128906 0.0078125 -0.253906 0.0390625 -0.371093 0.0898438 c -0.355469 0.1640622 -0.585938 0.5195312 -0.585938 0.9101562 v 4.9375 l -5.46875 -5.46875 l -1.0625 1.0625 l 14 14 l 1.0625 -1.0625 l -2.605469 -2.605469 c 0.15625 -0.390625 0.046875 -0.835937 -0.269531 -1.113281 l -3.136719 -2.75 l 3.136719 -2.75 c 0.21875 -0.1875 0.34375 -0.460938 0.34375 -0.75 s -0.125 -0.5625 -0.34375 -0.75 l -4 -3.5 c -0.191406 -0.171875 -0.445312 -0.2578125 -0.699219 -0.25 z m 1.042969 3.203125 l 1.480469 1.296875 l -1.480469 1.296875 z m -3.609375 5.25 l -2.046875 1.796875 c -0.417969 0.363281 -0.457031 0.992188 -0.09375 1.40625 c 0.363281 0.417969 0.992188 0.457031 1.40625 0.09375 l 2.152344 -1.878906 z m 1.609375 1.609375 v 4.9375 c 0 0.390625 0.230469 0.746094 0.585938 0.910156 c 0.359374 0.160156 0.777343 0.101563 1.070312 -0.160156 l 2.152344 -1.878906 l -1.414063 -1.414063 l -0.394531 0.339844 v -0.734375 z m 0 0'

# Glyph outlines (not <text>) so Waybar/GTK tray rendering does not depend on CJK fonts.
han_path='M 5.59375 4.671875 C 3.640625 4.671875 2.25 5.734375 2.25 7.28125 C 2.25 8.84375 3.640625 9.90625 5.59375 9.90625 C 7.546875 9.90625 8.9375 8.84375 8.9375 7.28125 C 8.9375 5.734375 7.546875 4.671875 5.59375 4.671875 Z M 5.59375 6.15625 C 6.453125 6.15625 7.0625 6.546875 7.0625 7.28125 C 7.0625 8.03125 6.453125 8.421875 5.59375 8.421875 C 4.734375 8.421875 4.125 8.03125 4.125 7.28125 C 4.125 6.546875 4.734375 6.15625 5.59375 6.15625 Z M 10.328125 1.234375 L 10.328125 11.390625 L 12.28125 11.390625 L 12.28125 6.984375 L 14.09375 6.984375 L 14.09375 5.375 L 12.28125 5.375 L 12.28125 1.234375 Z M 4.625 1.21875 L 4.625 2.65625 L 1.59375 2.65625 L 1.59375 4.1875 L 9.578125 4.1875 L 9.578125 2.65625 L 6.5625 2.65625 L 6.5625 1.21875 Z M 3.53125 10.625 L 3.53125 14.59375 L 12.765625 14.59375 L 12.765625 13.015625 L 5.484375 13.015625 L 5.484375 10.625 Z'
a_path='M 10.4375 13.601562 L 9.59375 10.882812 L 5.4375 10.882812 L 4.609375 13.601562 L 2 13.601562 L 6.03125 2.132812 L 8.984375 2.132812 L 13.046875 13.601562 Z M 8.1875 6.195312 C 8.132812 6.007812 8.066406 5.78125 7.984375 5.507812 C 7.898438 5.226562 7.8125 4.945312 7.71875 4.664062 C 7.632812 4.375 7.566406 4.117188 7.515625 3.898438 C 7.460938 4.117188 7.390625 4.382812 7.296875 4.695312 C 7.210938 5.007812 7.128906 5.3125 7.046875 5.601562 C 6.960938 5.882812 6.898438 6.082031 6.859375 6.195312 L 6.046875 8.851562 L 9.03125 8.851562 Z'

sizes=(16x16 22x22 24x24 32x32 48x48)
themes=(hicolor Yaru Yaru-dark)

write_bt() {
  local dest=$1 fill=$2 path=$3 scale=${4:-1}
  local body
  mkdir -p "$(dirname "$dest")"
  if [[ $scale == 1 ]]; then
    body="  <path fill=\"$fill\" d=\"$path\"/>"
  else
    # Scale about the 16x16 center so tray padding matches neighboring icons.
    body="  <g transform=\"translate(8 8) scale($scale) translate(-8 -8)\">
    <path fill=\"$fill\" d=\"$path\"/>
  </g>"
  fi
  cat >"$dest" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16">
$body
</svg>
EOF
}

link_sizes() {
  local theme=$1 rel=$2
  local src="$icons_root/$theme/scalable/$rel"
  local sz dest
  for sz in "${sizes[@]}"; do
    dest="$icons_root/$theme/$sz/$rel"
    mkdir -p "$(dirname "$dest")"
    # From <theme>/<size>/<context>/file → ../../scalable/<context>/file
    ln -sfn "../../scalable/$rel" "$dest"
  done
}

write_index_theme() {
  local theme=$1 inherits=$2
  local dest="$icons_root/$theme/index.theme"
  local dirs=()
  local sz ctx size typ cname

  mkdir -p "$icons_root/$theme"
  for sz in scalable "${sizes[@]}"; do
    for ctx in status devices apps; do
      dirs+=("$sz/$ctx")
    done
  done

  {
    printf '%s\n' '[Icon Theme]'
    printf 'Name=%s\n' "$theme"
    printf 'Comment=User tray icon overlays for %s\n' "$theme"
    printf 'Inherits=%s\n' "$inherits"
    printf 'Directories=%s\n' "$(IFS=,; echo "${dirs[*]}")"
    printf '\n'
    for sz in scalable "${sizes[@]}"; do
      if [[ $sz == scalable ]]; then
        size=16
        typ=Scalable
      else
        size=${sz%x*}
        typ=Fixed
      fi
      for ctx in status devices apps; do
        case $ctx in
        status) cname=Status ;;
        devices) cname=Devices ;;
        apps) cname=Applications ;;
        esac
        printf '[%s/%s]\n' "$sz" "$ctx"
        printf 'Context=%s\n' "$cname"
        printf 'Size=%s\n' "$size"
        if [[ $typ == Scalable ]]; then
          printf '%s\n' 'Type=Scalable' 'MinSize=8' 'MaxSize=512'
        else
          printf '%s\n' 'Type=Fixed'
        fi
        printf '\n'
      done
    done
  } >"$dest"
}

install_bluetooth() {
  local theme=$1
  local base="$icons_root/$theme/scalable/status"
  local bt_scale=0.9
  write_bt "$base/blueman-tray.svg" "$muted" "$bt_path" "$bt_scale"
  write_bt "$base/blueman-active.svg" "$active" "$bt_path" "$bt_scale"
  write_bt "$base/blueman-disabled.svg" "$muted" "$bt_disabled_path" "$bt_scale"
  write_bt "$base/blueman.svg" "$muted" "$bt_path" "$bt_scale"
  link_sizes "$theme" status/blueman-tray.svg
  link_sizes "$theme" status/blueman-active.svg
  link_sizes "$theme" status/blueman-disabled.svg
  link_sizes "$theme" status/blueman.svg
}

install_keyboard_a() {
  local theme=$1
  write_bt "$icons_root/$theme/scalable/devices/input-keyboard-symbolic.svg" "$muted" "$a_path"
  write_bt "$icons_root/$theme/scalable/devices/input-keyboard.svg" "$muted" "$a_path"
  write_bt "$icons_root/$theme/scalable/apps/input-keyboard-symbolic.svg" "$muted" "$a_path"
  write_bt "$icons_root/$theme/scalable/apps/input-keyboard.svg" "$muted" "$a_path"
  link_sizes "$theme" devices/input-keyboard-symbolic.svg
  link_sizes "$theme" devices/input-keyboard.svg
  link_sizes "$theme" apps/input-keyboard-symbolic.svg
  link_sizes "$theme" apps/input-keyboard.svg
}

install_fcitx_hangul() {
  local theme=hicolor
  write_bt "$icons_root/$theme/scalable/apps/fcitx-hangul.svg" "$han_fill" "$han_path"
  write_bt "$icons_root/$theme/scalable/apps/org.fcitx.Fcitx5.fcitx-hangul.svg" "$han_fill" "$han_path"
  link_sizes "$theme" apps/fcitx-hangul.svg
  link_sizes "$theme" apps/org.fcitx.Fcitx5.fcitx-hangul.svg
}

for theme in "${themes[@]}"; do
  install_bluetooth "$theme"
  install_keyboard_a "$theme"
done
install_fcitx_hangul

write_index_theme Yaru hicolor
write_index_theme Yaru-dark 'Yaru,hicolor'

if command -v gtk-update-icon-cache >/dev/null 2>&1; then
  gtk-update-icon-cache -f "$icons_root/hicolor" >/dev/null 2>&1 || true
  gtk-update-icon-cache -f "$icons_root/Yaru" >/dev/null 2>&1 || true
  gtk-update-icon-cache -f "$icons_root/Yaru-dark" >/dev/null 2>&1 || true
fi

# StatusNotifier only emits NewIcon when the icon *name* changes, so rewriting
# the SVG is not enough. Switching away and back forces Waybar to look it up again.
pick_other_im() {
  local current=$1 name
  if [[ -n ${FCITX_TRAY_OTHER_IM:-} ]]; then
    printf '%s\n' "$FCITX_TRAY_OTHER_IM"
    return 0
  fi
  local group info
  group=$(gdbus call --session --dest org.fcitx.Fcitx5 --object-path /controller \
    --method org.fcitx.Fcitx.Controller1.CurrentInputMethodGroup 2>/dev/null || true)
  group=${group#*\'}
  group=${group%%\'*}
  if [[ -n $group ]]; then
    info=$(gdbus call --session --dest org.fcitx.Fcitx5 --object-path /controller \
      --method org.fcitx.Fcitx.Controller1.InputMethodGroupInfo "$group" 2>/dev/null || true)
    while read -r name; do
      if [[ -n $name && $name != "$current" ]]; then
        printf '%s\n' "$name"
        return 0
      fi
    done < <(printf '%s\n' "$info" | sed 's/.*\[//;s/\].*//' | grep -oE "'[^']*'" | tr -d "'" | awk 'NR%2==1' || true)
  fi
  case $current in
  hangul) printf '%s\n' keyboard-eu ;;
  *) printf '%s\n' hangul ;;
  esac
}

refresh_fcitx_tray() {
  [[ ${TRAY_REFRESH_FCITX:-1} == 1 ]] || return 0
  local remote=${FCITX5_REMOTE:-fcitx5-remote}
  command -v "$remote" >/dev/null 2>&1 || return 0
  "$remote" --check >/dev/null 2>&1 || return 0
  local im other
  im=$("$remote" -n 2>/dev/null || true)
  [[ -n $im ]] || return 0
  other=$(pick_other_im "$im")
  [[ -n $other && $other != "$im" ]] || return 0
  "$remote" -s "$other" >/dev/null 2>&1 || return 0
  "$remote" -s "$im" >/dev/null 2>&1 || true
}

refresh_fcitx_tray

printf 'Installed tray icon overlays under %s\n' "$icons_root"
