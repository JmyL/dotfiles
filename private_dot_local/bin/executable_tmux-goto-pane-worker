#!/usr/bin/env bash
set -uo pipefail

input_target="${1:?usage: tmux-goto-pane-worker SESSION_ID:WINDOW.PANE|PANE_ID}"

if ! target="$(tmux display-message -p -t "$input_target" '#{session_id}:#{window_index}.#{pane_index}' 2>/dev/null)"; then
  exit 1
fi

sid="${target%%:*}"
rest="${target#*:}"
widx="${rest%%.*}"
pidx="${rest#*.}"

if ! tmux has-session -t "$sid" 2>/dev/null; then
  exit 2
fi

sname="$(tmux display-message -p -t "$sid" '#{session_name}')"

window_ok=0
pane_ok=0
if tmux list-windows -t "$sid" -F '#{window_index}' 2>/dev/null | grep -qx "$widx"; then
  window_ok=1
  if tmux list-panes -t "$sid:$widx" -F '#{pane_index}' 2>/dev/null | grep -qx "$pidx"; then
    pane_ok=1
  fi
fi

focus_target() {
  local tty="$1" switched_sid="" client_pid=""

  if should_skip_tty "$tty"; then
    return 1
  fi

  tmux switch-client -c "$tty" -t "$sid" 2>/dev/null || return 1

  IFS=$'\t' read -r switched_sid client_pid < <(
    tmux list-clients -F '#{client_tty}	#{session_id}	#{client_pid}' 2>/dev/null |
      awk -F '\t' -v tty="$tty" '$1 == tty { print $2 "\t" $3; exit }'
  )
  if [[ "$switched_sid" != "$sid" ]]; then
    return 1
  fi
  if should_skip_client_pid "$client_pid"; then
    return 1
  fi
  if ! matches_target_sway_con "$client_pid"; then
    return 1
  fi

  (( window_ok )) && tmux select-window -t "$sid:$widx" 2>/dev/null || true
  (( pane_ok )) && tmux select-pane -t "$sid:$widx.$pidx" 2>/dev/null || true
  printf '%s\t%s\n' "$tty" "$client_pid"
  return 0
}

matches_target_sway_con() {
  local client_pid="$1" expected_con="${TMUX_GOTO_PANE_TARGET_SWAY_CON:-}" actual_con=""

  [[ -n "$expected_con" ]] || return 0
  [[ -n "$client_pid" ]] || return 1
  actual_con="$(sway-process-window "$client_pid" 2>/dev/null || true)"
  [[ "$actual_con" == "$expected_con" ]]
}

should_skip_tty() {
  local tty="$1" tty_norm skip skip_norm

  tty_norm="${tty#/dev/}"
  IFS=: read -r -a skip_ttys <<< "${TMUX_GOTO_PANE_SKIP_TTYS:-}"
  for skip in "${skip_ttys[@]}"; do
    [[ -n "$skip" ]] || continue
    skip_norm="${skip#/dev/}"
    [[ "$tty_norm" == "$skip_norm" ]] && return 0
  done
  return 1
}

should_skip_client_pid() {
  local client_pid="$1" skip

  [[ -n "$client_pid" ]] || return 1
  IFS=: read -r -a skip_client_pids <<< "${TMUX_GOTO_PANE_SKIP_CLIENT_PIDS:-}"
  for skip in "${skip_client_pids[@]}"; do
    [[ -n "$skip" ]] || continue
    [[ "$client_pid" == "$skip" ]] && return 0
  done
  return 1
}

current_tty="$(tmux display-message -p '#{client_tty}' 2>/dev/null || true)"
clients="$(
  {
    [[ -n "$current_tty" ]] && printf '9999999999 %s\n' "$current_tty"
    tmux list-clients -t "$sid" -F '#{client_activity} #{client_tty}' 2>/dev/null || true
  } | sort -rn | awk '!seen[$2]++'
)"

if [[ -n "$clients" ]]; then
  while IFS= read -r line; do
    tty="${line#* }"
    [[ -n "$tty" ]] || continue
    if focus_target "$tty"; then
      exit 0
    fi
  done <<< "$clients"
fi

all_clients="$(tmux list-clients -F '#{client_activity} #{client_tty}' 2>/dev/null | sort -rn || true)"
if [[ -n "$all_clients" ]]; then
  while IFS= read -r line; do
    tty="${line#* }"
    [[ -n "$tty" ]] || continue
    if focus_target "$tty"; then
      exit 0
    fi
  done <<< "$all_clients"
fi

if command -v kitty >/dev/null 2>&1; then
  setsid kitty -e dev-launcher sesh connect "$sname" < /dev/null > /dev/null 2>&1 &
fi

for _ in $(seq 1 50); do
  clients="$(tmux list-clients -t "$sid" -F '#{client_activity} #{client_tty}' 2>/dev/null | sort -rn || true)"
  if [[ -n "$clients" ]]; then
    while IFS= read -r line; do
      tty="${line#* }"
      [[ -n "$tty" ]] || continue
      if focus_target "$tty"; then
        exit 0
      fi
    done <<< "$clients"
  fi
  sleep 0.1
done

exit 0
