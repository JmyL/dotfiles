#!/bin/sh
set -eu

recording_dir="${XDG_VIDEOS_DIR:-$HOME/Videos}/Recordings"
pid_file="${XDG_RUNTIME_DIR:-/tmp}/wf-recorder.pid"
log_file="${XDG_RUNTIME_DIR:-/tmp}/wf-recorder.log"
mkdir -p "$recording_dir"

recording_active() {
    [ -s "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null
}

stop_recording() {
    if recording_active; then
        pid=$(cat "$pid_file")
        kill -INT "$pid"
        rm -f "$pid_file"
        return 0
    fi
    rm -f "$pid_file"
    command -v notify-send >/dev/null 2>&1 && notify-send "No active screen recording" || true
}

start_recording() {
    if recording_active; then
        command -v notify-send >/dev/null 2>&1 && notify-send "Screen recording is already running" || true
        exit 1
    fi

    file="$recording_dir/recording-$(date +%Y%m%d-%H%M%S).mp4"

    case "${1:-}" in
        area)
            geometry=$(slurp) || exit 1
            wf-recorder -g "$geometry" -f "$file" &
            ;;
        full)
            output=$(swaymsg -t get_workspaces -r | jq -r '.[] | select(.focused).output') || output=
            if [ -z "$output" ] || [ "$output" = null ]; then
                command -v notify-send >/dev/null 2>&1 && notify-send -u critical "Screen recording failed" "Could not determine the focused output" || true
                exit 1
            fi
            wf-recorder -o "$output" -f "$file" >"$log_file" 2>&1 &
            ;;
        *)
            echo "Usage: $0 {area|full|stop}" >&2
            exit 2
            ;;
    esac

    echo $! > "$pid_file"
    sleep 0.2
    if ! kill -0 "$(cat "$pid_file")" 2>/dev/null; then
        rm -f "$pid_file" "$file"
        command -v notify-send >/dev/null 2>&1 && notify-send -u critical "Screen recording failed" "See $log_file" || true
        exit 1
    fi
}

recording_status() {
    if recording_active; then
        printf '● REC\n'
    fi
}

show_recording_menu() {
    if recording_active; then
        swaymsg mode 'Recording: [s]top'
    else
        swaymsg mode 'Recording: [a]rea [f]ull'
    fi
}

case "${1:-}" in
    area|full) start_recording "$1" ;;
    stop) stop_recording ;;
    status) recording_status ;;
    menu) show_recording_menu ;;
    *) echo "Usage: $0 {area|full|stop|status|menu}" >&2; exit 2 ;;
esac
