#!/bin/sh
set -eu

recording_dir="${XDG_VIDEOS_DIR:-$HOME/Videos}/Recordings"
pid_file="${XDG_RUNTIME_DIR:-/tmp}/wf-recorder.pid"
mkdir -p "$recording_dir"

stop_recording() {
    if [ -s "$pid_file" ]; then
        pid=$(cat "$pid_file")
        if kill -0 "$pid" 2>/dev/null; then
            kill -INT "$pid"
            rm -f "$pid_file"
            command -v swaync-client >/dev/null 2>&1 && swaync-client -t "Screen recording saved" || true
            return 0
        fi
    fi
    rm -f "$pid_file"
    command -v swaync-client >/dev/null 2>&1 && swaync-client -t "No active screen recording" || true
}

start_recording() {
    if [ -s "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then
        command -v swaync-client >/dev/null 2>&1 && swaync-client -t "Screen recording is already running" || true
        exit 1
    fi

    file="$recording_dir/recording-$(date +%Y%m%d-%H%M%S).mp4"

    case "${1:-}" in
        area)
            geometry=$(slurp) || exit 1
            wf-recorder -g "$geometry" -f "$file" &
            ;;
        full)
            wf-recorder -f "$file" &
            ;;
        *)
            echo "Usage: $0 {area|full|stop}" >&2
            exit 2
            ;;
    esac

    echo $! > "$pid_file"
    command -v swaync-client >/dev/null 2>&1 && swaync-client -t "Screen recording started" || true
}

case "${1:-}" in
    area|full) start_recording "$1" ;;
    stop) stop_recording ;;
    *) echo "Usage: $0 {area|full|stop}" >&2; exit 2 ;;
esac
