#!/usr/bin/env bash
# Stop hook: marks this pane as done and notifies if unseen.
set -uo pipefail

agent="${1:-ai}"
payload="$(cat)"

# Stop fires when Codex accepts a turn as complete. If a Stop hook has already
# forced a continuation, or there is no assistant message to summarize, avoid a
# misleading desktop notification.
if printf '%s' "$payload" | python3 -c '
import json, sys
try:
    payload = json.load(sys.stdin)
except Exception:
    sys.exit(1)
if payload.get("stop_hook_active") is True:
    sys.exit(0)
msg = payload.get("last_assistant_message")
if not isinstance(msg, str) or not msg.strip():
    sys.exit(0)
sys.exit(1)
' >/dev/null 2>&1
then
  exit 0
fi

source "$HOME/.local/bin/ai-attention-common"
ai_attention_locate
[[ -n "$target" ]] || exit 0

if (( looking_at_it )); then
  ai-state-daemon report-state --source hook --state idle --agent "$agent" --target "$target" --cwd "$PWD" >/dev/null 2>&1 || true
  exit 0
fi

if (( has_tmux_target )); then
  dev-launcher tmux set-option -p -t "$tmux_target" @ai_cli 1
fi

folder=""
summary=""
IFS=$'\t' read -r folder summary < <(AI_AGENT="$agent" python3 -c '
import json, os, sys
try:
    payload = json.load(sys.stdin)
except Exception:
    payload = {}
agent = os.environ.get("AI_AGENT", "AI")
cwd = payload.get("cwd") or payload.get("working_directory") or ""
summary = (
    payload.get("last_assistant_message")
    or payload.get("response")
    or payload.get("message")
    or payload.get("summary")
    or f"{agent.title()} completed"
)
if isinstance(summary, (dict, list)):
    summary = json.dumps(summary, ensure_ascii=False)
summary = " ".join(str(summary).split())
if len(summary) > 140:
    summary = summary[:137] + "..."
folder = os.path.basename(cwd.rstrip("/")) if cwd else ""
print(f"{folder}\t{summary}")
' <<<"$payload" 2>/dev/null)
title="${folder:-$sname}"
body="${summary:-${agent^} completed}"
if [[ "$agent" == "codex" ]]; then
  session_id="$(printf '%s' "$payload" | ai_codex_session_id_from_payload)"
  ai-state-daemon report-state --source hook --state done --agent "$agent" --target "$target" --cwd "$PWD" --session-id "$session_id" --message "$body" >/dev/null 2>&1 || true
else
  ai-state-daemon report-state --source hook --state done --agent "$agent" --target "$target" --cwd "$PWD" --message "$body" >/dev/null 2>&1 || true
fi

exit 0
