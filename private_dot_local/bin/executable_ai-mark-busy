#!/usr/bin/env bash
# UserPromptSubmit hook: marks this pane as busy (working on a turn).
set -uo pipefail

agent="${1:-ai}"
payload="$(cat)"

source "$HOME/.local/bin/ai-attention-common"
ai_attention_locate
if [[ -n "$target" ]]; then
  ai_runtime_state_write busy "$agent" "$target" "$PWD" ""
fi

[[ -n "${TMUX_PANE:-}" ]] || exit 0

dev-launcher tmux set-option -p -t "$TMUX_PANE" @ai_cli 1
dev-launcher tmux set-option -p -t "$TMUX_PANE" @ai_state busy

exit 0
