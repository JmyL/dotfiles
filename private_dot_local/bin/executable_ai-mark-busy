#!/usr/bin/env bash
# UserPromptSubmit hook: marks this pane as busy (working on a turn).
set -uo pipefail

agent="${1:-ai}"
payload="$(cat)"

source "$HOME/.local/bin/ai-attention-common"
ai_attention_locate
if [[ -n "$target" ]]; then
  if [[ "$agent" == "codex" ]]; then
    session_id="$(printf '%s' "$payload" | ai_codex_session_id_from_payload)"
    ai-state-daemon report-state --source hook --state busy --agent "$agent" --target "$target" --cwd "$PWD" --session-id "$session_id" >/dev/null 2>&1 || true
  else
    ai-state-daemon report-state --source hook --state busy --agent "$agent" --target "$target" --cwd "$PWD" >/dev/null 2>&1 || true
  fi
fi

[[ -n "${TMUX_PANE:-}" ]] || exit 0

dev-launcher tmux set-option -p -t "$TMUX_PANE" @ai_cli 1

exit 0
