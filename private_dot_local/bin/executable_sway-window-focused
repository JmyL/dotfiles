#!/usr/bin/env python3
"""Exit 0 if the given Sway window/container id is focused."""
import json
import os
import shutil
import subprocess
import sys


def running_in_container():
    return os.path.exists("/run/.containerenv")


def reexec_on_host():
    if not running_in_container() or os.environ.get("SWAY_WINDOW_FOCUSED_HOST_ENTRY"):
        return
    if not shutil.which("flatpak-spawn"):
        return
    env = os.environ.copy()
    env["SWAY_WINDOW_FOCUSED_HOST_ENTRY"] = "1"
    os.execvpe(
        "flatpak-spawn",
        ["flatpak-spawn", "--host", "sway-window-focused", *sys.argv[1:]],
        env,
    )


def main():
    reexec_on_host()
    if len(sys.argv) != 2:
        sys.exit(2)
    target = sys.argv[1]

    try:
        tree = json.loads(subprocess.check_output(["swaymsg", "-t", "get_tree"], text=True))
    except Exception:
        sys.exit(1)

    stack = [tree]
    while stack:
        node = stack.pop()
        if not isinstance(node, dict):
            continue
        if str(node.get("id")) == target:
            sys.exit(0 if node.get("focused") else 1)
        stack.extend(node.get("nodes", []))
        stack.extend(node.get("floating_nodes", []))
    sys.exit(1)


if __name__ == "__main__":
    main()
