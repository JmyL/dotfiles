#!/usr/bin/env python3
"""Print upcoming calendar alerts for Waybar or tmux.

The script reads khal's local cache and reports the first event starting within
30 minutes. It intentionally does not run vdirsyncer; synchronization is handled
by the user timer.
"""

from __future__ import annotations

import argparse
import json
import subprocess
from datetime import datetime, timedelta
from pathlib import Path


ALERT_WINDOW_MINUTES = 30
URGENT_WINDOW_MINUTES = 10
STATE_DIR = Path.home() / ".cache" / "calendar-alert"
NOTIFY_STATE_PATH = STATE_DIR / "last-notified"
WAYBAR_STATE_PATH = STATE_DIR / "waybar-state.css"
WAYBAR_URGENT_CSS = """window#waybar {
    background-color: rgba(255, 59, 72, 0.35);
}
"""


def khal_command() -> list[str]:
    if Path("/usr/bin/khal").exists():
        return ["/usr/bin/khal"]
    return ["/usr/bin/toolbox", "run", "--container", "f44", "khal"]


def khal_events() -> list[dict[str, str]]:
    cmd = [
        *khal_command(),
        "list",
        "now",
        f"{ALERT_WINDOW_MINUTES}m",
        "--notstarted",
        "--json",
        "title",
        "--json",
        "start-time",
        "--json",
        "calendar",
        "--json",
        "uid",
    ]
    result = subprocess.run(cmd, check=False, text=True, capture_output=True)
    if result.returncode != 0:
        return []

    events: list[dict[str, str]] = []
    for line in result.stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            value = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(value, list):
            for item in value:
                if isinstance(item, dict) and item.get("start-time"):
                    events.append(item)
    return events


def minutes_until(start_time: str) -> int | None:
    try:
        hour, minute = [int(part) for part in start_time.split(":", 1)]
    except ValueError:
        return None

    now = datetime.now()
    start = now.replace(hour=hour, minute=minute, second=0, microsecond=0)
    if start < now:
        start += timedelta(days=1)
    diff = round((start - now).total_seconds() / 60)
    if diff < 0 or diff > ALERT_WINDOW_MINUTES:
        return None
    return diff


def first_alert() -> tuple[int, dict[str, str]] | None:
    candidates: list[tuple[int, dict[str, str]]] = []
    for event in khal_events():
        minutes = minutes_until(event.get("start-time", ""))
        if minutes is not None:
            candidates.append((minutes, event))
    if not candidates:
        return None
    return sorted(candidates, key=lambda item: item[0])[0]


def notification_key(event: dict[str, str], start_time: str) -> str:
    uid = event.get("uid") or event.get("title") or "untitled"
    return f"{uid}\t{start_time}"


def maybe_notify(minutes: int, event: dict[str, str]) -> None:
    if minutes > URGENT_WINDOW_MINUTES:
        return

    title = event.get("title", "Untitled")
    calendar = event.get("calendar", "")
    start_time = event.get("start-time", "")
    key = notification_key(event, start_time)

    try:
        if NOTIFY_STATE_PATH.exists() and NOTIFY_STATE_PATH.read_text() == key:
            return
        NOTIFY_STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
        NOTIFY_STATE_PATH.write_text(key)
    except OSError:
        return

    subprocess.run([
        "/usr/bin/notify-send",
        "--app-name=calendar-alert",
        "--urgency=critical",
        "--icon=appointment-soon",
        f"{minutes}분 후 일정",
        f"{title}\n{start_time} · {calendar}",
    ], check=False)


def set_waybar_urgent_state(urgent: bool) -> None:
    css = WAYBAR_URGENT_CSS if urgent else ""
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        current = WAYBAR_STATE_PATH.read_text() if WAYBAR_STATE_PATH.exists() else ""
        if current == css:
            return
        WAYBAR_STATE_PATH.write_text(css)
    except OSError:
        return

    subprocess.run(["/usr/bin/pkill", "-SIGUSR2", "waybar"], check=False)


def waybar_output() -> None:
    alert = first_alert()
    if alert is None:
        set_waybar_urgent_state(False)
        return

    minutes, event = alert
    title = event.get("title", "Untitled")
    calendar = event.get("calendar", "")
    start_time = event.get("start-time", "")
    urgent = minutes <= URGENT_WINDOW_MINUTES
    set_waybar_urgent_state(urgent)
    maybe_notify(minutes, event)
    print(json.dumps({
        "text": f"󰃭 {minutes}m {title}",
        "tooltip": f"{title}\n{start_time} · {calendar}",
        "class": "urgent" if urgent else "soon",
    }, ensure_ascii=False))


def tmux_output() -> None:
    alert = first_alert()
    if alert is None:
        return
    minutes, event = alert
    print(f"󰃭 {minutes}m {event.get('title', 'Untitled')}")


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--tmux", action="store_true", help="print plain text for tmux")
    parser.add_argument("--waybar", action="store_true", help="print JSON for Waybar")
    args = parser.parse_args()

    if args.tmux:
        tmux_output()
    else:
        waybar_output()


if __name__ == "__main__":
    main()
