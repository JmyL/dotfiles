#!/usr/bin/env python3
"""Print upcoming calendar alerts for Waybar or tmux.

The script reads khal's local cache and reports the first event starting within
10 minutes. It intentionally does not run vdirsyncer; synchronization is handled
by the user timer.
"""

from __future__ import annotations

import argparse
import json
import subprocess
from datetime import datetime, timedelta


ALERT_WINDOW_MINUTES = 10


def khal_events() -> list[dict[str, str]]:
    cmd = [
        "khal",
        "list",
        "now",
        f"{ALERT_WINDOW_MINUTES}m",
        "--notstarted",
        "--json",
        "title",
        "--json",
        "start-time",
        "--json",
        "calendar",
    ]
    result = subprocess.run(cmd, check=False, text=True, capture_output=True)
    if result.returncode != 0:
        return []

    events: list[dict[str, str]] = []
    for line in result.stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            value = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(value, list):
            for item in value:
                if isinstance(item, dict) and item.get("start-time"):
                    events.append(item)
    return events


def minutes_until(start_time: str) -> int | None:
    try:
        hour, minute = [int(part) for part in start_time.split(":", 1)]
    except ValueError:
        return None

    now = datetime.now()
    start = now.replace(hour=hour, minute=minute, second=0, microsecond=0)
    if start < now:
        start += timedelta(days=1)
    diff = round((start - now).total_seconds() / 60)
    if diff < 0 or diff > ALERT_WINDOW_MINUTES:
        return None
    return diff


def first_alert() -> tuple[int, dict[str, str]] | None:
    candidates: list[tuple[int, dict[str, str]]] = []
    for event in khal_events():
        minutes = minutes_until(event.get("start-time", ""))
        if minutes is not None:
            candidates.append((minutes, event))
    if not candidates:
        return None
    return sorted(candidates, key=lambda item: item[0])[0]


def waybar_output() -> None:
    alert = first_alert()
    if alert is None:
        return

    minutes, event = alert
    title = event.get("title", "Untitled")
    calendar = event.get("calendar", "")
    start_time = event.get("start-time", "")
    print(json.dumps({
        "text": f"󰃭 {minutes}m {title}",
        "tooltip": f"{title}\n{start_time} · {calendar}",
        "class": "urgent" if minutes <= 5 else "soon",
    }, ensure_ascii=False))


def tmux_output() -> None:
    alert = first_alert()
    if alert is None:
        return
    minutes, event = alert
    print(f"󰃭 {minutes}m {event.get('title', 'Untitled')}")


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--tmux", action="store_true", help="print plain text for tmux")
    parser.add_argument("--waybar", action="store_true", help="print JSON for Waybar")
    args = parser.parse_args()

    if args.tmux:
        tmux_output()
    else:
        waybar_output()


if __name__ == "__main__":
    main()
