#!/usr/bin/env python3
"""Show today's khal events starting no earlier than one hour ago."""

from __future__ import annotations

import json
import subprocess
from datetime import datetime, timedelta
from pathlib import Path


def khal_command() -> list[str]:
    if Path("/usr/bin/khal").exists():
        return ["/usr/bin/khal"]
    return ["/usr/bin/toolbox", "run", "--container", "f44", "khal"]


def event_minutes(start_time: str) -> int | None:
    try:
        hour, minute = [int(part) for part in start_time.split(":", 1)]
    except ValueError:
        return None
    return hour * 60 + minute


def today_events() -> list[dict[str, str]]:
    cmd = [
        *khal_command(),
        "list",
        "today",
        "today",
        "--json",
        "title",
        "--json",
        "start-time",
        "--json",
        "end-time",
        "--json",
        "calendar",
    ]
    result = subprocess.run(cmd, check=False, text=True, capture_output=True)
    if result.returncode != 0:
        print(result.stderr.strip() or "khal list failed")
        return []

    events: list[dict[str, str]] = []
    for line in result.stdout.splitlines():
        if not line.strip():
            continue
        try:
            value = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(value, list):
            events.extend(item for item in value if isinstance(item, dict))
    return events


def main() -> None:
    threshold = datetime.now() - timedelta(hours=1)
    threshold_minutes = threshold.hour * 60 + threshold.minute
    events = []
    for event in today_events():
        start_time = event.get("start-time", "")
        minutes = event_minutes(start_time)
        if minutes is None or minutes >= threshold_minutes:
            events.append(event)

    print(datetime.now().strftime("Today's events (%Y-%m-%d %a), from %-I:%M %p"))
    print("=" * 48)
    if not events:
        print("No events.")
        return

    for event in events:
        start_time = event.get("start-time", "")
        end_time = event.get("end-time", "")
        title = event.get("title", "Untitled")
        calendar = event.get("calendar", "")
        if start_time and end_time:
            time_range = f"{start_time}-{end_time}"
        else:
            time_range = start_time or "all day"
        suffix = f" [{calendar}]" if calendar else ""
        print(f"{time_range}  {title}{suffix}")


if __name__ == "__main__":
    main()
