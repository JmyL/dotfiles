#!/usr/bin/env bash
set -uo pipefail

payload="$(cat)"

[[ -n "${TMUX:-}" ]] || exit 0

source "$HOME/.local/bin/claude-attention-common"
claude_attention_locate

if (( looking_at_it )); then
  tmux set-option -p -u -t "$target" @ai_state
  exit 0
fi

tmux set-option -p -t "$target" @ai_state done

info_json="$(printf '%s' "$payload" | claude-session-info 2>/dev/null)"
folder="$(jq -r '.folder // empty' <<<"$info_json" 2>/dev/null)"
cname="$(jq -r '.name // empty' <<<"$info_json" 2>/dev/null)"
summary="$(jq -r '.summary // empty' <<<"$info_json" 2>/dev/null)"

folder="${folder:-$sname}"
title="${cname:-$folder}"
if [[ -n "$cname" ]]; then
  body="${folder}: ${summary:-(no summary)}"
else
  body="${summary:-(no summary)}"
fi

setsid -f claude-notify-and-goto "$target" "$title" "$body" \
  < /dev/null > /dev/null 2>&1 &

exit 0
