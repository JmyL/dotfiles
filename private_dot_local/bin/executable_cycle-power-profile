#!/usr/bin/env bash
set -euo pipefail

service="org.freedesktop.UPower.PowerProfiles"
object="/org/freedesktop/UPower/PowerProfiles"
interface="org.freedesktop.UPower.PowerProfiles"

available="$(busctl --system get-property "$service" "$object" "$interface" Profiles)"
profiles=()

for profile in power-saver balanced performance; do
  if grep -qF "\"Profile\" s \"$profile\"" <<<"$available"; then
    profiles+=("$profile")
  fi
done

if ((${#profiles[@]} == 0)); then
  exit 1
fi

set_profile() {
  local target="$1" p
  for p in "${profiles[@]}"; do
    if [[ "$p" == "$target" ]]; then
      busctl --system set-property "$service" "$object" "$interface" ActiveProfile s "$target"
      return 0
    fi
  done
  printf 'unknown or unavailable profile: %s\n' "$target" >&2
  exit 1
}

if [[ $# -ge 1 ]]; then
  set_profile "$1"
  exit 0
fi

current="$(busctl --system get-property "$service" "$object" "$interface" ActiveProfile)"
current="${current#s \"}"
current="${current%\"}"
next="${profiles[0]}"

for i in "${!profiles[@]}"; do
  if [[ "${profiles[$i]}" == "$current" ]]; then
    next="${profiles[$(((i + 1) % ${#profiles[@]}))]}"
    break
  fi
done

set_profile "$next"
