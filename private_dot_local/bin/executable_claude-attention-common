#!/usr/bin/env bash
# Shared by claude-stop-notify and claude-mark-blocked. Sourced, not run
# directly.

# Sets: sid, sname, widx, pidx, target, looking_at_it
claude_attention_locate() {
  local pane_active window_active
  # Must target $TMUX_PANE explicitly: without -t, display-message reports
  # whatever pane currently has focus, not the pane the hook is running in.
  IFS=$'\t' read -r sid sname widx pidx pane_active window_active < <(
    tmux display-message -p -t "$TMUX_PANE" $'#{session_id}\t#{session_name}\t#{window_index}\t#{pane_index}\t#{pane_active}\t#{window_active}'
  )
  target="$TMUX_PANE"

  looking_at_it=0
  if [[ "$pane_active" == 1 && "$window_active" == 1 ]] && command -v sway-tty-window >/dev/null 2>&1; then
    local tty
    while IFS= read -r tty; do
      [[ -n "$tty" ]] || continue
      if sway-tty-window --is-focused "$tty" 2>/dev/null; then
        looking_at_it=1
        break
      fi
    done < <(tmux list-clients -t "$sid" -F '#{client_activity} #{client_tty}' 2>/dev/null               | sort -rn | awk '{print $2}')
  fi
}
