#!/usr/bin/env bash
# Shared by claude-stop-notify and claude-mark-blocked. Sourced, not run
# directly.

# Sets: sid, sname, widx, pidx, target, looking_at_it
claude_attention_locate() {
  local pane_active window_active
  IFS=$'\t' read -r sid sname widx pidx pane_active window_active < <(
    tmux display-message -p $'#{session_id}\t#{session_name}\t#{window_index}\t#{pane_index}\t#{pane_active}\t#{window_active}'
  )
  target="${sid}:${widx}.${pidx}"

  looking_at_it=0
  if [[ "$pane_active" == 1 && "$window_active" == 1 ]] && command -v swaymsg >/dev/null 2>&1; then
    local best_tty
    best_tty="$(tmux list-clients -t "$sid" -F '#{client_activity} #{client_tty}' 2>/dev/null \
                | sort -rn | head -n1 | awk '{print $2}')"
    if [[ -n "$best_tty" ]] && sway-tty-window --is-focused "$best_tty"; then
      looking_at_it=1
    fi
  fi
}
