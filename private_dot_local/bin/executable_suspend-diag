#!/usr/bin/env bash
# Capture suspend/resume diagnostics for black-screen debugging.
#
# Invoked as:
#   suspend-diag system-sleep <pre|post> <suspend|hibernate|...>
#   suspend-diag user-resume [stamp-dir]
#   suspend-diag prune
#
# Dumps land in ~/.local/share/suspend-diag/<stamp>-<phase>/
set -euo pipefail

readonly KEEP=20

diag_base() {
  printf '%s\n' "${SUSPEND_DIAG_DIR:-${HOME}/.local/share/suspend-diag}"
}

log() {
  printf '%s\n' "$*" >&2
}

stamp_now() {
  date +%Y%m%d-%H%M%S
}

ensure_base() {
  mkdir -p "$(diag_base)"
}

dump_dir_for() {
  local phase="$1"
  local stamp="${2:-$(stamp_now)}"
  local dir
  dir="$(diag_base)/${stamp}-${phase}"
  mkdir -p "$dir"
  printf '%s\n' "$dir"
}

write_file() {
  local path="$1"
  shift
  # shellcheck disable=SC2068
  "$@" >"$path" 2>&1 || true
}

collect_common() {
  local dir="$1"

  {
    echo "date: $(date -Is)"
    echo "hostname: $(hostname)"
    echo "uptime: $(uptime)"
    echo "user: $(id -un) uid=$(id -u)"
    echo "kernel: $(uname -r)"
    echo "cmdline: $(tr '\0' ' ' </proc/cmdline)"
  } >"${dir}/meta.txt" 2>&1 || true

  write_file "${dir}/lid.txt" bash -c '
    shopt -s nullglob
    for f in /proc/acpi/button/lid/*/state; do
      echo "== $f"
      cat "$f"
    done
    if [[ ! -e /proc/acpi/button/lid ]]; then
      echo "no acpi lid nodes"
    fi
  '

  write_file "${dir}/power.txt" bash -c '
    for f in /sys/class/power_supply/*/type /sys/class/power_supply/*/online /sys/class/power_supply/*/status; do
      [[ -e "$f" ]] || continue
      echo "$f: $(cat "$f" 2>/dev/null)"
    done
  '

  write_file "${dir}/drm.txt" bash -c '
    shopt -s nullglob
    for d in /sys/class/drm/card*-*; do
      echo "== $(basename "$d")"
      for f in status enabled dpms power/runtime_status modes; do
        if [[ -e "$d/$f" ]]; then
          if [[ "$f" == modes ]]; then
            echo "-- modes --"
            head -n 20 "$d/$f" 2>/dev/null || true
          else
            echo "$f: $(cat "$d/$f" 2>/dev/null)"
          fi
        fi
      done
      echo
    done
  '

  # dmesg often needs CAP_SYSLOG / root (kernel.dmesg_restrict=1).
  if dmesg -T >/dev/null 2>&1; then
    write_file "${dir}/dmesg-err.txt" dmesg -T --level=err,warn
    write_file "${dir}/dmesg-recent.txt" bash -c 'dmesg -T | tail -n 250'
  else
    write_file "${dir}/dmesg-err.txt" journalctl -k -b -p warning..alert --no-pager -n 100
    write_file "${dir}/dmesg-recent.txt" journalctl -k -b --no-pager -n 250
  fi

  if command -v nvidia-smi >/dev/null 2>&1; then
    write_file "${dir}/nvidia-smi.txt" nvidia-smi
  fi

  write_file "${dir}/journal-pm.txt" journalctl -b --no-pager -n 200 \
    -g 'suspend|resume|PM:|nvidia|Atomic|CRTC|Page-flip|kanshi|backend configuration|Failed to disable'
}

collect_user() {
  local dir="$1"

  {
    echo "XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-}"
    echo "WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}"
    echo "SWAYSOCK=${SWAYSOCK:-}"
    echo "DISPLAY=${DISPLAY:-}"
  } >"${dir}/session-env.txt" 2>&1 || true

  if [[ -z "${SWAYSOCK:-}" && -n "${XDG_RUNTIME_DIR:-}" ]]; then
    SWAYSOCK="$(ls -1 "${XDG_RUNTIME_DIR}"/sway-ipc.*.sock 2>/dev/null | head -n 1 || true)"
    export SWAYSOCK
  fi

  if [[ -n "${SWAYSOCK:-}" ]] && command -v swaymsg >/dev/null 2>&1; then
    write_file "${dir}/sway-outputs.txt" swaymsg -t get_outputs
    write_file "${dir}/sway-outputs.json" swaymsg -t get_outputs -r
    write_file "${dir}/sway-version.txt" swaymsg -t get_version
  else
    echo "swaymsg unavailable (SWAYSOCK=${SWAYSOCK:-unset})" >"${dir}/sway-outputs.txt"
  fi

  if journalctl --user -b --no-pager -n 1 >/dev/null 2>&1; then
    write_file "${dir}/journal-kanshi.txt" journalctl --user -b --no-pager -n 80 \
      -g 'kanshi|profile|Atomic|CRTC|backend configuration|Page-flip'
  else
    write_file "${dir}/journal-kanshi.txt" journalctl -b --no-pager -n 80 \
      -g 'kanshi|profile|Atomic|CRTC|backend configuration|Page-flip'
  fi
}

prune_old() {
  local base
  ensure_base
  base="$(diag_base)"
  # Keep newest KEEP directories; ignore non-dirs.
  mapfile -t dirs < <(find "$base" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' | sort -nr | awk '{print $2}')
  local i=0
  local d
  for d in "${dirs[@]}"; do
    ((i++)) || true
    if ((i > KEEP)); then
      rm -rf "$d"
    fi
  done
}

run_as_user_resume() {
  local stamp="$1"
  local uid
  local runtime
  local user_home
  uid="$(id -u sungsik 2>/dev/null || echo 1000)"
  user_home="$(getent passwd sungsik | cut -d: -f6)"
  runtime="/run/user/${uid}"

  if [[ ! -d "$runtime" ]]; then
    log "user runtime dir missing; skip user-resume dump"
    return 0
  fi

  # Delay so DRM/kanshi settle after resume.
  sleep 3

  systemd-run --quiet --collect \
    --machine="sungsik@.host" --user \
    --setenv="HOME=${user_home}" \
    --setenv="XDG_RUNTIME_DIR=${runtime}" \
    --setenv="SUSPEND_DIAG_DIR=${user_home}/.local/share/suspend-diag" \
    --unit="suspend-diag-user-${stamp}" \
    "${user_home}/.local/bin/suspend-diag" user-resume "${stamp}" \
    || {
      # Fallback if systemd --user machine bus is unavailable.
      runuser -u sungsik -- env \
        HOME="$user_home" \
        XDG_RUNTIME_DIR="$runtime" \
        SUSPEND_DIAG_DIR="${user_home}/.local/share/suspend-diag" \
        "${user_home}/.local/bin/suspend-diag" user-resume "$stamp" || true
    }
}

cmd_system_sleep() {
  local phase="$1"
  local sleep_op="${2:-unknown}"
  local stamp
  local dir
  local marker

  # Root hook always writes into the desktop account's share.
  if [[ "$(id -u)" -eq 0 ]]; then
    export HOME=/home/sungsik
    export SUSPEND_DIAG_DIR=/home/sungsik/.local/share/suspend-diag
  fi

  ensure_base
  stamp="$(stamp_now)"
  dir="$(dump_dir_for "$phase" "$stamp")"
  marker="${dir}/sleep-op.txt"
  printf '%s\n' "$sleep_op" >"$marker"

  collect_common "$dir"

  if [[ "$(id -u)" -eq 0 ]]; then
    chown -R sungsik:sungsik "$dir" 2>/dev/null || true
  fi

  prune_old

  if [[ "$phase" == post && "$(id -u)" -eq 0 ]]; then
    # Do not block systemd-sleep; user dump runs a few seconds later.
    (run_as_user_resume "$stamp") >/dev/null 2>&1 &
  fi

  log "suspend-diag: wrote ${dir}"
}

cmd_user_resume() {
  local stamp="${1:-$(stamp_now)}"
  local dir

  ensure_base
  dir="$(dump_dir_for user "$stamp")"
  collect_common "$dir"
  collect_user "$dir"
  prune_old
  log "suspend-diag: wrote ${dir}"
}

usage() {
  cat <<'EOF'
Usage:
  suspend-diag system-sleep <pre|post> [sleep-op]
  suspend-diag user-resume [stamp]
  suspend-diag prune
EOF
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
  system-sleep)
    [[ $# -ge 1 ]] || {
      usage
      exit 2
    }
    cmd_system_sleep "$@"
    ;;
  user-resume)
    cmd_user_resume "${1:-}"
    ;;
  prune)
    prune_old
    ;;
  *)
    usage
    exit 2
    ;;
  esac
}

main "$@"
