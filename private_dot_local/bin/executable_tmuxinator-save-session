#!/usr/bin/env bash
set -euo pipefail

session="${1:-}"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/tmuxinator"

usage() {
  echo "Usage: tmuxinator-save-session [session-name]"
  exit 2
}

# --- helpers ---

prompt_text() {
  tmux-popup-ui text "$1" 2>/dev/null || true
}

prompt_confirm() {
  local prompt="$1"
  local flag
  flag="$(mktemp)"
  tmux-popup-ui confirm "$prompt" -- sh -c "touch '$flag'" || true
  if [[ -f "$flag" ]]; then
    rm -f "$flag"
    return 0
  fi
  return 1
}

# --- resolve session ---

[[ "${1:-}" == "--help" || "${1:-}" == "-h" ]] && usage
[[ -z "$session" ]] && session="$(tmux display-message -p '#S' 2>/dev/null || true)"
[[ -z "$session" ]] && { tmux-popup-ui error "No session to save"; exit 1; }

# --- resolve target yml (overwrite or new name) ---

mkdir -p "$config_dir"
yml="$config_dir/$session.yml"

while [[ -f "$yml" ]]; do
  if prompt_confirm "Overwrite $session.yml?"; then
    break
  fi
  # Declined → ask for new name
  new="$(prompt_text "New project name: ")"
  [[ -n "$new" ]] || exit 0
  session="$new"
  yml="$config_dir/$session.yml"
done

# --- capture session info ---

resolve_cmd() {
  local cmd="$1"
  case "$cmd" in
    bash|zsh|fish|sh) echo "" ;;
    pi)               echo "pi -c" ;;
    nvim|vim)         echo "$cmd" ;;
    *)                echo "$cmd" ;;
  esac
}

write_yaml() {
  local s="$1"
  local root cmd pane_dir comment

  # root: first pane of first window
  root="$(tmux display-message -t "$s:1.1" -p '#{pane_current_path}' 2>/dev/null || echo "")"

  {
    echo "# Generated by tmuxinator-save-session"
    echo "name: $s"
    echo "root: ${root:-~}"
    echo ""
    echo "windows:"

    tmux list-windows -t "$s" -F $'#{window_index}\t#{window_name}\t#{window_layout}' 2>/dev/null |
      sort -t $'\t' -k1,1n |
      while IFS=$'\t' read -r idx name layout; do
        [[ -z "$name" || "$name" == "$idx" || "$name" == "?"* ]] && name="window-$idx"
        echo "  - $name:"
        echo "      layout: $layout"
        echo "      panes:"

        tmux list-panes -t "$s:.$idx" -F $'#{pane_index}\t#{pane_current_command}\t#{pane_current_path}' 2>/dev/null |
          sort -t $'\t' -k1,1n |
          while IFS=$'\t' read -r pi cmd pane_dir; do
            cmd="$(resolve_cmd "$cmd")"
            if [[ -n "$cmd" ]]; then
              comment=""
              if [[ "$pane_dir" != "$root" && -n "$pane_dir" ]]; then
                comment=" # $pane_dir"
              fi
              echo "        - $cmd$comment"
            else
              echo "        -"
            fi
          done
      done
  } > "$yml"
}

write_yaml "$session"

tmux-popup-ui message "Saved: $session.yml"
