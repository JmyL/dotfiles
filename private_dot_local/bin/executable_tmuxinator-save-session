#!/usr/bin/env bash
set -euo pipefail

session="${1:-}"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/tmuxinator"

usage() {
  echo "Usage: tmuxinator-save-session [session-name]"
  exit 2
}

prompt_text() {
  tmux-popup-ui text "$1" 2>/dev/null || true
}

prompt_confirm() {
  local prompt="$1"
  local flag
  flag="$(mktemp)"
  tmux-popup-ui confirm "$prompt" -- sh -c "touch '$flag'" || true
  if [[ -f "$flag" ]]; then
    rm -f "$flag"
    return 0
  fi
  return 1
}

[[ "${1:-}" == "--help" || "${1:-}" == "-h" ]] && usage
[[ -z "$session" ]] && session="$(tmux display-message -p '#S' 2>/dev/null || true)"
[[ -z "$session" ]] && { tmux-popup-ui error "No session to save"; exit 1; }

mkdir -p "$config_dir"
yml="$config_dir/$session.yml"

while [[ -f "$yml" ]]; do
  if prompt_confirm "Overwrite $session.yml?"; then
    break
  fi
  new="$(prompt_text "New project name: ")"
  [[ -n "$new" ]] || exit 0
  session="$new"
  yml="$config_dir/$session.yml"
done

sep=$'\t'
root="$(tmux display-message -t "$session:1.1" -p '#{pane_current_path}' 2>/dev/null || echo "")"

# --- Collect window indices ---

windows_raw="$(tmux list-windows -t "$session" -F "#{window_index}" 2>/dev/null | sort -n)"
[[ -z "$windows_raw" ]] && { tmux-popup-ui error "No windows found in session"; exit 1; }

# Write indices to a temp file
tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT
indices_file="$tmpdir/indices"
echo "$windows_raw" | grep -v '^$' > "$indices_file"

# --- Build YAML ---
# for loop (no stdin) + here-string (no fd conflict)

{
  echo "# Generated by tmuxinator-save-session"
  echo "name: $session"
  echo "root: ${root:-~}"
  echo ""
  echo "windows:"

  while IFS= read -r idx; do
    [[ -z "$idx" ]] && continue

    win_name="$(tmux display-message -t "$session:${idx}." -p '#{window_name}' 2>/dev/null)"
    win_layout="$(tmux display-message -t "$session:${idx}." -p '#{window_layout}' 2>/dev/null)"
    [[ -z "$win_name" || "$win_name" == "$idx" || "$win_name" == "?"* ]] && win_name="window-$idx"

    echo "  - $win_name:"
    echo "      layout: $win_layout"
    echo "      panes:"

    panes="$(tmux list-panes -t "$session:${idx}." -F "#{pane_index}${sep}#{pane_current_command}${sep}#{pane_current_path}" 2>/dev/null | sort -t "$sep" -k1,1n)"

    while IFS="$sep" read -r pi cmd path; do
      case "$cmd" in
        bash|zsh|fish|sh) cmd="" ;;
        pi)               cmd="pi -c" ;;
        nvim|vim)         cmd="$cmd" ;;
        *)                ;;
      esac
      if [[ -n "$cmd" ]]; then
        comment=""
        if [[ "$path" != "$root" && -n "$path" ]]; then
          comment=" # $path"
        fi
        echo "        - $cmd$comment"
      else
        echo "        -"
      fi
    done <<< "$panes"

  done < "$indices_file"

} > "$yml"

tmux-popup-ui message "Saved: $session.yml"
