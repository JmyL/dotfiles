#!/usr/bin/env bash
set -euo pipefail

session="${1:-}"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/tmuxinator"

usage() {
  echo "Usage: tmuxinator-save-session [session-name]"
  exit 2
}

prompt_text() {
  tmux-popup-ui text "$1" 2>/dev/null || true
}

prompt_confirm() {
  local prompt="$1"
  local flag
  flag="$(mktemp)"
  tmux-popup-ui confirm "$prompt" -- sh -c "touch '$flag'" || true
  if [[ -f "$flag" ]]; then
    rm -f "$flag"
    return 0
  fi
  return 1
}

# --- resolve session ---

[[ "${1:-}" == "--help" || "${1:-}" == "-h" ]] && usage
[[ -z "$session" ]] && session="$(tmux display-message -p '#S' 2>/dev/null || true)"
[[ -z "$session" ]] && { tmux-popup-ui error "No session to save"; exit 1; }

# --- resolve target yml ---

mkdir -p "$config_dir"
yml="$config_dir/$session.yml"

while [[ -f "$yml" ]]; do
  if prompt_confirm "Overwrite $session.yml?"; then
    break
  fi
  new="$(prompt_text "New project name: ")"
  [[ -n "$new" ]] || exit 0
  session="$new"
  yml="$config_dir/$session.yml"
done

# --- collect all data upfront ---

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

root="$(tmux display-message -t "$session:1.1" -p '#{pane_current_path}' 2>/dev/null || echo "")"

sep=$'\t'

tmux list-windows -t "$session" -F "#{window_index}${sep}#{window_name}${sep}#{window_layout}" 2>/dev/null |
  sort -t "$sep" -k1,1n > "$tmpdir/windows"

window_lines="$(cat "$tmpdir/windows")"

# --- generate yaml ---

echo "# Generated by tmuxinator-save-session" > "$yml"
echo "name: $session" >> "$yml"
echo "root: ${root:-~}" >> "$yml"
echo "" >> "$yml"
echo "windows:" >> "$yml"

while IFS="$sep" read -r idx name layout; do
  [[ -z "$name" || "$name" == "$idx" || "$name" == "?"* ]] && name="window-$idx"

  echo "  - $name:" >> "$yml"
  echo "      layout: $layout" >> "$yml"
  echo "      panes:" >> "$yml"

  tmux list-panes -t "$session:.$idx" -F "#{pane_index}${sep}#{pane_current_command}${sep}#{pane_current_path}" 2>/dev/null |
    sort -t "$sep" -k1,1n > "$tmpdir/panes-$idx"

  pane_lines="$(cat "$tmpdir/panes-$idx")"

  while IFS="$sep" read -r pi cmd pane_dir; do
    case "$cmd" in
      bash|zsh|fish|sh) cmd="" ;;
      pi)               cmd="pi -c" ;;
      nvim|vim)         cmd="$cmd" ;;
      *)                ;;
    esac
    if [[ -n "$cmd" ]]; then
      comment=""
      if [[ "$pane_dir" != "$root" && -n "$pane_dir" ]]; then
        comment=" # $pane_dir"
      fi
      echo "        - $cmd$comment" >> "$yml"
    else
      echo "        -" >> "$yml"
    fi
  done <<< "$pane_lines"

done <<< "$window_lines"

tmux-popup-ui message "Saved: $session.yml"
