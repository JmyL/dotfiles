#!/usr/bin/env bash
set -euo pipefail

force=0
session=""
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/tmuxinator"

usage() {
  echo "Usage: tmuxinator-save-session [--force] [session-name]"
  exit 2
}

error() {
  printf '%s\n' "$1" >&2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  --force)
    force=1
    shift
    ;;
  --help | -h) usage ;;
  -*) usage ;;
  *)
    [[ -z "$session" ]] || usage
    session="$1"
    shift
    ;;
  esac
done

[[ -z "$session" ]] && session="$(tmux display-message -p '#S' 2>/dev/null || true)"
[[ -z "$session" ]] && {
  error "No session to save"
  exit 1
}

mkdir -p "$config_dir"
link="$config_dir/$session.yml"
existing=""
if existing="$(tmuxinator-chezmoi resolve "$session" 2>/dev/null)"; then
  :
fi

if [[ -n "$existing" && "$force" -ne 1 ]]; then
  error "$session.yml already exists"
  exit 10
fi

sep=$'\t'
root="$(tmux display-message -t "$session:1.1" -p '#{pane_current_path}' 2>/dev/null || echo "")"

windows_raw="$(tmux list-windows -t "$session" -F "#{window_index}" 2>/dev/null | sort -n)"
[[ -z "$windows_raw" ]] && {
  error "No windows found in session"
  exit 1
}

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT
indices_file="$tmpdir/indices"
yml="$tmpdir/$session.yml"
echo "$windows_raw" | grep -v '^$' >"$indices_file"

{
  echo "name: $session"
  echo "root: ${root:-~}"
  echo ""
  echo "windows:"

  while IFS= read -r idx; do
    [[ -z "$idx" ]] && continue

    win_name="$(tmux display-message -t "$session:${idx}." -p '#{window_name}' 2>/dev/null)"
    win_layout="$(tmux display-message -t "$session:${idx}." -p '#{window_layout}' 2>/dev/null)"
    [[ -z "$win_name" || "$win_name" == "$idx" || "$win_name" == "?"* ]] && win_name="window-$idx"

    echo "  - $win_name:"
    echo "      layout: $win_layout"
    echo "      panes:"

    panes="$(tmux list-panes -t "$session:${idx}." -F "#{pane_index}${sep}#{pane_current_command}${sep}#{pane_current_path}" 2>/dev/null | sort -t "$sep" -k1,1n)"

    while IFS="$sep" read -r pi cmd path; do
      case "$cmd" in
      bash | zsh | fish | sh) cmd="" ;;
      pi) cmd="pi -c" ;;
      nvim | vim) cmd="$cmd" ;;
      *) ;;
      esac
      if [[ -n "$cmd" ]]; then
        comment=""
        if [[ "$path" != "$root" && -n "$path" ]]; then
          comment=" # $path"
        fi
        echo "        - $cmd$comment"
      else
        echo "        -"
      fi
    done <<<"$panes"

  done <"$indices_file"

} >"$yml"

tmuxinator-chezmoi install-yaml "$session" "$yml" >/dev/null
tmuxinator-chezmoi track-add "$session"
