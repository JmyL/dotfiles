#!/usr/bin/env bash
set -euo pipefail

mode="${1:-}"
prompt="${2:-}"

fzf_common=(
  --phony
  --no-info
  --no-separator
  --no-scrollbar
  --border=none
)

case "$mode" in
  text)
    result="$(printf '\n' | fzf "${fzf_common[@]}" --prompt="$prompt" --bind 'enter:print-query+abort')" || exit 1
    [[ -n "$result" ]] || exit 1
    printf '%s\n' "$result"
    ;;
  confirm)
    while true; do
      printf '%s (Y/n) ' "$prompt" >&2
      read -r answer || exit 1
      case "$answer" in
        [Yy]|'') exit 0 ;;
        [Nn]) exit 1 ;;
        *) printf '\033[1A\033[2K' >&2 ;;
      esac
    done
    ;;
  message|error)
    printf '%s' "$prompt"
    read -r _ || true
    ;;
  *)
    printf 'Usage: %s {text|confirm|message|error} <prompt>\n' "$0" >&2
    exit 2
    ;;
esac
