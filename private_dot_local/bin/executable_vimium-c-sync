#!/usr/bin/env bash
set -euo pipefail

# Compare / merge / adopt a Vimium C Export JSON for chezmoi.
# Live browser settings are read and written over Vivaldi localhost CDP
# when ~/.local/bin/vivaldi-stable is running. UI Export/Import is fallback.

config_dir="${VIMIUM_C_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/vimium-c}"
tracked="${VIMIUM_C_TRACKED:-$config_dir/settings.json}"
downloads="${VIMIUM_C_DOWNLOADS:-$HOME/Downloads}"
chezmoi_bin="${CHEZMOI:-chezmoi}"
mergetool="${VIMIUM_C_MERGETOOL:-vimdiff}"
cdp_py="${VIMIUM_C_CDP_PY:-${XDG_CONFIG_HOME:-$HOME/.config}/vimium-c/cdp.py}"
extracted="${VIMIUM_C_EXTRACTED:-${XDG_RUNTIME_DIR:-/tmp}/vimium-c-extracted.json}"
vivaldi_bin="${VIMIUM_C_VIVALDI:-$HOME/.local/bin/vivaldi-stable}"
start_vivaldi="${VIMIUM_C_START_VIVALDI:-1}"
cdp_wait="${VIMIUM_C_CDP_WAIT:-30}"
cdp_sleep="${VIMIUM_C_CDP_SLEEP:-0.25}"
ext_id="${VIMIUM_C_EXT_ID:-hfjbmagddngcpeloejdejnfgbamkjaeg}"
options_url="chrome-extension://${ext_id}/pages/options.html"
do_chezmoi=1

usage() {
  cat <<EOF
Usage: vimium-c-sync <command> [export.json]

Manage a Vimium C Export JSON as ~/.config/vimium-c/settings.json.

  incoming [file]   Compare live/Export settings to the tracked file
  extract [file]    Read live Vimium C settings over CDP
  apply [file]      Write a file (default: tracked) into Vimium C over CDP
  adopt [file]      Replace the tracked file with that Export
  merge [file]      Open a mergetool on incoming vs tracked
  import            Print the Import path (UI fallback)
  export            Print Export instructions (UI fallback)
  path              Print the tracked settings path

If [file] is omitted for incoming/adopt/merge: newest
~/Downloads/vimium_c-*.json, else a CDP extract.

Volatile Export fields (@time, time, environment.chromium) are stripped
before compare/adopt so browser version and export time do not noise diffs.

  --no-chezmoi      Do not run chezmoi add after adopt/merge
  --open            With import/export, open the Vimium C Options page
  --chezmoi         Force chezmoi add (default when chezmoi is available)

extract/apply start ~/.local/bin/vivaldi-stable when CDP is down
and wait for the Vimium C worker. If Vivaldi is already running
without CDP, they refuse rather than killing the session.

After chezmoi update, apply tracked settings to this browser:
  vimium-c-sync incoming
  vimium-c-sync apply
EOF
}

die() {
  printf '%s\n' "$*" >&2
  exit 2
}

find_incoming() {
  local explicit=${1:-}
  local newest="" f
  if [[ -n $explicit ]]; then
    [[ -f "$explicit" ]] || die "incoming file not found: $explicit"
    printf '%s\n' "$explicit"
    return
  fi
  for f in "$downloads"/vimium_c-*.json; do
    [[ -f "$f" ]] || continue
    if [[ -z $newest || "$f" -nt "$newest" ]]; then
      newest=$f
    fi
  done
  if [[ -n $newest ]]; then
    printf '%s\n' "$newest"
    return
  fi
  cmd_extract "$extracted" >/dev/null || die "could not extract live Vimium C settings"
  printf '%s\n' "$extracted"
}

run_cdp() {
  [[ -f "$cdp_py" ]] || die "missing CDP helper: $cdp_py"
  python3 "$cdp_py" "$@"
}

cdp_is_ready() {
  if [[ -n ${VIMIUM_C_CDP_PROBE:-} ]]; then
    "${VIMIUM_C_CDP_PROBE}"
    return
  fi
  run_cdp ready
}

vivaldi_is_running() {
  case ${VIMIUM_C_VIVALDI_RUNNING:-} in
  1) return 0 ;;
  0) return 1 ;;
  esac
  pgrep -x vivaldi-bin >/dev/null 2>&1
}

wait_for_cdp() {
  local waited=0
  while awk -v w="$waited" -v lim="$cdp_wait" 'BEGIN { exit !(w < lim) }'; do
    if cdp_is_ready; then
      printf 'Vivaldi CDP is ready\n'
      return 0
    fi
    sleep "$cdp_sleep"
    waited=$(awk -v w="$waited" -v s="$cdp_sleep" 'BEGIN { print w + s }')
  done
  return 1
}

ensure_vivaldi() {
  if [[ -n ${VIMIUM_C_CDP_DUMP:-} && -f "${VIMIUM_C_CDP_DUMP}" ]]; then
    return 0
  fi
  if cdp_is_ready; then
    return 0
  fi
  if vivaldi_is_running; then
    die "Vivaldi is running without CDP. Quit it, then start ~/.local/bin/vivaldi-stable."
  fi
  if [[ $start_vivaldi != 1 ]]; then
    die "Vivaldi CDP is not ready (auto-start disabled)"
  fi
  if [[ ! -x "$vivaldi_bin" ]]; then
    die "cannot start Vivaldi: $vivaldi_bin is not executable"
  fi
  printf 'starting %s\n' "$vivaldi_bin"
  "$vivaldi_bin" >/dev/null 2>&1 &
  if wait_for_cdp; then
    return 0
  fi
  die "started Vivaldi but CDP did not become ready within ${cdp_wait}s"
}

normalize_json() {
  local src=$1 dest=$2
  python3 - "$src" "$dest" <<'PY'
import json
import sys

src, dest = sys.argv[1], sys.argv[2]
try:
    data = json.loads(open(src, encoding="utf-8").read())
except json.JSONDecodeError as exc:
    sys.stderr.write(f"not JSON: {src}: {exc}\n")
    sys.exit(2)
if not isinstance(data, dict) or data.get("name") not in ("Vimium C", "Vimium++"):
    sys.stderr.write(f"not a Vimium C Export: {src}\n")
    sys.exit(2)
data.pop("@time", None)
data.pop("time", None)
env = data.get("environment")
if isinstance(env, dict):
    env = dict(env)
    env.pop("chromium", None)
    data["environment"] = env
ordered = {}
for key in ("name", "environment"):
    if key in data:
        ordered[key] = data[key]
for key in sorted(data):
    if key not in ordered:
        ordered[key] = data[key]
with open(dest, "w", encoding="utf-8") as out:
    json.dump(ordered, out, indent=2, ensure_ascii=False)
    out.write("\n")
PY
}

ensure_config_dir() {
  mkdir -p "$config_dir"
}

chezmoi_add() {
  if ((do_chezmoi == 0)); then
    printf 'tracked: %s (chezmoi add skipped)\n' "$tracked"
    return
  fi
  if ! command -v "$chezmoi_bin" >/dev/null 2>&1; then
    printf 'tracked: %s (chezmoi not found; add later)\n' "$tracked"
    return
  fi
  "$chezmoi_bin" add "$tracked"
  printf 'tracked: %s (chezmoi add)\n' "$tracked"
}

diff_normalized() {
  local left=$1 right=$2
  local status=0
  diff -u --label incoming --label tracked "$left" "$right" || status=$?
  if ((status == 1)); then
    return 1
  fi
  if ((status > 1)); then
    return "$status"
  fi
  return 0
}

cmd_incoming() {
  local incoming norm_in norm_tr
  incoming=$(find_incoming "${1:-}")
  printf 'incoming: %s\n' "$incoming"
  printf 'tracked:  %s\n' "$tracked"
  norm_in=$(mktemp)
  norm_tr=$(mktemp)
  # shellcheck disable=SC2064
  trap "rm -f '$norm_in' '$norm_tr'" RETURN
  normalize_json "$incoming" "$norm_in"
  if [[ ! -f "$tracked" ]]; then
    printf 'no tracked settings yet; adopt to start chezmoi tracking\n'
    return 1
  fi
  normalize_json "$tracked" "$norm_tr"
  if diff_normalized "$norm_in" "$norm_tr"; then
    printf 'no settings differences (export time / Chromium version ignored)\n'
    return 0
  fi
  return 1
}

cmd_adopt() {
  local incoming norm
  incoming=$(find_incoming "${1:-}")
  ensure_config_dir
  norm=$(mktemp)
  # shellcheck disable=SC2064
  trap "rm -f '$norm'" RETURN
  normalize_json "$incoming" "$norm"
  cp "$norm" "$tracked"
  printf 'adopted %s\n' "$incoming"
  chezmoi_add
}

cmd_merge() {
  local incoming norm_in ours status=0
  incoming=$(find_incoming "${1:-}")
  ensure_config_dir
  if [[ ! -f "$tracked" ]]; then
    printf 'no tracked settings yet; adopting incoming\n'
    cmd_adopt "$incoming"
    return
  fi
  norm_in=$(mktemp)
  ours=$(mktemp)
  # shellcheck disable=SC2064
  trap "rm -f '$norm_in' '$ours'" RETURN
  normalize_json "$incoming" "$norm_in"
  normalize_json "$tracked" "$ours"
  "$mergetool" "$norm_in" "$ours" || status=$?
  if ((status != 0)); then
    printf 'mergetool exited %s; tracked unchanged\n' "$status" >&2
    return "$status"
  fi
  normalize_json "$ours" "$tracked"
  printf 'wrote merge result to %s\n' "$tracked"
  chezmoi_add
}

open_options() {
  if [[ -n ${VIMIUM_C_OPEN:-} ]]; then
    "$VIMIUM_C_OPEN" "$options_url"
    return
  fi
  if command -v vivaldi-stable >/dev/null 2>&1; then
    vivaldi-stable "$options_url"
    return
  fi
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$options_url"
    return
  fi
  die "cannot open Options; set VIMIUM_C_OPEN"
}

cmd_extract() {
  local dest=${1:-} status=0
  ensure_vivaldi
  if [[ -n $dest ]]; then
    run_cdp extract "$dest" || status=$?
    if ((status != 0)); then
      return "$status"
    fi
    printf 'extracted: %s\n' "$dest"
    return 0
  fi
  run_cdp extract
}

cmd_apply() {
  local src=${1:-$tracked}
  [[ -f "$src" ]] || die "no settings to apply: $src"
  if [[ -z ${VIMIUM_C_CDP_APPLY:-} ]]; then
    ensure_vivaldi
  fi
  run_cdp apply "$src"
  printf 'applied: %s\n' "$src"
}

cmd_import() {
  local open=${1:-0}
  if [[ ! -f "$tracked" ]]; then
    die "no tracked settings at $tracked (adopt an Export first)"
  fi
  printf 'Import in Vimium C Options → Backup / Restore:\n'
  printf '  %s\n' "$tracked"
  if ((open == 1)); then
    open_options
  fi
}

cmd_export() {
  local open=${1:-0}
  printf 'Export in Vimium C Options → Backup / Restore\n'
  printf 'Save as ~/Downloads/vimium_c-*.json (the default name), then:\n'
  printf '  vimium-c-sync incoming\n'
  printf '  vimium-c-sync adopt    # or: vimium-c-sync merge\n'
  if ((open == 1)); then
    open_options
  fi
}

cmd=""
file=""
open_opts=0
while [[ $# -gt 0 ]]; do
  case $1 in
  --no-chezmoi)
    do_chezmoi=0
    ;;
  --chezmoi)
    do_chezmoi=1
    ;;
  --open)
    open_opts=1
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  --*)
    die "unknown option: $1"
    ;;
  *)
    if [[ -z $cmd ]]; then
      cmd=$1
    elif [[ -z $file ]]; then
      file=$1
    else
      die "unexpected argument: $1"
    fi
    ;;
  esac
  shift
done

case $cmd in
incoming | diff)
  cmd_incoming "$file"
  ;;
extract)
  cmd_extract "$file"
  ;;
apply)
  cmd_apply "$file"
  ;;
adopt)
  cmd_adopt "$file"
  ;;
merge)
  cmd_merge "$file"
  ;;
import)
  cmd_import "$open_opts"
  ;;
export | open)
  cmd_export "$open_opts"
  ;;
path)
  printf '%s\n' "$tracked"
  ;;
-h | --help | help | "")
  usage
  ;;
*)
  usage >&2
  die "unknown command: $cmd"
  ;;
esac
