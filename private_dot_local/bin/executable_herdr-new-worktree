#!/usr/bin/env bash
# Create a herdr worktree from the current pane (or --cwd).
# Non-git directories show a herdr notification instead of herdr's stuck
# panel diagnostic ("Herdr worktree actions require a workspace inside a
# Git work tree").
set -euo pipefail

herdr_bin="${HERDR:-herdr}"
git_bin="${GIT:-git}"

usage() {
  cat >&2 <<'EOF'
Usage: herdr-new-worktree [--cwd <path>] [--branch <name>]
EOF
  exit 2
}

herdr_cmd() {
  "$herdr_bin" "$@"
}

notify() {
  herdr_cmd notification show "Worktree" \
    --body "$1" \
    --position top-right \
    --sound request >/dev/null || true
}

is_inside_git_work_tree() {
  local dir="$1" out
  out="$("$git_bin" -C "$dir" rev-parse --is-inside-work-tree 2>/dev/null)" || return 1
  [[ "${out//$'\n'/}" == "true" ]]
}

pane_cwd() {
  if [[ -n "${HERDR_ACTIVE_PANE_CWD:-}" ]]; then
    printf '%s\n' "$HERDR_ACTIVE_PANE_CWD"
    return
  fi
  herdr_cmd pane current | python3 -c '
import json
import sys

pane = (json.load(sys.stdin).get("result") or {}).get("pane") or {}
print(pane.get("foreground_cwd") or pane.get("cwd") or "")
'
}

cwd=""
cwd_set=0
branch=""
branch_set=0
while [[ $# -gt 0 ]]; do
  case "$1" in
  --cwd)
    [[ $# -ge 2 ]] || usage
    cwd_set=1
    cwd="$2"
    shift 2
    ;;
  --branch)
    [[ $# -ge 2 ]] || usage
    branch_set=1
    branch="$2"
    shift 2
    ;;
  -h | --help)
    usage
    ;;
  -*)
    printf 'unknown option: %s\n' "$1" >&2
    usage
    ;;
  *)
    usage
    ;;
  esac
done

if ((cwd_set == 0)); then
  cwd="$(pane_cwd)"
fi
if [[ -z "$cwd" ]]; then
  notify "No current pane directory."
  exit 0
fi
if [[ ! -d "$cwd" ]]; then
  notify "Directory does not exist: $cwd"
  exit 0
fi
cwd="$(realpath "$cwd")"
if ! is_inside_git_work_tree "$cwd"; then
  notify "Not a Git work tree: $cwd"
  exit 0
fi
if ((branch_set)) && [[ -n "$branch" ]]; then
  herdr_cmd worktree create --cwd "$cwd" --branch "$branch" --focus >/dev/null
else
  herdr_cmd worktree create --cwd "$cwd" --focus >/dev/null
fi
