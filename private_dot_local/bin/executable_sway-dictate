#!/usr/bin/env bash
set -euo pipefail

worker="${SWAY_DICTATE_WORKER:-$HOME/.local/bin/sway-dictate-worker}"

if ! command -v dev-launcher >/dev/null 2>&1; then
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u critical "Dictation unavailable" "dev-launcher is not installed"
    fi
    exit 127
fi

exec dev-launcher "$worker" "$@"
