#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: ${0##*/} light|dark" >&2
}

mode=${1:-}
case $mode in
light)
  theme_name=catppuccin-latte
  ;;
dark)
  theme_name=catppuccin
  ;;
*)
  usage
  exit 2
  ;;
esac

config=${HERDR_CONFIG_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/herdr/config.toml}
if [[ ! -f $config ]]; then
  echo "${0##*/}: missing Herdr config: $config" >&2
  exit 1
fi

tmp=$(mktemp)
awk -v theme_name="$theme_name" '
  /^\[theme\][[:space:]]*$/ {
    in_theme = 1
    updated = 0
    print
    next
  }
  /^\[/ {
    if (in_theme && !updated) {
      print "name = \"" theme_name "\""
      updated = 1
    }
    in_theme = 0
  }
  in_theme && /^[[:space:]]*name[[:space:]]*=/ {
    if (!updated) {
      print "name = \"" theme_name "\""
      updated = 1
    }
    next
  }
  { print }
  END {
    if (in_theme && !updated) {
      print "name = \"" theme_name "\""
    }
  }
' "$config" >"$tmp"

if cmp -s "$tmp" "$config"; then
  rm -f "$tmp"
else
  mv "$tmp" "$config"
fi

if command -v herdr >/dev/null 2>&1; then
  herdr server reload-config >/dev/null 2>&1 || true
fi
