#!/usr/bin/env bash
# PATH wrapper: open http(s) and local HTML via the real xdg-open with a Sway
# activation token, then focus the Vivaldi window that became urgent (the one
# that accepted the tab). reeplay.reeinfra.net goes to Firefox instead (HEVC).
# Other schemes pass through unchanged.
set -euo pipefail

XDG_OPEN="${XDG_OPEN:-/usr/bin/xdg-open}"
SWAYMSG="${SWAYMSG:-swaymsg}"
BROWSER_APP_ID="${BROWSER_APP_ID:-vivaldi-stable}"
FIREFOX="${FIREFOX:-firefox}"
FIREFOX_APP_ID="${FIREFOX_APP_ID:-firefox_firefox}"
URGENT_POLL_COUNT="${URGENT_POLL_COUNT:-12}"
URGENT_POLL_INTERVAL="${URGENT_POLL_INTERVAL:-0.05}"

is_browser_target() {
  local target="${1:-}"
  case "$target" in
  http://* | https://*)
    return 0
    ;;
  file://*.html | file://*.htm | file://*.HTML | file://*.HTM)
    return 0
    ;;
  *.html | *.htm | *.HTML | *.HTM)
    return 0
    ;;
  esac
  return 1
}

# Host-only match: https://reeplay.reeinfra.net.evil.com must not pass.
is_reeplay_url() {
  local target="${1:-}"
  case "$target" in
  http://reeplay.reeinfra.net | https://reeplay.reeinfra.net) return 0 ;;
  http://reeplay.reeinfra.net[/?#]* | https://reeplay.reeinfra.net[/?#]*) return 0 ;;
  esac
  return 1
}

resolve_browser_target() {
  local target="${1:-}"
  case "$target" in
  http://* | https://* | file://* | /*)
    printf '%s\n' "$target"
    ;;
  *)
    readlink -f -- "$target" 2>/dev/null || printf '%s\n' "$target"
    ;;
  esac
}

sway_exec_cmd() {
  local -a quoted=()
  local arg
  for arg in "$@"; do
    quoted+=("$(printf '%q' "$arg")")
  done
  # Sway's exec has no "--"; that token is treated as the command name
  # and the real opener never runs (IPC still returns success).
  "$SWAYMSG" "exec ${quoted[*]}" >/dev/null
}

sway_focus() {
  "$SWAYMSG" "$1" >/dev/null
}

focus_urgent_app() {
  local app_id="$1"
  local i
  for ((i=0; i<URGENT_POLL_COUNT; i++)); do
    if sway_focus "[app_id=\"${app_id}\" urgent=latest] focus"; then
      return 0
    fi
    sleep "$URGENT_POLL_INTERVAL"
  done
  return 1
}

focus_any_app() {
  sway_focus "[app_id=\"$1\"] focus"
}

focus_browser() {
  local app_id="$1"
  if ! focus_urgent_app "$app_id"; then
    focus_any_app "$app_id" || true
  fi
}

xdg_open_main() {
  if ! is_browser_target "${1:-}"; then
    exec "$XDG_OPEN" "$@"
  fi

  local target
  target="$(resolve_browser_target "$1")"
  shift

  if is_reeplay_url "$target"; then
    if ! command -v "$SWAYMSG" >/dev/null 2>&1; then
      exec "$FIREFOX" "$target" "$@"
    fi
    sway_exec_cmd "$FIREFOX" "$target" "$@"
    focus_browser "$FIREFOX_APP_ID"
    return 0
  fi

  if ! command -v "$SWAYMSG" >/dev/null 2>&1; then
    exec "$XDG_OPEN" "$target" "$@"
  fi

  sway_exec_cmd "$XDG_OPEN" "$target" "$@"
  focus_browser "$BROWSER_APP_ID"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  xdg_open_main "$@"
fi
