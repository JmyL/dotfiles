#!/usr/bin/env python3
"""Move the selected aerc/notmuch message from Junk to INBOX."""

from __future__ import annotations

import email
import mailbox
import os
import shutil
import subprocess
import sys
import tempfile
from email import policy
from pathlib import Path


def run(*args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(args, check=check, text=True, capture_output=True)


def notmuch_query(term: str) -> str:
    return f"id:{term.strip().strip('<>')}"


def message_ids_from_stdin() -> list[str]:
    data = sys.stdin.buffer.read()
    if not data:
        return []

    ids: list[str] = []
    with tempfile.NamedTemporaryFile(delete=False) as tmp:
        tmp.write(data)
        tmp_path = tmp.name

    try:
        if data.startswith(b"From "):
            mbox = mailbox.mbox(tmp_path, factory=None, create=False)
            try:
                for msg in mbox:
                    mid = msg.get("Message-ID")
                    if mid:
                        ids.append(mid)
            finally:
                mbox.close()
        else:
            msg = email.message_from_bytes(data, policy=policy.default)
            mid = msg.get("Message-ID")
            if mid:
                ids.append(mid)
    finally:
        os.unlink(tmp_path)

    return ids


def files_for(query: str) -> list[Path]:
    out = run("notmuch", "search", "--output=files", "--", query).stdout
    return [Path(line) for line in out.splitlines() if line.strip()]


def unique_destination(path: Path) -> Path:
    if not path.exists():
        return path

    stem = path.name
    for i in range(1, 1000):
        candidate = path.with_name(f"{stem}.{i}")
        if not candidate.exists():
            return candidate

    raise RuntimeError(f"could not find unique destination for {path}")


def move_junk_to_inbox(query: str) -> None:
    mail_root = Path(run("notmuch", "config", "get", "database.path").stdout.strip())
    junk_root = mail_root / "Junk"
    inbox_cur = mail_root / "INBOX" / "cur"
    inbox_cur.mkdir(parents=True, exist_ok=True)

    moved = False
    for path in files_for(query):
        try:
            path.relative_to(junk_root)
        except ValueError:
            continue

        if path.parent.name not in {"cur", "new"}:
            continue

        dest = unique_destination(inbox_cur / path.name)
        shutil.move(str(path), str(dest))
        moved = True

    if moved:
        run("notmuch", "new")

    run("notmuch", "tag", "+inbox", "-spam", "-trash", "--", query)


def main() -> int:
    message_ids = message_ids_from_stdin()
    if not message_ids:
        print("aerc-inbox-message: no Message-ID found", file=sys.stderr)
        return 1

    for message_id in message_ids:
        move_junk_to_inbox(notmuch_query(message_id))

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
