#!/usr/bin/env python3
"""Send a desktop notification with a "Go to pane" action, wait for the
click, and jump to the target tmux pane if invoked.

Usage: claude-notify-and-goto <session_id:window.pane> <summary> <body>

notify-send's own -A support is unreliable against this swaync build (it
mis-detects capabilities and refuses to attach actions), so this talks to
org.freedesktop.Notifications directly over D-Bus instead.
"""
import subprocess
import sys

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

BUS_NAME = "org.freedesktop.Notifications"
OBJ_PATH = "/org/freedesktop/Notifications"
IFACE = "org.freedesktop.Notifications"
# "default" is invoked by clicking the notification body itself (per the
# freedesktop spec). "goto" is a normal labeled action button: swaync-client
# -a only invokes labeled actions, never the bodiless "default" one, so it's
# needed to make the sway keybind (mod+Return) trigger this.
ACTION_KEYS = ("default", "goto")
MAX_WAIT_SECONDS = 6 * 3600


def main():
    if len(sys.argv) != 4:
        sys.exit(f"usage: {sys.argv[0]} SESSION_ID:WINDOW.PANE SUMMARY BODY")
    target, summary, body = sys.argv[1:4]

    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)

    loop = GLib.MainLoop()
    result = {"action": False}
    notif_id = {"value": None}

    def on_signal(_conn, _sender, _path, _iface, member, params):
        args = params.unpack()
        if not args or args[0] != notif_id["value"]:
            return
        if member == "ActionInvoked" and len(args) > 1 and args[1] in ACTION_KEYS:
            result["action"] = True
            loop.quit()
        elif member == "NotificationClosed":
            loop.quit()

    # Subscribe before sending the notification so there is no window in
    # which a very fast click could fire before we're listening.
    bus.signal_subscribe(
        BUS_NAME, IFACE, None, OBJ_PATH, None, Gio.DBusSignalFlags.NONE, on_signal
    )

    reply = bus.call_sync(
        BUS_NAME,
        OBJ_PATH,
        IFACE,
        "Notify",
        GLib.Variant(
            "(susssasa{sv}i)",
            (
                "Claude Code",
                0,
                "",
                summary,
                body,
                ["goto", "Go to pane", "default", ""],
                {},
                0,
            ),
        ),
        GLib.VariantType("(u)"),
        Gio.DBusCallFlags.NONE,
        -1,
        None,
    )
    notif_id["value"] = reply.unpack()[0]

    GLib.timeout_add_seconds(MAX_WAIT_SECONDS, loop.quit)
    loop.run()

    if result["action"]:
        subprocess.run(["tmux-goto-pane", target])


if __name__ == "__main__":
    main()
