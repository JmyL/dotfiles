#!/usr/bin/env bash
# Desktop application launcher via floating foot + fzf
set -euo pipefail

# Sway's PATH has no ~/.local/bin, so prefer the sibling script.
menu=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/fzf-menu
if [[ ! -x $menu ]]; then
  if ! menu=$(command -v fzf-menu); then
    echo "fzf-drun: fzf-menu not found" >&2
    exit 127
  fi
fi

# Honor XDG data dirs so snap/flatpak desktop files are included
# (e.g. Ubuntu Firefox snap under /var/lib/snapd/desktop/applications).
data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
data_dirs="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
app_dirs=("$data_home/applications")
IFS=:
for dir in $data_dirs; do
  [[ -n $dir ]] || continue
  app_dirs+=("$dir/applications")
done
unset IFS

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/fzf-drun"
cache_file=$cache_dir/apps.tsv

fingerprint=$(
  {
    printf '%s\n' "${app_dirs[@]}"
    find "${app_dirs[@]}" -type f -name '*.desktop' -printf '%p\t%T@\n' 2>/dev/null || true
  } | sort | md5sum | awk '{print $1}'
)

labels=()
ids=()

load_cache() {
  local fp line name id
  {
    read -r fp || return 1
    [[ $fp == "$fingerprint" ]] || return 1
    while IFS=$'\t' read -r name id; do
      [[ -n $name && -n $id ]] || continue
      labels+=("$name")
      ids+=("$id")
    done
  } <"$cache_file"
  ((${#labels[@]} > 0))
}

rebuild_cache() {
  local file name id tmp i
  labels=()
  ids=()

  while IFS= read -r file; do
    [[ -n $file ]] || continue
    # Single awk pass: skip Hidden/NoDisplay and non-Application; emit Name.
    name=$(
      awk -F= '
        /^\[Desktop Entry\]/ { in_entry=1; next }
        /^\[/ { in_entry=0 }
        !in_entry { next }
        $1 == "Hidden" || $1 == "NoDisplay" {
          if ($2 == "true") { skip=1; exit }
        }
        $1 == "Type" { typ=$2 }
        $1 == "Name" && name == "" { name=$2 }
        END {
          if (skip) exit
          if (typ != "" && typ != "Application") exit
          if (name != "") print name
        }
      ' "$file"
    )
    [[ -n $name ]] || continue

    id=${file##*/}
    id=${id%.desktop}
    labels+=("$name")
    ids+=("$id")
  done < <(find "${app_dirs[@]}" -type f -name '*.desktop' 2>/dev/null | sort -u || true)

  ((${#labels[@]} > 0)) || return 1

  mkdir -p "$cache_dir"
  tmp=$(mktemp "$cache_dir/apps.tsv.XXXXXX")
  {
    printf '%s\n' "$fingerprint"
    for i in "${!labels[@]}"; do
      printf '%s\t%s\n' "${labels[$i]}" "${ids[$i]}"
    done
  } >"$tmp"
  mv -f "$tmp" "$cache_file"
}

if [[ ! -f $cache_file ]] || ! load_cache; then
  rebuild_cache || exit 1
fi

choice=$(printf '%s\n' "${labels[@]}" | "$menu" --prompt 'Apps> ' --width 90 --height 28) || exit 1
choice=${choice%$'\n'}
[[ -n $choice ]] || exit 1

selected_id=
for i in "${!labels[@]}"; do
  if [[ ${labels[$i]} == "$choice" ]]; then
    selected_id=${ids[$i]}
    break
  fi
done

[[ -n $selected_id ]] || exit 1

if command -v gtk-launch >/dev/null 2>&1; then
  exec gtk-launch "$selected_id"
fi

# Fallback: resolve Exec= from the matching desktop file.
while IFS= read -r file; do
  base=${file##*/}
  if [[ $base == "${selected_id}.desktop" ]]; then
    exec_line=$(
      awk -F= '
        /^\[Desktop Entry\]/ { in_entry=1; next }
        /^\[/ { in_entry=0 }
        in_entry && $1 == "Exec" { print substr($0, index($0, "=") + 1); exit }
      ' "$file"
    )
    # Strip field codes (%f, %u, ...)
    exec_line=${exec_line%% %*}
    exec_line=${exec_line//%%/%}
    [[ -n $exec_line ]] || exit 1
    # shellcheck disable=SC2086
    exec $exec_line
  fi
done < <(find "${app_dirs[@]}" -type f -name "${selected_id}.desktop" 2>/dev/null || true)

exit 1
