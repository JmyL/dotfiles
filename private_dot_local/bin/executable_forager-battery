#!/usr/bin/env python3
"""Print Forager keyboard battery level for Waybar."""

from __future__ import annotations

import json
import re
import subprocess


DEVICE_NAME = "Forager"
UPOWER = "/usr/bin/upower"
ICON_COLOR = "#72b7f2"
LOW_COLOR = "#ff7b86"
LOW_BATTERY_PERCENT = 20


def empty() -> None:
    print(json.dumps({"text": "", "tooltip": ""}, ensure_ascii=False))


def upower_devices() -> list[str]:
    result = subprocess.run([UPOWER, "-e"], check=False, text=True, capture_output=True)
    if result.returncode != 0:
        return []
    return [line.strip() for line in result.stdout.splitlines() if line.strip()]


def device_info(path: str) -> str:
    result = subprocess.run([UPOWER, "-i", path], check=False, text=True, capture_output=True)
    if result.returncode != 0:
        return ""
    return result.stdout


def battery_icon(percent: int) -> str:
    if percent >= 90:
        return ""
    if percent >= 70:
        return ""
    if percent >= 40:
        return ""
    if percent >= 15:
        return ""
    return ""


def main() -> None:
    for path in upower_devices():
        info = device_info(path)
        if f"model:                {DEVICE_NAME}" not in info:
            continue
        match = re.search(r"percentage:\s+(\d+)%", info)
        if match is None:
            empty()
            return
        percent = int(match.group(1))
        is_low = percent <= LOW_BATTERY_PERCENT
        icon_color = LOW_COLOR if is_low else ICON_COLOR
        print(json.dumps({
            # letter_spacing 1536 = 1.5pt ≈ 2px at 96dpi (gap between battery icon and %)
            "text": f"<span foreground=\"{icon_color}\"> {battery_icon(percent)}</span><span letter_spacing=\"1536\"> </span>{percent}%",
            "tooltip": f"{DEVICE_NAME} battery: {percent}%",
            "class": "low" if is_low else "normal",
        }, ensure_ascii=False))
        return

    empty()


if __name__ == "__main__":
    main()
