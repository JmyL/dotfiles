#!/usr/bin/env bash
set -uo pipefail

input_target="${1:?usage: tmux-goto-pane SESSION_ID:WINDOW.PANE|PANE_ID}"

worker_output="$(dev-launcher tmux-goto-pane-worker "$input_target" 2>/dev/null)"
status=$?
if (( status == 1 )); then
  notify-send -a "AI Agent" "Couldn't jump to pane" "That pane no longer exists." 2>/dev/null || true
  exit 1
elif (( status == 2 )); then
  notify-send -a "AI Agent" "Couldn't jump to pane" "That session no longer exists." 2>/dev/null || true
  exit 1
elif (( status != 0 )); then
  exit "$status"
fi

tty="$(printf '%s\n' "$worker_output" | tail -n1)"
if [[ -n "$tty" ]] && con_id="$(sway-tty-window "$tty" 2>/dev/null)"; then
  swaymsg "[con_id=$con_id] focus" >/dev/null 2>&1 || true
fi

exit 0
