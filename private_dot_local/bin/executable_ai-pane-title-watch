#!/usr/bin/env python3
"""Watch tmux pane titles for Codex "Action Required" states."""
from __future__ import annotations

import argparse
import fcntl
import glob
import json
import os
import re
import signal
import shutil
import subprocess
import sys
import time
import unittest
from dataclasses import dataclass
from pathlib import Path


SUBSCRIPTION_NAME = "ai-pane-title"
FORMAT = "#{@ai_cli}\t#{@ai_state}\t#{@ai_title_blocked}\t#{pane_title}"
ACTION_REQUIRED = "Action Required"
OBSERVATION_TTL_SECONDS = 8


def runtime_dir() -> Path:
    return Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp") / "ai-hook-notify"


def session_dir() -> Path:
    return runtime_dir() / "codex-sessions"


def sanitize(value: str) -> str:
    return re.sub(r"[^A-Za-z0-9_.-]", "_", value)


def control_unescape(value: str) -> str:
    def replace(match: re.Match[str]) -> str:
        return chr(int(match.group(1), 8))

    return re.sub(r"\\([0-7]{3})", replace, value)


@dataclass(frozen=True)
class PaneTitleEvent:
    session: str
    pane: str
    ai_cli: bool
    ai_state: str
    title_blocked: bool
    title: str


@dataclass(frozen=True)
class PaneMapping:
    agent: str
    target: str
    cwd: str
    session_id: str = ""


def parse_subscription_changed(line: str) -> PaneTitleEvent | None:
    if not line.startswith("%subscription-changed "):
        return None

    parts = line.split(" ")
    if len(parts) < 7 or parts[1] != SUBSCRIPTION_NAME:
        return None
    try:
        colon_index = parts.index(":", 6)
    except ValueError:
        return None

    session = parts[2]
    pane = parts[5]
    raw_value = " ".join(parts[colon_index + 1 :])
    value = control_unescape(raw_value)
    fields = value.split("\t", 3)
    while len(fields) < 4:
        fields.append("")

    return PaneTitleEvent(
        session=session,
        pane=pane,
        ai_cli=fields[0] == "1",
        ai_state=fields[1],
        title_blocked=fields[2] == "1",
        title=fields[3],
    )


def should_mark_blocked(event: PaneTitleEvent) -> bool:
    return event.ai_cli and ACTION_REQUIRED in event.title


def should_clear_title_blocked(event: PaneTitleEvent) -> bool:
    return event.title_blocked and ACTION_REQUIRED not in event.title


def tmux(*args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["dev-launcher", "tmux", *args],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )


def tmux_sway_con_id(session: str) -> str:
    if not session or not shutil.which("sway-process-window"):
        return ""
    result = tmux("list-clients", "-t", session, "-F", "#{client_activity}\t#{client_tty}\t#{client_pid}")
    if result.returncode != 0:
        return ""
    rows: list[tuple[float, str]] = []
    for line in result.stdout.splitlines():
        activity, _, rest = line.partition("\t")
        _tty, _, pid = rest.partition("\t")
        if not pid:
            continue
        try:
            activity_value = float(activity)
        except ValueError:
            activity_value = 0.0
        rows.append((activity_value, pid))

    for _activity, pid in sorted(rows, reverse=True):
        con = subprocess.run(
            ["sway-process-window", pid],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        con_id = con.stdout.strip()
        if con.returncode == 0 and con_id:
            return con_id
    return ""


def sway_window_focused(con_id: str) -> bool:
    if not con_id or not shutil.which("sway-window-focused"):
        return False
    return subprocess.run(
        ["sway-window-focused", con_id],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    ).returncode == 0


def pane_is_unfocused(event: PaneTitleEvent) -> bool:
    result = tmux("display-message", "-p", "-t", event.pane, "#{pane_active}\t#{window_active}")
    if result.returncode != 0:
        return True
    pane_active, _, window_active = result.stdout.strip().partition("\t")
    if pane_active != "1" or window_active != "1":
        return True
    if not shutil.which("sway-process-window") or not shutil.which("sway-window-focused"):
        return False
    con_id = tmux_sway_con_id(event.session)
    return not sway_window_focused(con_id)


def pane_cwd(pane: str) -> str:
    result = tmux("display-message", "-p", "-t", pane, "#{pane_current_path}")
    if result.returncode == 0:
        return result.stdout.strip()
    return ""


def find_pane_mapping(pane: str, session: str = "") -> PaneMapping:
    matches: list[tuple[float, dict[str, object]]] = []
    for path in glob.glob(str(session_dir() / "*.json")):
        try:
            stat = os.stat(path)
            with open(path, encoding="utf-8") as handle:
                data = json.load(handle)
        except (OSError, json.JSONDecodeError):
            continue
        if not isinstance(data, dict):
            continue
        target = data.get("target")
        if not isinstance(target, str) or not target:
            continue
        mapped_pane = data.get("tmux_pane")
        has_pane = mapped_pane == pane or any(segment == f"tmux:{pane}" for segment in target.split(","))
        if not has_pane:
            continue
        updated = data.get("updated_at")
        try:
            updated_float = float(updated)
        except (TypeError, ValueError):
            updated_float = stat.st_mtime
        matches.append((updated_float, data))

    if matches:
        data = max(matches, key=lambda item: item[0])[1]
        return PaneMapping(
            agent=str(data.get("agent") or "codex"),
            target=str(data.get("target") or f"tmux:{pane}"),
            cwd=str(data.get("cwd") or ""),
            session_id=str(data.get("session_id") or ""),
        )

    con_id = tmux_sway_con_id(session)
    target = f"sway-window:{con_id},tmux:{pane}" if con_id else f"tmux:{pane}"
    return PaneMapping(agent="codex", target=target, cwd=pane_cwd(pane))


def clean_capture_line(line: str) -> str:
    line = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", line)
    line = "".join(
        " "
        if ord(char) in {
            0x2500,
            0x2501,
            0x2502,
            0x2503,
            0x250C,
            0x250F,
            0x2510,
            0x2513,
            0x2514,
            0x2517,
            0x2518,
            0x251B,
            0x251C,
            0x2524,
            0x252C,
            0x2534,
            0x253C,
            0x256D,
            0x256E,
            0x256F,
            0x2570,
        }
        else char
        for char in line
    )
    line = re.sub(r"^[\s>*xXoO\-\[\]\(\)0-9.]+", "", line)
    return " ".join(line.split())


def capture_action_required_summary(pane: str) -> str:
    result = tmux("capture-pane", "-p", "-t", pane, "-S", "-120")
    if result.returncode != 0:
        return ""
    lines = [clean_capture_line(line) for line in result.stdout.splitlines()]
    lines = [line for line in lines if line]
    if not lines:
        return ""

    action_indexes = [index for index, line in enumerate(lines) if ACTION_REQUIRED in line]
    start = max(action_indexes[-1] - 2, 0) if action_indexes else max(len(lines) - 30, 0)
    candidates = lines[start:]

    skip_patterns = (
        r"^Action Required\b",
        r"^Codex\b",
        r"^Esc\b",
        r"^Enter\b",
        r"^Use arrows\b",
        r"^Select\b",
        r"^Yes$",
        r"^No$",
        r"^\?$",
    )
    for line in candidates:
        if any(re.search(pattern, line, re.IGNORECASE) for pattern in skip_patterns):
            continue
        if re.search(r"(allow|approve|continue|proceed|question|input|required|선택|질문|허용|승인)", line, re.IGNORECASE):
            return line[:180]

    for line in candidates:
        if not any(re.search(pattern, line, re.IGNORECASE) for pattern in skip_patterns):
            return line[:180]
    return ""


def report_observation(state: str, mapping: PaneMapping, pane: str, cwd: str, message: str = "") -> None:
    args = [
        "ai-state-daemon",
        "report-observation",
        "--source",
        "title",
        "--state",
        state,
        "--agent",
        mapping.agent,
        "--target",
        mapping.target,
        "--cwd",
        cwd,
        "--ttl",
        str(OBSERVATION_TTL_SECONDS),
    ]
    if mapping.session_id:
        args.extend(["--session-id", mapping.session_id])
    if message:
        args.extend(["--message", message])
    try:
        tmux("set-option", "-p", "-t", pane, "@ai_cli", "1")
    except OSError:
        pass
    try:
        subprocess.run(
            args,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    except OSError:
        pass


def handle_event(event: PaneTitleEvent) -> None:
    if should_mark_blocked(event):
        mapping = find_pane_mapping(event.pane, event.session)
        cwd = mapping.cwd or pane_cwd(event.pane)
        body = capture_action_required_summary(event.pane) or "Codex needs your input"
        report_observation("blocked", mapping, event.pane, cwd, body)
        return

    if should_clear_title_blocked(event):
        mapping = find_pane_mapping(event.pane, event.session)
        cwd = mapping.cwd or pane_cwd(event.pane)
        report_observation("idle", mapping, event.pane, cwd, "")


def control_command() -> str:
    return f"refresh-client -B '{SUBSCRIPTION_NAME}:%*:{FORMAT}'\n"


def list_sessions() -> list[str]:
    result = tmux("list-sessions", "-F", "#{session_id}")
    if result.returncode != 0:
        return []
    return [line.strip() for line in result.stdout.splitlines() if line.strip()]


def spawn_session_daemon(session: str) -> None:
    try:
        subprocess.Popen(
            [sys.argv[0], "--daemon", "--session", session],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError:
        pass


def run_control_client(session: str) -> int:
    proc = subprocess.Popen(
        ["dev-launcher", "tmux", "-C", "attach-session", "-t", session],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        bufsize=1,
    )
    assert proc.stdin is not None
    assert proc.stdout is not None
    proc.stdin.write(control_command())
    proc.stdin.flush()

    for line in proc.stdout:
        if should_stop:
            break
        event = parse_subscription_changed(line.rstrip("\n"))
        if event is not None:
            handle_event(event)

    try:
        proc.terminate()
    except OSError:
        pass
    try:
        proc.wait(timeout=1)
    except subprocess.TimeoutExpired:
        proc.kill()
    return 0


should_stop = False


def stop(_signum: int, _frame: object) -> None:
    global should_stop
    should_stop = True


def daemon(session: str) -> int:
    lock_dir = runtime_dir()
    lock_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    lock_path = lock_dir / f"pane-title-watch-{sanitize(session)}.lock"
    with lock_path.open("w", encoding="utf-8") as lock_file:
        try:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return 0

        signal.signal(signal.SIGTERM, stop)
        signal.signal(signal.SIGINT, stop)
        backoff = 0.2
        while not should_stop:
            try:
                run_control_client(session)
                if not should_stop:
                    time.sleep(backoff)
                    backoff = min(backoff * 2, 5.0)
            except Exception:
                time.sleep(backoff)
                backoff = min(backoff * 2, 5.0)
    return 0


class ParserTests(unittest.TestCase):
    def test_parse_subscription_changed(self) -> None:
        line = "%subscription-changed ai-pane-title $1 @2 0 %3 : 1\tbusy\t\tCodex - Action Required"
        event = parse_subscription_changed(line)
        self.assertEqual(event, PaneTitleEvent("$1", "%3", True, "busy", False, "Codex - Action Required"))

    def test_parse_escaped_title(self) -> None:
        line = r"%subscription-changed ai-pane-title $1 @2 0 %3 : 1\011blocked\0111\011Action\040Required"
        event = parse_subscription_changed(line)
        self.assertEqual(event, PaneTitleEvent("$1", "%3", True, "blocked", True, "Action Required"))

    def test_mark_requires_ai_cli(self) -> None:
        event = PaneTitleEvent("$1", "%3", False, "busy", False, "Action Required")
        self.assertFalse(should_mark_blocked(event))

    def test_clear_only_marker_owned(self) -> None:
        self.assertTrue(should_clear_title_blocked(PaneTitleEvent("$1", "%3", True, "blocked", True, "codex")))
        self.assertFalse(should_clear_title_blocked(PaneTitleEvent("$1", "%3", True, "blocked", False, "codex")))

    def test_capture_summary_prefers_question(self) -> None:
        lines = [
            "╭ Action Required ╮",
            "│ Allow command `git push` to run? │",
            "│ Yes │",
            "│ No │",
        ]
        cleaned = [clean_capture_line(line) for line in lines]
        self.assertIn("Allow command `git push` to run?", cleaned)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--daemon", action="store_true")
    parser.add_argument("--session", default="")
    parser.add_argument("--all", action="store_true")
    parser.add_argument("--self-test", action="store_true")
    args = parser.parse_args()

    if args.self_test:
        suite = unittest.defaultTestLoader.loadTestsFromTestCase(ParserTests)
        result = unittest.TextTestRunner(verbosity=2).run(suite)
        return 0 if result.wasSuccessful() else 1

    if not args.daemon:
        parser.error("--daemon is required unless --self-test is used")
    if args.all:
        for session in list_sessions():
            spawn_session_daemon(session)
        return 0
    session = args.session or os.environ.get("TMUX_TITLE_WATCH_SESSION") or ""
    if not session:
        parser.error("--session is required")
    return daemon(session)


if __name__ == "__main__":
    raise SystemExit(main())
