#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${TMUX_PANE:-}" ]]; then
  tmux set-option -p -t "$TMUX_PANE" @ai_cli 1
fi

show_help() {
  cat <<'EOF'
Usage: ai [OPTIONS] [--] [ARGS...]

Run the first available AI CLI in this order:
  1) pi (if pi exists)
  2) opencode
  3) agent
  4) claude
  5) codex

Options:
  -R, --resume-last-session  Resume the last/recent session
      --mini                 Run opencode mini instead of the full TUI (opencode only) [default]
      --full                 Run the opencode full TUI instead of mini (opencode only)
  -h, --help                 Show this help

All other arguments are passed through to the selected CLI.
Use -- before ARGS to pass values that look like ai options.
EOF
}

resume_last=0
mini=1
passthrough=()
seen_separator=0

for arg in "$@"; do
  if ((seen_separator)); then
    passthrough+=("$arg")
  elif [[ "$arg" == "--" ]]; then
    seen_separator=1
  elif [[ "$arg" == "--resume-last-session" || "$arg" == "-R" ]]; then
    resume_last=1
  elif [[ "$arg" == "--mini" ]]; then
    mini=1
  elif [[ "$arg" == "--full" ]]; then
    mini=0
  elif [[ "$arg" == "--help" || "$arg" == "-h" ]]; then
    show_help
    exit 0
  else
    passthrough+=("$arg")
  fi
done

run_agent() {
  local cmd="$1"
  shift
  local -a args=("$@")

  if ((resume_last)); then
    case "$cmd" in
    claude | agent | pi)
      args=(--continue "${args[@]}")
      ;;
    codex)
      args=(resume --last "${args[@]}")
      ;;
    *)
      echo "ai: --resume-last-session is not supported for $cmd" >&2
      exit 1
      ;;
    esac
  fi

  exec "$cmd" "${args[@]}"
}

run_opencode() {
  local -a cmd=(opencode)
  if ((mini)); then
    cmd=(opencode mini)
  fi
  if ((resume_last)); then
    cmd+=(--continue)
  fi

  exec "${cmd[@]}" "$@"
}

if command -v pi >/dev/null 2>&1; then
  run_agent pi "${passthrough[@]}"
fi

if command -v opencode >/dev/null 2>&1; then
  run_opencode "${passthrough[@]}"
fi

if command -v agent >/dev/null 2>&1; then
  run_agent agent "${passthrough[@]}"
fi

if command -v claude >/dev/null 2>&1; then
  run_agent claude "${passthrough[@]}"
fi

if command -v codex >/dev/null 2>&1; then
  run_agent codex "${passthrough[@]}"
fi
