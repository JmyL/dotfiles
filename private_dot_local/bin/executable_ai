#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${TMUX_PANE:-}" ]]; then
  tmux set-option -p -t "$TMUX_PANE" @ai_cli 1
fi

ensure_ai_state_daemon() {
  command -v ai-state-daemon >/dev/null 2>&1 || return 0
  ai-state-daemon daemon >/dev/null 2>&1 &
}

run_codex_remote() {
  local socket_dir socket_path log_path server_pid bridge_pid status
  socket_dir="${XDG_RUNTIME_DIR:-/tmp}/ai-hook-notify/codex-app-server"
  mkdir -p "$socket_dir"
  socket_path="$socket_dir/codex-${TMUX_PANE:-no-tmux}-$$.sock"
  socket_path="${socket_path//%/}"
  log_path="$socket_dir/codex-$$.log"

  ensure_ai_state_daemon
  codex app-server --listen "unix://$socket_path" >"$log_path" 2>&1 &
  server_pid="$!"

  for _ in {1..50}; do
    [[ -S "$socket_path" ]] && break
    sleep 0.1
  done

  if [[ ! -S "$socket_path" ]]; then
    kill "$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
    rm -f "$socket_path" "$log_path"
    exec codex "$@"
  fi

  ai-codex-status-bridge --socket "$socket_path" &
  bridge_pid="$!"

  cleanup_codex_remote() {
    kill "$bridge_pid" "$server_pid" 2>/dev/null || true
    wait "$bridge_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
    rm -f "$socket_path" "$log_path"
  }
  trap cleanup_codex_remote EXIT HUP INT TERM

  set +e
  codex --remote "unix://$socket_path" "$@"
  status="$?"
  set -e
  cleanup_codex_remote
  trap - EXIT HUP INT TERM
  return "$status"
}

if [[ "${1:-}" == "--continue" ]] && command -v codex >/dev/null 2>&1; then
  shift
  run_codex_remote resume --last "$@"
  exit "$?"
fi

if command -v codex >/dev/null 2>&1; then
  run_codex_remote "$@"
  exit "$?"
fi

exec pi "$@"
