#!/usr/bin/env bash
set -euo pipefail

project="${1:-}"
[[ -n "$project" ]] || exit 0

if tmuxinator-chezmoi resolve "$project" >/dev/null 2>&1; then
  tmux display-message "Project already exists: $project" 2>/dev/null || printf 'Project already exists: %s\n' "$project"
  exit 0
fi

path="$(tmuxinator-chezmoi prepare-new "$project")"
session="tmuxinator-new-$project"
if tmux has-session -t "$session" 2>/dev/null; then
  tmux switch-client -t "$session"
  exit 0
fi

edit_dir="$(dirname "$path")"
tmux new-session -d -s "$session" -n "$project" -c "$edit_dir" "nvim $(printf '%q' "$path")"
tmux split-window -h -t "$session:1" -c "$edit_dir" "pi"
tmux select-pane -t "$session:1.1"
tmux switch-client -t "$session"
