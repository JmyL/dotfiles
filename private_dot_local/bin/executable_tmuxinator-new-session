#!/usr/bin/env bash
set -euo pipefail

project="${1:-}"
[[ -n "$project" ]] || exit 0

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/tmuxinator"
mkdir -p "$config_dir"

session="tmuxinator-new-$project"
if tmux has-session -t "$session" 2>/dev/null; then
  tmux switch-client -t "$session"
  exit 0
fi

editor="${EDITOR:-nvim}"
if tmuxinator-chezmoi is-work "$project"; then
  create_cmd=$(printf 'tmuxinator-chezmoi prepare-new %q && %q "$(tmuxinator-chezmoi yaml-path %q)" && tmuxinator-chezmoi track-add %q' \
    "$project" "$editor" "$project" "$project")
else
  create_cmd=$(printf 'tmuxinator new %q && tmuxinator-chezmoi track-add %q' "$project" "$project")
fi

tmux new-session -d -s "$session" -n "$project" -c "$config_dir" "bash -lc $(printf %q "$create_cmd")"
tmux split-window -h -t "$session:1" -c "$config_dir" "pi"
tmux select-pane -t "$session:1.1"
tmux switch-client -t "$session"
