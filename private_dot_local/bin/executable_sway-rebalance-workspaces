#!/usr/bin/env python3
"""Assign workspaces to main (external) vs secondary (eDP) when both are active.

Main (external): 1-5
Secondary (laptop): 6-10

No-op when only one output is active.

Important: enabling eDP makes Sway create some empty workspace on it. Moving
that empty "main" workspace away just makes Sway create another. Seed a
secondary workspace onto eDP first, then move misplaced main workspaces off.
"""
from __future__ import annotations

import json
import subprocess
import sys

MAIN_WORKSPACES = (1, 2, 3, 4, 5)
SECONDARY_WORKSPACES = (6, 7, 8, 9, 10)
SEED_SECONDARY = 6


def run(*args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(args, check=True, text=True, capture_output=True)


def sway(cmd: str) -> subprocess.CompletedProcess[str]:
    # Pass the whole command as one argument so flags like
    # --no-auto-back-and-forth are parsed by sway, not swaymsg.
    return subprocess.run(["swaymsg", cmd], capture_output=True, text=True)


def workspaces() -> list[dict]:
    return json.loads(run("swaymsg", "-t", "get_workspaces").stdout)


def focused_name(items: list[dict] | None = None) -> str:
    items = items if items is not None else workspaces()
    return next(item["name"] for item in items if item.get("focused"))


def ensure_secondary_on_internal(internal: str, restore: str) -> None:
    items = workspaces()
    on_internal = [item for item in items if item.get("output") == internal]
    if any(item.get("num") in SECONDARY_WORKSPACES for item in on_internal):
        return

    # Prefer renaming an empty non-secondary workspace already on eDP to 6.
    empty = next(
        (
            item
            for item in on_internal
            if not item.get("representation") and item.get("num") not in SECONDARY_WORKSPACES
        ),
        None,
    )
    if empty is not None and not any(item.get("num") == SEED_SECONDARY for item in items):
        sway(f'rename workspace "{empty["name"]}" to {SEED_SECONDARY}')
        return

    sway(f"workspace --no-auto-back-and-forth number {SEED_SECONDARY}")
    sway(f"move workspace to output {internal}")
    sway(f"workspace --no-auto-back-and-forth {restore}")


def move_existing(num: int, output: str, restore: str | None) -> str | None:
    items = workspaces()
    ws = next((item for item in items if item.get("num") == num), None)
    if ws is None or ws.get("output") == output:
        return restore

    name = ws["name"]
    if ws.get("representation"):
        sway(f'[workspace="{name}"] move workspace to output {output}')
        return restore

    if restore is None:
        restore = focused_name(items)
    sway(f"workspace --no-auto-back-and-forth number {num}")
    sway(f"move workspace to output {output}")
    return restore


def main() -> int:
    outputs = json.loads(run("swaymsg", "-t", "get_outputs").stdout)
    active = [output for output in outputs if output.get("active")]
    internal = next((output for output in active if output["name"].startswith("eDP-")), None)
    external = next((output for output in active if not output["name"].startswith("eDP-")), None)
    if internal is None or external is None:
        return 0

    restore = focused_name()
    ensure_secondary_on_internal(internal["name"], restore)

    for num in MAIN_WORKSPACES:
        restore = move_existing(num, external["name"], restore) or restore
    for num in SECONDARY_WORKSPACES:
        restore = move_existing(num, internal["name"], restore) or restore

    if restore is not None:
        sway(f"workspace --no-auto-back-and-forth {restore}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
