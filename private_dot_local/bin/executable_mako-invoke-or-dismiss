#!/usr/bin/env bash
set -euo pipefail

current_id() {
  (timeout 1s makoctl list -j 2>/dev/null || printf '[]\n') |
    jq -r '
      (.data? // .notifications? // .) as $root
      | if ($root | type) == "array" and ($root | length) > 0 then
          $root[0].id
        else
          empty
        end
    '
}

invoke_mako_default() {
  local id
  id="$(current_id)"
  [[ -n "$id" ]] || return 1

  timeout 1s makoctl invoke -n "$id" default ||
    timeout 1s makoctl invoke -n "$id" ||
    true

  # If invoking had no effect, treat Enter as an acknowledgement and dismiss it.
  sleep 0.1
  if [[ "$(current_id)" == "$id" ]]; then
    timeout 1s makoctl dismiss --no-history -n "$id" || true
  fi
}

invoke_mako_default || true
