#!/usr/bin/env bash
set -euo pipefail

current_id() {
  (makoctl list -j 2>/dev/null || printf '[]\n') |
    jq -r '
      (.data? // .notifications? // .) as $root
      | if ($root | type) == "array" and ($root | length) > 0 then
          $root[0].id
        else
          empty
        end
    '
}

id="$(current_id)"
[[ -n "$id" ]] || exit 0

makoctl invoke -n "$id" || true

# If invoking had no effect, treat Enter as an acknowledgement and dismiss it.
sleep 0.1
if [[ "$(current_id)" == "$id" ]]; then
  makoctl dismiss -n "$id"
fi
