#!/usr/bin/env bash
# Fired by the tmux pane-focus-out hook. Notifies when focus moves away from
# a pane running any ai cli (marked via @ai_cli, set by the `ai` wrapper) to
# another pane, but only for an in-terminal wander-off: switching to a
# different tmux session, or away from the terminal window entirely (e.g.
# alt-tabbing to a browser on another workspace), is a deliberate context
# switch the user is already aware of, so both cases are skipped.
set -uo pipefail

ai_cli="${1:-}" cmd="${2:-}" sid="${3:-}" sname="${4:-}" widx="${5:-}" pidx="${6:-}"

[[ -n "$ai_cli" ]] || exit 0
[[ -n "$sid" && -n "$sname" ]] || exit 0

current_session="$(tmux list-clients -F '#{client_activity} #{session_name}' 2>/dev/null \
                    | sort -rn | head -n1 | awk '{print $2}')"
[[ "$current_session" == "$sname" ]] || exit 0

if command -v swaymsg >/dev/null 2>&1; then
  best_tty="$(tmux list-clients -t "$sid" -F '#{client_activity} #{client_tty}' 2>/dev/null \
              | sort -rn | head -n1 | awk '{print $2}')"
  [[ -n "$best_tty" ]] && ! sway-tty-window --is-focused "$best_tty" && exit 0
fi

target="${sid}:${widx}.${pidx}"

setsid -f claude-notify-and-goto "$target" "Claude" "Left the ${cmd} pane (${sname}:${widx}.${pidx})" \
  < /dev/null > /dev/null 2>&1 &

exit 0
