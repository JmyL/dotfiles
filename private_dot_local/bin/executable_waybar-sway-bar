#!/usr/bin/env bash
# Sway bar client wrapper: run waybar and restart it if it exits.
#
# Sway does not respawn swaybar_command after exit. Login-time kanshi output
# reshuffles can race the first start so the bar never appears until reload.
# Keep this as the only Waybar launcher (bar { swaybar_command … }); do not
# also exec waybar from Sway config.
#
# swaybar_command must be an absolute path — Sway does not expand ~ or $HOME.
set -euo pipefail

waybar_bin="$(command -v waybar)" || exit 1
pidfile="${XDG_RUNTIME_DIR:-/tmp}/waybar-sway-bar.pid"

# Waybar treats missing @import targets as fatal. These files are runtime state
# written by helper scripts, so seed empty defaults before the first launch.
for state in \
  "$HOME/.cache/calendar-alert/waybar-state.css" \
  "$HOME/.cache/sway-recording/waybar-state.css"; do
  mkdir -p "$(dirname "$state")"
  [[ -e "$state" ]] || : >"$state"
done

# Replace a leftover wrapper (e.g. after killall waybar) so reload cannot
# stack a second bar client.
if [[ -f "$pidfile" ]]; then
  old="$(cat "$pidfile" 2>/dev/null || true)"
  if [[ -n "${old:-}" && "$old" -ne $$ ]] && kill -0 "$old" 2>/dev/null; then
    kill "$old" 2>/dev/null || true
    for ((i=0; i<20; i++)); do
      kill -0 "$old" 2>/dev/null || break
      sleep 0.05
    done
  fi
  rm -f "$pidfile"
fi
echo $$ >"$pidfile"

child=
cleanup() {
  if [[ -n "${child:-}" ]]; then
    kill "$child" 2>/dev/null || true
    wait "$child" 2>/dev/null || true
  fi
  rm -f "$pidfile"
  exit 0
}
trap cleanup TERM INT HUP

wait_for_active_output() {
  local i
  for ((i=0; i<50; i++)); do
    if swaymsg -t get_outputs 2>/dev/null | grep -q '"active": true'; then
      return 0
    fi
    sleep 0.1
  done
  return 1
}

wait_for_active_output || true

while true; do
  "$waybar_bin" "$@" &
  child=$!
  wait "$child" || true
  child=
  sleep 0.3
done
