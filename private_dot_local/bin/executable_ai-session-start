#!/usr/bin/env bash
# SessionStart hook: marks this pane as an AI-agent pane without setting a busy state.
set -uo pipefail

agent="${1:-ai}"
cat >/dev/null

source "$HOME/.local/bin/ai-attention-common"
ai_attention_locate
[[ -n "$target" ]] && ai_runtime_state_write idle "$agent" "$target" "$PWD" ""

[[ -n "${TMUX_PANE:-}" ]] || exit 0

dev-launcher tmux set-option -p -t "$TMUX_PANE" @ai_cli 1

exit 0
