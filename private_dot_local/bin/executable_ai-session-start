#!/usr/bin/env bash
# SessionStart hook: marks this pane as an AI-agent pane without setting a busy state.
set -uo pipefail

agent="${1:-ai}"
payload="$(cat)"

source "$HOME/.local/bin/ai-attention-common"
ai_attention_locate
if [[ -n "$target" ]]; then
  ai_runtime_state_write idle "$agent" "$target" "$PWD" ""
  if [[ "$agent" == "codex" ]]; then
    session_id="$(printf '%s' "$payload" | ai_codex_session_id_from_payload)"
    ai_codex_session_map_write "$session_id" "$agent" "$target" "$PWD" ""
  fi
fi

[[ -n "${TMUX_PANE:-}" ]] || exit 0

dev-launcher tmux set-option -p -t "$TMUX_PANE" @ai_cli 1

exit 0
