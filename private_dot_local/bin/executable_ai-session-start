#!/usr/bin/env bash
# SessionStart hook: marks this pane as an AI-agent pane without setting a busy state.
set -uo pipefail

agent="${1:-ai}"
payload="$(cat)"

source "$HOME/.local/bin/ai-attention-common"
ai_attention_locate
if [[ -n "$target" ]]; then
  if [[ "$agent" == "codex" ]]; then
    session_id="$(printf '%s' "$payload" | ai_codex_session_id_from_payload)"
    transcript_path="$(printf '%s' "$payload" | python3 -c 'import json,sys; 
try:
    payload=json.load(sys.stdin)
except Exception:
    payload={}
value=payload.get("transcript_path") or payload.get("transcriptPath") or ""
print(value if isinstance(value,str) else "")' 2>/dev/null)"
    ai-state-daemon report-session --agent "$agent" --target "$target" --cwd "$PWD" --session-id "$session_id" --transcript-path "$transcript_path" >/dev/null 2>&1 || true
  else
    ai-state-daemon report-session --agent "$agent" --target "$target" --cwd "$PWD" >/dev/null 2>&1 || true
  fi
fi

[[ -n "${TMUX_PANE:-}" ]] || exit 0

dev-launcher tmux set-option -p -t "$TMUX_PANE" @ai_cli 1

exit 0
