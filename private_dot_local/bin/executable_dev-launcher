#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "usage: dev-launcher COMMAND [ARG ...]" >&2
  exit 2
fi

if [[ -z "${SYSTEM_DEV_TOOLBOX:-}" && -d "$HOME/.bashrc.local.d" ]]; then
  for rc in "$HOME"/.bashrc.local.d/*; do
    [[ -f "$rc" ]] && source "$rc"
  done
  unset rc
fi

# Commands launched by sway inherit sway's own environment, not a login
# shell's, so $HOME/.local/bin (uv, etc.) is missing from PATH.
if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
  PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi
export PATH

if [[ -n "${SYSTEM_DEV_TOOLBOX:-}" && ! -r /run/.containerenv ]]; then
  if ! command -v toolbox >/dev/null 2>&1; then
    echo "dev-launcher: SYSTEM_DEV_TOOLBOX is set but toolbox is not available" >&2
    exit 127
  fi
  toolbox_env=(env "SYSTEM_DEV_TOOLBOX=$SYSTEM_DEV_TOOLBOX")
  if [[ -v TMUX_GOTO_PANE_SKIP_TTYS ]]; then
    toolbox_env+=("TMUX_GOTO_PANE_SKIP_TTYS=$TMUX_GOTO_PANE_SKIP_TTYS")
  fi
  if [[ -v TMUX_GOTO_PANE_SKIP_CLIENT_PIDS ]]; then
    toolbox_env+=("TMUX_GOTO_PANE_SKIP_CLIENT_PIDS=$TMUX_GOTO_PANE_SKIP_CLIENT_PIDS")
  fi
  if [[ -v TMUX_GOTO_PANE_TARGET_SWAY_CON ]]; then
    toolbox_env+=("TMUX_GOTO_PANE_TARGET_SWAY_CON=$TMUX_GOTO_PANE_TARGET_SWAY_CON")
  fi
  exec toolbox run -c "$SYSTEM_DEV_TOOLBOX" "${toolbox_env[@]}" "$@"
fi

exec "$@"
