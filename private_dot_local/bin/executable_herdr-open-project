#!/usr/bin/env bash
# Focus an existing "project: <name>" workspace, or create one like Navigator.
# --worktree matches herdr-plus picker ctrl+g: create a git worktree from the
# project's working_dir. Without --branch, prompt like the plus branch window
# (empty input lets herdr generate worktree/...).
set -euo pipefail

herdr_bin="${HERDR:-herdr}"
projects_dir="${HERDR_PLUS_PROJECTS_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/herdr/plugins/config/cloudmanic.herdr-plus/projects}"
plus_root="${HERDR_PLUS_ROOT:-$(dirname "$projects_dir")}"

usage() {
  cat >&2 <<'EOF'
Usage: herdr-open-project [--worktree] [--branch <name>] <project-name>
EOF
  exit 2
}

herdr_cmd() {
  "$herdr_bin" "$@"
}

expand_working_dir() {
  local path="$1"
  case "$path" in
  "")
    printf '%s\n' "$HOME"
    ;;
  '~')
    printf '%s\n' "$HOME"
    ;;
  '~/'*)
    printf '%s\n' "$HOME/${path#"~/"}"
    ;;
  *)
    printf '%s\n' "${path//\$HOME/$HOME}"
    ;;
  esac
}

resolve_project() {
  local name="$1"
  python3 - "$projects_dir" "$name" <<'PY'
import json
import sys
import tomllib
from pathlib import Path

projects_dir = Path(sys.argv[1])
wanted = sys.argv[2]
if not projects_dir.is_dir():
    print(f"herdr-plus projects directory not found: {projects_dir}", file=sys.stderr)
    raise SystemExit(1)

projects = []
for path in sorted(projects_dir.glob("*.toml")):
    try:
        data = tomllib.loads(path.read_text())
    except (OSError, tomllib.TOMLDecodeError) as error:
        print(f"failed to read {path}: {error}", file=sys.stderr)
        raise SystemExit(1)
    name = str(data.get("name") or "").strip()
    if not name:
        continue
    tabs = []
    for tab in data.get("tabs") or []:
        panes = list(tab.get("panes") or [])
        if not panes:
            panes = [{"command": tab.get("command"), "split": None, "label": None}]
        tabs.append(
            {
                "name": str(tab.get("name") or name),
                "panes": [
                    {
                        "command": pane.get("command"),
                        "split": pane.get("split"),
                        "label": pane.get("label"),
                    }
                    for pane in panes
                ],
            }
        )
    projects.append(
        {
            "name": name,
            "working_dir": str(data.get("working_dir") or ""),
            "tabs": tabs,
        }
    )

chosen = next((p for p in projects if p["name"] == wanted), None)
if chosen is None:
    chosen = next((p for p in projects if p["name"].lower() == wanted.lower()), None)
if chosen is None:
    names = ", ".join(p["name"] for p in projects) or "(none)"
    print(f"no project named {wanted!r}; available: {names}", file=sys.stderr)
    raise SystemExit(1)
print(json.dumps(chosen))
PY
}

find_existing_workspace() {
  local name="$1"
  herdr_cmd workspace list |
    jq -r --arg label "project: $name" '
      .result.workspaces[]?
      | select(.label == $label)
      | .workspace_id' |
    head -n 1
}

bootstrap_tabs() {
  local workspace_id="$1"
  local root_pane="$2"
  local cwd="$3"
  local project_json="$4"
  HERDR_PROJECT_JSON="$project_json" python3 - "$herdr_bin" "$workspace_id" "$root_pane" "$cwd" <<'PY'
import json
import os
import subprocess
import sys

herdr, workspace_id, root_pane, cwd = sys.argv[1:5]
project = json.loads(os.environ["HERDR_PROJECT_JSON"])


def run(*args):
    subprocess.run([herdr, *args], check=True)


def herdr_json(*args):
    out = subprocess.check_output([herdr, *args])
    return json.loads(out)


for tab_index, tab in enumerate(project.get("tabs") or []):
    if tab_index == 0:
        run("tab", "rename", f"{workspace_id}:t1", tab["name"])
        tab_root = root_pane
    else:
        created = herdr_json(
            "tab",
            "create",
            "--workspace",
            workspace_id,
            "--cwd",
            cwd,
            "--label",
            tab["name"],
            "--no-focus",
        )
        tab_root = created["result"]["root_pane"]["pane_id"]

    previous = tab_root
    runs = []
    for pane_index, pane in enumerate(tab.get("panes") or []):
        if pane_index == 0:
            pane_id = tab_root
        else:
            direction = pane.get("split") or "down"
            split = herdr_json(
                "pane",
                "split",
                previous,
                "--direction",
                direction,
                "--no-focus",
            )
            pane_id = split["result"]["pane"]["pane_id"]
        label = (pane.get("label") or "").strip()
        if label:
            run("pane", "rename", pane_id, label)
        command = (pane.get("command") or "").strip()
        if command:
            runs.append((pane_id, command))
        previous = pane_id

    for pane_id, command in runs:
        run("pane", "run", pane_id, command)
PY
}

as_worktree=0
branch_set=0
branch=""
name=""
while [[ $# -gt 0 ]]; do
  case "$1" in
  --worktree)
    as_worktree=1
    shift
    ;;
  --branch)
    [[ $# -ge 2 ]] || usage
    branch_set=1
    branch="$2"
    shift 2
    ;;
  -h | --help)
    usage
    ;;
  -*)
    printf 'unknown option: %s\n' "$1" >&2
    usage
    ;;
  *)
    if [[ -n "$name" ]]; then
      usage
    fi
    name="$1"
    shift
    ;;
  esac
done
[[ -n "${name// /}" ]] || usage

if ((as_worktree == 0)); then
  existing="$(find_existing_workspace "$name")"
  if [[ -n "$existing" ]]; then
    herdr_cmd workspace focus "$existing"
    exit 0
  fi
fi

project_json="$(resolve_project "$name")"
working_dir="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["working_dir"])' "$project_json")"
working_dir="$(expand_working_dir "$working_dir")"
if [[ ! -d "$working_dir" ]]; then
  printf 'working directory does not exist: %s\n' "$working_dir" >&2
  exit 1
fi
working_dir="$(realpath "$working_dir")"
name="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["name"])' "$project_json")"

if ((as_worktree)); then
  if ((branch_set == 0)); then
    if [[ ! -t 0 ]]; then
      printf 'need a terminal to prompt for the worktree branch\n' >&2
      exit 1
    fi
    IFS= read -r -p "${name} worktree: " branch || exit 1
  fi
  branch="$(
    python3 - "$plus_root/config.toml" "$branch" <<'PY'
import sys
import tomllib
from pathlib import Path

config_path = Path(sys.argv[1])
branch = sys.argv[2].strip()
prefix = ""
if config_path.is_file():
    data = tomllib.loads(config_path.read_text())
    prefix = str((data.get("worktree") or {}).get("branch_prefix") or "")
if branch and prefix and "/" not in branch:
    branch = prefix + branch
print(branch)
PY
  )"
  if [[ -n "$branch" ]]; then
    herdr_cmd worktree create --cwd "$working_dir" --branch "$branch" --focus >/dev/null
  else
    herdr_cmd worktree create --cwd "$working_dir" --focus >/dev/null
  fi
  exit 0
fi

created="$(
  herdr_cmd workspace create \
    --cwd "$working_dir" \
    --label "project: $name" \
    --focus
)"
workspace_id="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["result"]["workspace"]["workspace_id"])' "$created")"
root_pane="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["result"]["root_pane"]["pane_id"])' "$created")"
if [[ -z "$workspace_id" || "$workspace_id" == null || -z "$root_pane" || "$root_pane" == null ]]; then
  printf 'workspace create did not return ids: %s\n' "$created" >&2
  exit 1
fi
bootstrap_tabs "$workspace_id" "$root_pane" "$working_dir" "$project_json"
