#!/usr/bin/env bash
set -euo pipefail

# Convert slack:// deep links to app.slack.com so they always open in a browser
# instead of a Slack desktop app (or failing when none is installed).
slack_to_browser_url() {
  local url="$1"
  local rest host query team="" id="" message="" pair key val

  rest="${url#slack://}"
  if [[ "$rest" == *\?* ]]; then
    host="${rest%%\?*}"
    query="${rest#*\?}"
  else
    host="$rest"
    query=""
  fi
  host="${host%%/*}"

  if [[ -n "$query" ]]; then
    local -a pairs
    IFS='&' read -ra pairs <<< "$query"
    for pair in "${pairs[@]}"; do
      key="${pair%%=*}"
      val="${pair#*=}"
      case "$key" in
      team) team="$val" ;;
      id) id="$val" ;;
      message) message="$val" ;;
      esac
    done
  fi

  case "$host" in
  channel | user | file | app)
    if [[ -n "$team" && -n "$id" ]]; then
      if [[ -n "$message" ]]; then
        if [[ "$message" != p* ]]; then
          message="p${message//./}"
        fi
        printf 'https://app.slack.com/client/%s/%s/%s\n' "$team" "$id" "$message"
        return
      fi
      printf 'https://app.slack.com/client/%s/%s\n' "$team" "$id"
      return
    fi
    ;;
  open)
    if [[ -n "$team" ]]; then
      printf 'https://app.slack.com/client/%s\n' "$team"
      return
    fi
    ;;
  esac

  if [[ -n "$team" ]]; then
    printf 'https://app.slack.com/client/%s\n' "$team"
    return
  fi

  printf 'https://app.slack.com/\n'
}

if [[ "${1-}" == slack://* ]]; then
  set -- "$(slack_to_browser_url "$1")" "${@:2}"
fi

# If running inside a container (toolbox/docker) and flatpak-spawn is available,
# delegate URL opening to the host system.
if [[ -f /run/.containerenv || -f /.dockerenv ]]; then
  if command -v flatpak-spawn >/dev/null 2>&1; then
    exec flatpak-spawn --host xdg-open "$@"
  fi
fi

# Otherwise use normal xdg-open.
exec xdg-open "$@"
