#!/usr/bin/env bash
set -euo pipefail

action="${1:-}"
project="${2:-}"
dir="${XDG_CONFIG_HOME:-$HOME/.config}/tmuxinator"

clear_screen() {
  tput clear 2>/dev/null || printf '\033[2J\033[H'
}

trap clear_screen EXIT
clear_screen

pause() {
  printf 'Press Enter to continue... '
  read -r _ || true
}

require_project() {
  if [[ -z "$project" || ! -f "$dir/$project.yml" ]]; then
    printf 'Project not found: %s\n' "$project"
    pause
    exit 1
  fi
}

read_new_name() {
  local prompt="$1" new="${2:-}" ch
  printf '%s%s' "$prompt" "$new" >&2
  while IFS= read -rsn1 ch; do
    case "$ch" in
      $'\e') printf '\n' >&2; return 1 ;;
      $'\177'|$'\b')
        if [[ -n "$new" ]]; then
          new="${new%?}"
          printf '\b \b' >&2
        fi
        ;;
      $'\n'|'') printf '\n' >&2; break ;;
      *)
        new+="$ch"
        printf '%s' "$ch" >&2
        ;;
    esac
  done
  [[ -n "$new" ]] || return 1
  if [[ "$new" == */* || "$new" == .* ]]; then
    printf 'Invalid project name: %s\n' "$new" >&2
    pause
    exit 1
  fi
  if [[ -e "$dir/$new.yml" ]]; then
    printf '%s already exists\n' "$new" >&2
    pause
    exit 1
  fi
  printf '%s' "$new"
}

set_project_name() {
  local file="$1" name="$2"
  if grep -q '^name:' "$file"; then
    sed -i "1,/^name:/s/^name:.*/name: $name/" "$file"
  else
    tmp="$(mktemp)"
    { printf 'name: %s\n' "$name"; cat "$file"; } > "$tmp"
    cat "$tmp" > "$file"
    rm -f "$tmp"
  fi
}

confirm() {
  local prompt="$1" answer
  printf '%s (y/n) ' "$prompt"
  while IFS= read -rsn1 answer; do
    case "$answer" in
      [Yy]) printf 'y\n'; return 0 ;;
      [Nn]) printf 'n\n'; return 1 ;;
      $'\n'|$'\e'|'') printf 'n\n'; return 1 ;;
    esac
  done
  return 1
}

case "$action" in
  copy)
    require_project
    new="$(read_new_name "Copy $project to: ")" || exit 0
    cp "$dir/$project.yml" "$dir/$new.yml"
    set_project_name "$dir/$new.yml" "$new"
    ;;
  rename)
    require_project
    new="$(read_new_name "Rename $project to: " "$project")" || exit 0
    mv "$dir/$project.yml" "$dir/$new.yml"
    set_project_name "$dir/$new.yml" "$new"
    ;;
  delete)
    require_project
    confirm "Delete $project?" || exit 0
    rm -f "$dir/$project.yml"
    ;;
  *)
    printf 'Usage: %s {copy|rename|delete} <project>\n' "$0"
    exit 2
    ;;
esac
