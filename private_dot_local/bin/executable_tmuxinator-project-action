#!/usr/bin/env bash
set -euo pipefail

action="${1:-}"
project="${2:-}"
dir="${XDG_CONFIG_HOME:-$HOME/.config}/tmuxinator"

clear_screen() {
  tput clear 2>/dev/null || printf '\033[2J\033[H'
}

trap clear_screen EXIT
clear_screen

pause() {
  printf 'Press Enter to continue... '
  read -r _ || true
}

require_project() {
  if [[ -z "$project" || ! -f "$dir/$project.yml" ]]; then
    printf 'Project not found: %s\n' "$project"
    pause
    exit 1
  fi
}

read_new_name() {
  local prompt="$1" new
  if command -v fuzzel >/dev/null 2>&1 && [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
    new="$(printf '' | fuzzel --dmenu --prompt "$prompt" || true)"
  else
    printf '%s' "$prompt" >&2
    read -e -r new || exit 0
  fi
  [[ -n "$new" ]] || exit 0
  if [[ "$new" == */* || "$new" == .* ]]; then
    printf 'Invalid project name: %s\n' "$new" >&2
    pause
    exit 1
  fi
  if [[ -e "$dir/$new.yml" ]]; then
    printf '%s already exists\n' "$new" >&2
    pause
    exit 1
  fi
  printf '%s' "$new"
}

set_project_name() {
  local file="$1" name="$2"
  if grep -q '^name:' "$file"; then
    sed -i "1,/^name:/s/^name:.*/name: $name/" "$file"
  else
    tmp="$(mktemp)"
    { printf 'name: %s\n' "$name"; cat "$file"; } > "$tmp"
    cat "$tmp" > "$file"
    rm -f "$tmp"
  fi
}

confirm() {
  local prompt="$1" answer
  if command -v fuzzel >/dev/null 2>&1 && [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
    answer="$(printf 'No\nYes\n' | fuzzel --dmenu --prompt "$prompt " || true)"
    [[ "$answer" == Yes ]]
    return
  fi

  while true; do
    printf '%s [y/N] ' "$prompt"
    read -e -r answer || return 1
    case "$answer" in
      [Yy]) return 0 ;;
      [Nn]|'') return 1 ;;
      *) printf 'Please answer y or n.\n' ;;
    esac
  done
}

case "$action" in
  copy)
    require_project
    new="$(read_new_name "Copy $project to: ")"
    cp "$dir/$project.yml" "$dir/$new.yml"
    set_project_name "$dir/$new.yml" "$new"
    ;;
  rename)
    require_project
    new="$(read_new_name "Rename $project to: ")"
    mv "$dir/$project.yml" "$dir/$new.yml"
    set_project_name "$dir/$new.yml" "$new"
    ;;
  delete)
    require_project
    confirm "Delete $project?" || exit 0
    rm -f "$dir/$project.yml"
    ;;
  *)
    printf 'Usage: %s {copy|rename|delete} <project>\n' "$0"
    exit 2
    ;;
esac
