#!/usr/bin/env python3
"""Send a desktop notification with a "Go to pane" action.

Usage: ai-notify-and-goto <agent> <target> <summary> <body>
"""
import subprocess
import sys
import os
import shutil


def running_in_container():
    return os.path.exists("/run/.containerenv")


def reexec_on_host():
    if not running_in_container() or os.environ.get("AI_NOTIFY_AND_GOTO_HOST_ENTRY"):
        return
    if not shutil.which("flatpak-spawn"):
        return
    env = os.environ.copy()
    env["AI_NOTIFY_AND_GOTO_HOST_ENTRY"] = "1"
    os.execvpe(
        "flatpak-spawn",
        ["flatpak-spawn", "--host", "ai-notify-and-goto", *sys.argv[1:]],
        env,
    )


reexec_on_host()

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

BUS_NAME = "org.freedesktop.Notifications"
OBJ_PATH = "/org/freedesktop/Notifications"
IFACE = "org.freedesktop.Notifications"
ACTION_KEYS = ("default", "goto")
URGENCY_NORMAL = 1
EXPIRE_TIMEOUT_MS = 10_000
MAX_WAIT_SECONDS = 6 * 3600


def tmux_target(target: str) -> str | None:
    for segment in target.split(","):
        if segment.startswith("tmux:"):
            return segment.removeprefix("tmux:")
    if target.startswith(("sway-window:", "sway-con:")):
        return None
    if target.startswith("%") or ":" in target:
        return target
    return None


def main():
    if len(sys.argv) != 5:
        sys.exit(f"usage: {sys.argv[0]} AGENT TARGET SUMMARY BODY")
    agent, target, summary, body = sys.argv[1:5]
    app_name = agent.strip().title() or "AI Agent"

    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)

    loop = GLib.MainLoop()
    result = {"action": False}
    notif_id = {"value": None}

    def on_signal(_conn, _sender, _path, _iface, member, params):
        args = params.unpack()
        if not args or args[0] != notif_id["value"]:
            return
        if member == "ActivationToken":
            result["action"] = True
            loop.quit()
        elif member == "ActionInvoked" and len(args) > 1 and args[1] in ACTION_KEYS:
            result["action"] = True
            loop.quit()
        elif member == "NotificationClosed":
            reason = args[1] if len(args) > 1 else None
            if reason == 1:
                return
            loop.quit()

    bus.signal_subscribe(
        BUS_NAME, IFACE, None, OBJ_PATH, None, Gio.DBusSignalFlags.NONE, on_signal
    )

    reply = bus.call_sync(
        BUS_NAME,
        OBJ_PATH,
        IFACE,
        "Notify",
        GLib.Variant(
            "(susssasa{sv}i)",
            (
                app_name,
                0,
                "",
                summary,
                body,
                ["default", "Go to pane", "goto", "Go to pane"],
                {"urgency": GLib.Variant("y", URGENCY_NORMAL)},
                EXPIRE_TIMEOUT_MS,
            ),
        ),
        GLib.VariantType("(u)"),
        Gio.DBusCallFlags.NONE,
        -1,
        None,
    )
    notif_id["value"] = reply.unpack()[0]

    pane_target = tmux_target(target)
    if pane_target:
        subprocess.run(
            ["dev-launcher", "tmux", "set-option", "-p", "-t", pane_target, "@ai_notif_id", str(notif_id["value"])],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )

    GLib.timeout_add_seconds(MAX_WAIT_SECONDS, loop.quit)
    loop.run()

    if pane_target:
        subprocess.run(
            ["dev-launcher", "tmux", "set-option", "-p", "-u", "-t", pane_target, "@ai_notif_id"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )

    if result["action"]:
        subprocess.run(["ai-goto-target", target])


if __name__ == "__main__":
    main()
