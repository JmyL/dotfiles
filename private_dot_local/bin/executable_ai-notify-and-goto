#!/usr/bin/env python3
"""Send a desktop notification with a "Go to pane" action.

Usage: ai-notify-and-goto <agent> <target> <summary> <body>
"""
import json
import re
import subprocess
import sys
import os
import shutil
import time
from pathlib import Path


def running_in_container():
    return os.path.exists("/run/.containerenv")


def reexec_on_host():
    if not running_in_container() or os.environ.get("AI_NOTIFY_AND_GOTO_HOST_ENTRY"):
        return
    if not shutil.which("flatpak-spawn"):
        return
    env = os.environ.copy()
    env["AI_NOTIFY_AND_GOTO_HOST_ENTRY"] = "1"
    os.execvpe(
        "flatpak-spawn",
        ["flatpak-spawn", "--host", "ai-notify-and-goto", *sys.argv[1:]],
        env,
    )


reexec_on_host()

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

BUS_NAME = "org.freedesktop.Notifications"
OBJ_PATH = "/org/freedesktop/Notifications"
IFACE = "org.freedesktop.Notifications"
ACTION_KEYS = ("default", "goto")
URGENCY_NORMAL = 1
EXPIRE_TIMEOUT_MS = 10_000
MAX_WAIT_SECONDS = 6 * 3600


def target_segment(target: str, prefix: str) -> str | None:
    for segment in target.split(","):
        if segment.startswith(prefix):
            return segment.removeprefix(prefix)
    return None


def tmux_target(target: str) -> str | None:
    pane = target_segment(target, "tmux:")
    if pane:
        return pane
    if "," not in target and not target.startswith(("sway-window:", "sway-con:", "kitty-window:")):
        if target.startswith("%") or ":" in target:
            return target
    return None


def kitty_window_target(target: str) -> str | None:
    kitty_window_id = target_segment(target, "kitty-window:")
    if kitty_window_id and re.fullmatch(r"[0-9]+", kitty_window_id):
        return kitty_window_id
    return None


def state_dir() -> Path:
    return Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp") / "ai-hook-notify"


def state_path(kitty_window_id: str) -> Path:
    return state_dir() / f"kitty-window-{kitty_window_id}.json"


def write_kitty_state(kitty_window_id: str, notif_id: int, agent: str, target: str) -> None:
    try:
        state_dir().mkdir(mode=0o700, parents=True, exist_ok=True)
        path = state_path(kitty_window_id)
        path.write_text(
            json.dumps(
                {
                    "notif_id": notif_id,
                    "agent": agent,
                    "target": target,
                    "created_at": int(time.time()),
                },
                separators=(",", ":"),
            )
            + "\n",
            encoding="utf-8",
        )
        path.chmod(0o600)
    except OSError:
        pass


def clear_kitty_state(kitty_window_id: str | None) -> None:
    if not kitty_window_id:
        return
    try:
        state_path(kitty_window_id).unlink()
    except FileNotFoundError:
        pass
    except OSError:
        pass


def main():
    if len(sys.argv) != 5:
        sys.exit(f"usage: {sys.argv[0]} AGENT TARGET SUMMARY BODY")
    agent, target, summary, body = sys.argv[1:5]
    app_name = agent.strip().title() or "AI Agent"

    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)

    loop = GLib.MainLoop()
    result = {"action": False}
    notif_id = {"value": None}

    def on_signal(_conn, _sender, _path, _iface, member, params):
        args = params.unpack()
        if not args or args[0] != notif_id["value"]:
            return
        if member == "ActivationToken":
            result["action"] = True
            loop.quit()
        elif member == "ActionInvoked" and len(args) > 1 and args[1] in ACTION_KEYS:
            result["action"] = True
            loop.quit()
        elif member == "NotificationClosed":
            reason = args[1] if len(args) > 1 else None
            if reason == 1:
                return
            loop.quit()

    bus.signal_subscribe(
        BUS_NAME, IFACE, None, OBJ_PATH, None, Gio.DBusSignalFlags.NONE, on_signal
    )

    reply = bus.call_sync(
        BUS_NAME,
        OBJ_PATH,
        IFACE,
        "Notify",
        GLib.Variant(
            "(susssasa{sv}i)",
            (
                app_name,
                0,
                "",
                summary,
                body,
                ["default", "Go to pane", "goto", "Go to pane"],
                {"urgency": GLib.Variant("y", URGENCY_NORMAL)},
                EXPIRE_TIMEOUT_MS,
            ),
        ),
        GLib.VariantType("(u)"),
        Gio.DBusCallFlags.NONE,
        -1,
        None,
    )
    notif_id["value"] = reply.unpack()[0]

    pane_target = tmux_target(target)
    kitty_window_id = None if pane_target else kitty_window_target(target)
    if pane_target:
        subprocess.run(
            ["dev-launcher", "tmux", "set-option", "-p", "-t", pane_target, "@ai_notif_id", str(notif_id["value"])],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    elif kitty_window_id:
        write_kitty_state(kitty_window_id, notif_id["value"], agent, target)

    GLib.timeout_add_seconds(MAX_WAIT_SECONDS, loop.quit)
    loop.run()

    if pane_target:
        subprocess.run(
            ["dev-launcher", "tmux", "set-option", "-p", "-u", "-t", pane_target, "@ai_notif_id"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    else:
        clear_kitty_state(kitty_window_id)

    if result["action"]:
        subprocess.run(["ai-goto-target", target])


if __name__ == "__main__":
    main()
