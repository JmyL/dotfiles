#!/usr/bin/env python3
"""Monitor AI agent state from tmux pane options and runtime hook JSON."""
from __future__ import annotations

import argparse
import curses
import json
import os
import subprocess
import threading
import time
import unicodedata
from dataclasses import dataclass
from pathlib import Path


SPINNER = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
BLOCKED = (".", ".", ".", "!", "!", "!")
STALE_AFTER = 300
REFRESH_SECONDS = 0.15
DATA_REFRESH_SECONDS = 1.0
INPUT_POLL_MS = 30


@dataclass
class Row:
    source: str
    target: str
    state: str
    agent: str
    label: str
    cwd: str
    summary: str
    updated_at: float
    stale: bool = False
    pane_id: str = ""
    session_id: str = ""
    window_index: str = ""
    pane_index: str = ""


class RowCache:
    def __init__(self, popup: bool = False) -> None:
        self.rows: list[Row] = []
        self.refreshing = False
        self.last_refresh = 0.0
        self.lock = threading.Lock()
        self.popup = popup

    def snapshot(self) -> list[Row]:
        with self.lock:
            return list(self.rows)

    def start_refresh(self) -> None:
        with self.lock:
            if self.refreshing:
                return
            self.refreshing = True

        thread = threading.Thread(target=self._refresh, daemon=True)
        thread.start()

    def _refresh(self) -> None:
        try:
            rows = collect_rows(tmux_only=self.popup)
        except Exception:
            rows = []
        with self.lock:
            self.rows = rows
            self.last_refresh = time.monotonic()
            self.refreshing = False


def runtime_agents_dir() -> Path:
    return Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp") / "ai-hook-notify" / "agents"


def basename(path: str) -> str:
    cleaned = path.rstrip("/")
    return os.path.basename(cleaned) if cleaned else ""


def valid_state(value: object) -> str:
    state = str(value or "idle").lower()
    if state in {"busy", "blocked", "idle", "done"}:
        return state
    return "unknown"


def tmux_rows(now: float) -> list[Row]:
    fmt = "\t".join(
        [
            "#{pane_id}",
            "#{session_id}",
            "#{session_name}",
            "#{window_index}",
            "#{pane_index}",
            "#{pane_current_path}",
            "#{pane_title}",
            "#{@ai_cli}",
            "#{@ai_state}",
        ]
    )
    try:
        proc = subprocess.run(
            ["dev-launcher", "tmux", "list-panes", "-a", "-F", fmt],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    except OSError:
        return []
    if proc.returncode != 0:
        return []

    rows: list[Row] = []
    for line in proc.stdout.splitlines():
        fields = line.split("\t")
        if len(fields) != 9:
            continue
        pane_id, session_id, session, win, pane, cwd, title, ai_cli, ai_state = fields
        if not ai_cli:
            continue
        state = valid_state(ai_state or "idle")
        label = session or title or pane_id
        detail = title if title and title != "bash" else ""
        rows.append(
            Row(
                source="tmux",
                target=f"tmux:{pane_id}",
                state=state,
                agent="ai",
                label=label,
                cwd=cwd,
                summary=detail,
                updated_at=now,
                pane_id=pane_id,
                session_id=session_id,
                window_index=win,
                pane_index=pane,
            )
        )
    rows.sort(key=lambda row: (row.label.lower(), row.target))
    return rows


def runtime_rows(now: float) -> list[Row]:
    rows: list[Row] = []
    directory = runtime_agents_dir()
    try:
        paths = sorted(directory.glob("*.json"))
    except OSError:
        return rows

    for path in paths:
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        if not isinstance(data, dict):
            continue
        target = data.get("target")
        if not isinstance(target, str) or not target:
            continue
        cwd = data.get("cwd") if isinstance(data.get("cwd"), str) else ""
        label = data.get("label") if isinstance(data.get("label"), str) else ""
        updated_at = data.get("updated_at")
        try:
            updated = float(updated_at)
        except (TypeError, ValueError):
            try:
                updated = path.stat().st_mtime
            except OSError:
                updated = 0
        stale = updated <= 0 or now - updated > STALE_AFTER
        rows.append(
            Row(
                source="runtime",
                target=target,
                state=valid_state(data.get("state")),
                agent=str(data.get("agent") or "ai"),
                label=label or basename(cwd) or str(data.get("agent") or "ai"),
                cwd=cwd,
                summary=str(data.get("summary") or ""),
                updated_at=updated,
                stale=stale,
            )
        )
    rows.sort(key=lambda row: (row.label.lower(), row.target))
    return rows


def collect_rows(now: float | None = None, tmux_only: bool = False) -> list[Row]:
    current = time.time() if now is None else now
    rows = tmux_rows(current)
    if tmux_only:
        return rows
    seen = {row.target for row in rows}
    for row in runtime_rows(current):
        if row.target in seen:
            continue
        if any(segment.startswith("tmux:") and segment in seen for segment in row.target.split(",")):
            continue
        rows.append(row)
        seen.add(row.target)
    return rows


def glyph(row: Row, tick: int) -> str:
    if row.stale or row.state == "unknown":
        return "?"
    if row.state == "busy":
        return SPINNER[tick % len(SPINNER)]
    if row.state == "blocked":
        return BLOCKED[tick % len(BLOCKED)]
    if row.state == "done":
        return "●"
    return "✓"


def color_for(row: Row) -> int:
    if row.stale or row.state == "unknown":
        return 5
    return {"busy": 1, "blocked": 2, "idle": 3, "done": 4}.get(row.state, 5)


def char_width(char: str) -> int:
    if unicodedata.combining(char):
        return 0
    if unicodedata.east_asian_width(char) in {"F", "W"}:
        return 2
    return 1


def display_width(text: str) -> int:
    return sum(char_width(char) for char in text)


def fit(text: str, width: int) -> str:
    if width <= 0:
        return ""
    clean = " ".join(text.split())
    if display_width(clean) <= width:
        return clean
    if width <= 3:
        return "." * width

    limit = width - 3
    used = 0
    chars = []
    for char in clean:
        char_columns = char_width(char)
        if used + char_columns > limit:
            break
        chars.append(char)
        used += char_columns
    return "".join(chars).rstrip() + "..."


def pad(text: str, width: int) -> str:
    clipped = fit(text, width)
    return clipped + (" " * max(0, width - display_width(clipped)))


def goto_target(target: str) -> None:
    subprocess.run(["ai-goto-target", target], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def focus_tmux_row(row: Row) -> None:
    if not row.pane_id or not row.session_id or not row.window_index:
        return

    subprocess.run(
        ["dev-launcher", "tmux", "switch-client", "-t", row.session_id],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    subprocess.run(
        ["dev-launcher", "tmux", "select-window", "-t", f"{row.session_id}:{row.window_index}"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    subprocess.run(
        ["dev-launcher", "tmux", "select-pane", "-t", row.pane_id],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def draw(stdscr, rows: list[Row], tick: int) -> None:
    height, width = stdscr.getmaxyx()
    stdscr.erase()
    title = "AI agents"
    help_text = "number: focus  r: refresh  q: quit"
    stdscr.addstr(0, 0, fit(title, width), curses.A_BOLD)
    if width > len(help_text) + 2:
        stdscr.addstr(0, max(0, width - len(help_text)), help_text, curses.A_DIM)
    if not rows:
        stdscr.addstr(2, 0, fit("No AI agents found.", width), curses.A_DIM)
        stdscr.refresh()
        return

    for index, row in enumerate(rows[: max(0, height - 2)], start=1):
        y = index + 1
        number = str(index % 10)
        state = "stale" if row.stale else row.state
        marker = glyph(row, tick)
        prefix = f"{number} "
        stdscr.addstr(y, 0, prefix, curses.A_BOLD)
        stdscr.addstr(y, len(prefix), f"{marker:<2}", curses.color_pair(color_for(row)) | curses.A_BOLD)
        x = len(prefix) + 3
        stdscr.addstr(y, x, fit(f"{state:<7} ", max(0, width - x)), curses.color_pair(color_for(row)))
        x += 8
        label = pad(f"{row.agent}:{row.label}", 24)
        detail = row.summary or row.cwd or row.target
        text = f"{label} {detail}"
        stdscr.addstr(y, x, fit(text, max(0, width - x)))
    stdscr.refresh()


def curses_main(stdscr, popup: bool) -> int:
    curses.curs_set(0)
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_YELLOW, -1)
    curses.init_pair(2, curses.COLOR_RED, -1)
    curses.init_pair(3, curses.COLOR_BLUE, -1)
    curses.init_pair(4, curses.COLOR_GREEN, -1)
    curses.init_pair(5, curses.COLOR_WHITE, -1)
    stdscr.timeout(INPUT_POLL_MS)
    tick = 0
    cache = RowCache(popup=popup)
    cache.start_refresh()
    next_frame = 0.0
    next_data_refresh = 0.0
    while True:
        now = time.monotonic()
        if now >= next_data_refresh:
            cache.start_refresh()
            next_data_refresh = now + DATA_REFRESH_SECONDS
        if now >= next_frame:
            rows = cache.snapshot()
            draw(stdscr, rows, tick)
            tick += 1
            next_frame = now + REFRESH_SECONDS

        key = stdscr.getch()
        if key in (ord("q"), 27):
            return 0
        if key == ord("r"):
            cache.start_refresh()
            next_data_refresh = time.monotonic() + DATA_REFRESH_SECONDS
            continue
        if ord("0") <= key <= ord("9"):
            rows = cache.snapshot()
            selected = 10 if key == ord("0") else key - ord("0")
            if 1 <= selected <= len(rows):
                if popup:
                    focus_tmux_row(rows[selected - 1])
                    return 0
                goto_target(rows[selected - 1].target)
            cache.start_refresh()
            next_data_refresh = time.monotonic() + DATA_REFRESH_SECONDS


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--popup", action="store_true")
    args = parser.parse_args()
    return curses.wrapper(curses_main, args.popup)


if __name__ == "__main__":
    raise SystemExit(main())
