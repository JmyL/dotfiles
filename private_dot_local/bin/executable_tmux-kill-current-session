#!/usr/bin/env bash
set -euo pipefail

target="${1:-}"
[[ -n "$target" ]] || target="$(tmux display-message -p '#{session_id}' 2>/dev/null || true)"

if [[ -z "$target" ]]; then
  tmux display-message -d 1000 "No session to kill" 2>/dev/null || true
  exit 1
fi

next_session="$(
  tmux list-sessions -F '#{session_id}' 2>/dev/null |
    awk -v target="$target" '$0 != target { print; exit }'
)"

if [[ -n "$next_session" ]] && tmux switch-client -t "$next_session"; then
  tmux kill-session -t "$target"
else
  tmux display-message -d 1000 "Only one session" 2>/dev/null || true
fi
