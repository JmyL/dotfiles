#!/usr/bin/env bash
# Emergency display recovery after suspend/resume black screens.
#
# kanshi's docked profiles disable eDP when an external is connected, so if
# modeset on HDMI/DP is wedged the laptop panel stays dark. Stop kanshi first,
# then force the internal panel on and disable externals.
#
# --quiet: skip the notification (used by swayidle after-resume).
# --blank-externals: power off HDMI/DP instead of disable.
# --power-on-externals: keep HDMI/DP enabled and on (lock screen on both).
set -euo pipefail

swaymsg_bin="${SWAYMSG:-swaymsg}"
pkill_bin="${PKILL:-pkill}"

quiet=0
blank_externals=0
power_on_externals=0
for arg in "$@"; do
  case $arg in
  --quiet) quiet=1 ;;
  --blank-externals) blank_externals=1 ;;
  --power-on-externals) power_on_externals=1 ;;
  esac
done

"$pkill_bin" -x kanshi 2>/dev/null || true

mapfile -t outputs < <("$swaymsg_bin" -t get_outputs -r | jq -r '.[].name')

for name in "${outputs[@]}"; do
  if [[ "$name" == eDP-* ]]; then
    # Sway wants "position 0 0"; kanshi's "0,0" is a parse error here.
    "$swaymsg_bin" output "$name" enable power on position 0 0 || true
  elif ((power_on_externals)); then
    "$swaymsg_bin" output "$name" enable power on || true
  elif ((blank_externals)); then
    "$swaymsg_bin" output "$name" enable power off || true
  else
    "$swaymsg_bin" output "$name" disable || true
  fi
done

if ((blank_externals == 0 && power_on_externals == 0)); then
  "$swaymsg_bin" 'output * power on' || true
fi

if ((quiet == 0)) && command -v notify-send >/dev/null 2>&1; then
  notify-send 'Display recovery' \
    'Forced laptop panel on; kanshi stopped. Unplug HDMI or Super+Shift+r to restart kanshi.'
fi
