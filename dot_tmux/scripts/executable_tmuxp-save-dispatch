#!/usr/bin/env bash
set -euo pipefail

session_name="${1:?session name required}"
pane_path="${2:?pane path required}"
target_pane="${3:-}"

# Saving a named home session is non-interactive: do it without opening a popup.
if [[ "$pane_path" = "$HOME" && ! "$session_name" =~ ^[0-9]+$ ]]; then
  "$HOME/.tmux/scripts/tmuxp-save" "$session_name" "$pane_path" "$target_pane"
else
  tmux display-popup -E -w 80% -h 60% \
    "$HOME/.tmux/scripts/tmuxp-save \"$session_name\" \"$pane_path\" \"$target_pane\"" || true
fi
