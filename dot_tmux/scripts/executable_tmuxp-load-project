#!/usr/bin/env bash
set -euo pipefail

source "$HOME/.tmux/scripts/tmuxp-common"

roots=("$HOME/Projects" "$HOME/Dropbox" "$HOME")

file="$({
  for root in "${roots[@]}"; do
    [ -d "$root" ] || continue
    find "$root" -path "$HOME/.cache" -prune -o \
      -path "$HOME/.local" -prune -o \
      -path "$HOME/.var" -prune -o \
      -path "$HOME/.dropbox-dist" -prune -o \
      -type f \( -name '.tmuxp.yaml' -o -name '.tmuxp.yml' -o -name 'tmuxp.yaml' -o -name 'tmuxp.yml' \) -print 2>/dev/null
  done
} | sort -u | fzf --prompt='project tmuxp > ' --height=80% --reverse)"

load_workspace "$file"
