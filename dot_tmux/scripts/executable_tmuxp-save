#!/usr/bin/env bash
set -euo pipefail

session_name="${1:?session name required}"
pane_path="${2:?pane path required}"
target_pane="${3:-}"

# Older direct display-popup bindings pass tmux formats literally. If that
# happens, fall back to querying the original pane when it was provided.
if [[ "$session_name" == '#{'* && -n "$target_pane" && "$target_pane" != '#{'* ]]; then
  session_name="$(tmux display-message -p -t "$target_pane" '#{session_name}')"
fi
if [[ "$pane_path" == '#{'* && -n "$target_pane" && "$target_pane" != '#{'* ]]; then
  pane_path="$(tmux display-message -p -t "$target_pane" '#{pane_current_path}')"
fi

if [[ "$pane_path" = "$HOME" && "$session_name" =~ ^[0-9]+$ ]]; then
  read -r -e -p "Rename session: " new_session_name
  [ -n "$new_session_name" ] || exit 0
  tmux rename-session -t "$session_name:" "$new_session_name"
  session_name="$new_session_name"
fi

safe_session_name="$(printf '%s' "$session_name" | tr '[:space:]/' '_' | tr -s '_')"
short_path() {
  case "$1" in
    "$HOME") printf '~' ;;
    "$HOME"/*) printf '~/%s' "${1#"$HOME"/}" ;;
    *) printf '%s' "$1" ;;
  esac
}
mkdir -p "$HOME/.tmuxp"

remembered="$(tmux show-option -t "$session_name:" -qv @tmuxp_config_path 2>/dev/null || true)"
if [ -n "$remembered" ]; then
  target="$remembered"
else
  default_global="$HOME/.tmuxp/${safe_session_name}.yaml"
  default_project="$pane_path/.tmuxp.yaml"
  display_global="$(short_path "$default_global")"
  display_project="$(short_path "$default_project")"

  if [ "$pane_path" = "$HOME" ]; then
    target="$default_global"
  else
    choices="$(printf '%s\n%s\n' \
      "project: $display_project" \
      "global:  $display_global")"

    choice="$(printf '%s\n' "$choices" \
      | fzf --prompt='save tmuxp > ' --height=40% --reverse)"

    case "$choice" in
      project:*) target="$default_project" ;;
      global:*) target="$default_global" ;;
      *) exit 0 ;;
    esac
  fi
fi

[ -n "$target" ] || exit 0
mkdir -p "$(dirname "$target")"

tmuxp freeze --force -y -q "$session_name" -o "$target"
tmux set-option -t "$session_name:" -q @tmuxp_config_path "$target"
tmux display-message "Saved tmuxp workspace to $target"
