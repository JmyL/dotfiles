#!/usr/bin/env bash
set -euo pipefail

source "$HOME/.tmux/scripts/tmuxp-common"

mkdir -p "$HOME/.tmuxp"

file="$({
  find "$HOME/.config/tmuxp" "$HOME/.tmuxp" -maxdepth 1 -type f \( -name '*.yaml' -o -name '*.yml' -o -name '*.json' \) 2>/dev/null || true
} | sort -u | fzf --prompt='tmuxp config > ' --height=80% --reverse)"

load_workspace "$file"
