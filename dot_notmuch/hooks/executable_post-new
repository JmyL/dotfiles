#!/bin/sh

# Keep folder-derived notmuch tags in sync with the current Maildir layout.
# Personal/state tags such as unread, flagged, and done are intentionally
# left untouched. Waiting is derived from sent messages without done.

notmuch tag +inbox -- 'folder:INBOX and not tag:inbox'
notmuch tag +sent -- 'folder:"Sent Messages" and not tag:sent'
notmuch tag +archive -- 'folder:Archive and not tag:archive'
notmuch tag +draft -- 'folder:Drafts and not tag:draft'
notmuch tag +trash -- 'folder:"Deleted Messages" and not tag:trash'
notmuch tag +spam -- 'folder:Junk and not tag:spam'

notmuch tag -inbox -- 'tag:inbox and not folder:INBOX'
notmuch tag -sent -- 'tag:sent and not folder:"Sent Messages"'
notmuch tag -archive -- 'tag:archive and not folder:Archive'
notmuch tag -draft -- 'tag:draft and not folder:Drafts'
notmuch tag -trash -- 'tag:trash and not folder:"Deleted Messages"'
notmuch tag -spam -- 'tag:spam and not folder:Junk'

notmuch tag +waiting -- 'tag:sent and not tag:done and not tag:waiting'
notmuch tag -waiting -- 'tag:waiting and (tag:done or not tag:sent)'

state_file="${XDG_RUNTIME_DIR:-/tmp}/notmuch-hooks/pre-new-unread-inbox-count"
old_count="$(cat "$state_file" 2>/dev/null || printf '0')"
new_count="$(notmuch count -- 'tag:unread and tag:inbox' 2>/dev/null || printf '0')"
new_delta=$((new_count - old_count))

if [ "$new_delta" -gt 0 ]; then
    notify-send -i mail-message-new-symbolic \
        "New mail" \
        "$new_delta new unread inbox message(s)"
fi
