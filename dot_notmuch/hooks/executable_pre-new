#!/bin/sh

# Snapshot unread inbox count before notmuch imports new messages.
# post-new compares against this to send desktop notifications.

state_dir="${XDG_RUNTIME_DIR:-/tmp}/notmuch-hooks"
state_file="$state_dir/pre-new-unread-inbox-count"

mkdir -p "$state_dir"
notmuch count -- 'tag:unread and tag:inbox' > "$state_file" 2>/dev/null || printf '0\n' > "$state_file"
