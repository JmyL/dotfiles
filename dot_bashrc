eval "$(starship init bash)"
eval "$(zoxide init bash)"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Atuin bash recording requires bash-preexec (zsh-like precmd/preexec hooks).
[[ -f "$HOME/.bash-preexec.sh" ]] && . "$HOME/.bash-preexec.sh"
[[ -f "$HOME/.atuin/bin/env" ]] && . "$HOME/.atuin/bin/env"
if command -v atuin >/dev/null 2>&1; then
  eval "$(atuin init bash)"
fi

# Keep the interactive prompt at the bottom of the terminal viewport.
__prompt_to_bottom() {
  [[ $- == *i* && -n ${LINES:-} ]] || return 0
  printf '\033[%s;1H' "$LINES"
}

if [[ $- == *i* ]]; then
  clear() {
    command clear "$@"
    __prompt_to_bottom
  }
  # Ctrl-L bypasses the clear function unless rebound.
  bind -x '"\C-l": clear'
  # Re-anchor after Atuin/other TUIs that leave the cursor mid-pane.
  if [[ "$(declare -p PROMPT_COMMAND 2>&1)" == "declare -a"* ]]; then
    PROMPT_COMMAND+=(__prompt_to_bottom)
  else
    PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND;}__prompt_to_bottom"
  fi
  __prompt_to_bottom
fi
