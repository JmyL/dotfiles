# .bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then
  . /etc/bashrc
fi

# User specific environment
if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]; then
  PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi
PATH="$HOME/.npm-global/bin:$PATH"
PATH="$HOME/go/bin:$PATH"
export PATH

# Uncomment the following line if you don't like systemctl's auto-paging feature:
# export SYSTEMD_PAGER=

# User specific aliases and functions
if [ -d ~/.bashrc.d ]; then
  for rc in ~/.bashrc.d/*; do
    if [ -f "$rc" ]; then
      . "$rc"
    fi
  done
fi
unset rc

export VISUAL=nvim
export EDITOR=nvim

# Fcitx input method
export XMODIFIERS=@im=fcitx
export GTK_IM_MODULE=fcitx
export QT_IM_MODULE=fcitx
export SDL_IM_MODULE=fcitx
export INPUT_METHOD=fcitx

alias v=nvim
dv() { toolbox enter "${SYSTEM_DEV_TOOLBOX:?SYSTEM_DEV_TOOLBOX is not set}"; }
alias dnf-backup='dnf repoquery --userinstalled --qf "%{name}\n" > packages.txt'
alias tmo='sesh connect "$(sesh list | fzf)"'
alias tm='tmuxinator'
alias tmp='tmuxinator $(tmuxinator list -n | tail -n +2 | fzf)'

. "$HOME/.cargo/env"

