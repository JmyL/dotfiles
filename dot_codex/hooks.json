{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "ai-session-start codex",
            "type": "command",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "ai-mark-busy codex",
            "type": "command",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "ai-stop-notify codex",
            "type": "command",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "ai-mark-blocked codex",
            "type": "command",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
